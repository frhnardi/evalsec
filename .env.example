# evalsec: Environment Configuration
# Copy this file to .env and fill in your API keys.
# .env is gitignored: never commit secrets.

# === LLM API Keys ===

# OpenRouter: used for Claude Sonnet 4.6, Kimi K2.6, Qwen 3.5
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek: used for DeepSeek V4 Pro
# Get key at: https://platform.deepseek.ai/api_keys
DEEPSEEK_API_KEY=

# Anthropic: used for judge model (Claude Opus 4.7)
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# === AWS Configuration ===

# Default region for S3 bucket (ap-southeast-3 = Jakarta)
AWS_REGION=ap-southeast-3
