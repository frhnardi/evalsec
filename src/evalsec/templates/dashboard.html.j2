  <div class="container">
    <div class="footer-row">
      <span class="footer-cell">Last updated: <span class="footer-value">{{ graded_at }}</span></span>
      <span class="footer-cell">Source: <a href="https://github.com/frhnardi/evalsec">github.com/frhnardi/evalsec</a></span>
      <span class="footer-cell"><a href="https://github.com/frhnardi/evalsec/blob/main/docs/methodology.md">Methodology</a></span>
      <span class="footer-cell"><a href="https://github.com/frhnardi/evalsec/blob/main/CONTRIBUTING.md">Contribute</a></span>
      <span class="footer-cell">License: <span class="footer-value">MIT</span></span>
    </div>
    <div class="footer-mark">evalsec<span class="accent-dot">.</span> built by Farhan Ardi · for the DevSecOps community.</div>
  </div>
</footer>

<script>
try {
(function() {
  // Dashboard is forced-dark (see :root color-scheme); no media-query branching.

  // Honor system reduce-motion across reveals, count-ups, and bar animations.
  const reduceMotion =
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Smoothly count a numeric element from 0 → target with easeOutQuart.
  function formatNum(v, decimals) {
    if (decimals === 0) return Math.round(v).toLocaleString();
    return v.toFixed(decimals);
  }
  function countUp(el, target, duration, decimals) {
    if (!el || target == null) return;
    if (reduceMotion) { el.textContent = formatNum(target, decimals); return; }
    const start = performance.now();
    const ease = (t) => 1 - Math.pow(1 - t, 4);
    function frame(now) {
      const t = Math.min(1, (now - start) / duration);
      el.textContent = formatNum(target * ease(t), decimals);
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  // ── Display name + dimension label maps ──
  const MODEL_DISPLAY = {
    "claude_sonnet_46":      "Claude Sonnet 4.6",
    "kimi_k2_thinking":      "Kimi K2.6 Thinking",
    "qwen_3_5":              "Qwen 3.5",
    "deepseek_v4_pro":       "DeepSeek V4 Pro",
    "claude_opus_47":        "Claude Opus 4.7 (Judge)",
    "baseline_cvss":         "Baseline: CVSS Sort",
    "baseline_trivy":        "Baseline: Trivy Severity",
    "baseline_epss":         "Baseline: EPSS Score",
    "baseline_reachability": "Baseline: Reachability",
  };
  const displayName = id => MODEL_DISPLAY[id] || id;

  const DIM_LABELS = {
    reachability_reasoning: "Reachability",
    prioritization:         "Prioritization",
    actionability:          "Actionability",
    conciseness:            "Conciseness",
    format:                 "Format",
    coverage:               "Coverage",
    verdict:                "Verdict Accuracy",
    priority:               "Priority Order",
  };
  const dimLabel = d => DIM_LABELS[d] || d.replace(/_/g, " ");

  const DIM_TOOLTIPS = {
    reachability_reasoning: "Does the model use stack context to determine real exploitability vs just relying on CVSS scores?",
    prioritization:         "Does the model rank findings by correct urgency (critical first, deferrable last)?",
    actionability:          "Are recommendations specific and executable, with concrete commands or patch versions?",
    conciseness:            "Is the response focused without preamble or padding, under target length?",
    format:                 "Is output valid JSON matching the expected schema?",
    coverage:               "Did the model address all CVEs in the input scan?",
    verdict:                "How accurate were verdicts (exploitable/not exploitable/partial) vs ground truth?",
    priority:               "How accurate was the priority ordering vs ground truth?",
    hall_penalty:           "Penalty for fabricated CVEs not in original scan (lower is better)",
  };
  const DIM_TOOLTIPS_BY_TEXT = {};
  Object.entries(DIM_TOOLTIPS).forEach(([k, v]) => {
    DIM_TOOLTIPS_BY_TEXT[k.replace(/_/g, " ")] = v;
  });
  DIM_TOOLTIPS_BY_TEXT["hall. penalty"] = DIM_TOOLTIPS.hall_penalty;
  DIM_TOOLTIPS_BY_TEXT["regex"]         = "Regex / pattern match score on deterministic Pass 1.";
  DIM_TOOLTIPS_BY_TEXT["cost"]          = "Total API cost for this model across all evaluated cases.";

  // ── Chart.js theme ──
  const FONT_SANS = '"Geist", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
  const FONT_MONO = '"Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace';

  let chartLoaded = false;
  try {
    Chart.defaults.color       = '#B0A498';
    Chart.defaults.borderColor = 'rgba(245, 239, 230, 0.06)';
    Chart.defaults.font.family = FONT_SANS;
    Chart.defaults.font.size   = 12;
    chartLoaded = true;
  } catch (_) {
    console.warn('Chart.js failed to load — chart canvas elements will show fallback message.');
    ['barChart', 'radarChart', 'baselineBarChart'].forEach(id => {
      const fb = document.getElementById(id + 'Fallback');
      if (fb) fb.classList.add('visible');
    });
  }

  // ── Palette — Deep Plum + Copper (warm premium) ──
  const PLUM      = '#8B4A6B';
  const PLUM_HI   = '#A8627F';
  const PLUM_LO   = '#6B3852';
  const COPPER    = '#C77D4A';
  const COPPER_HI = '#E09968';
  const COPPER_LO = '#9D5E33';
  const CHAMPAGNE = '#D4AF7A';
  const INFO      = '#6B8FA8';   // warm steel blue
  const SAGE      = '#7FB069';   // sage green (was MINT)
  const TERRA     = '#D45D5D';   // terracotta red (was CORAL)
  const NEUTRAL   = '#524A44';

  // Cycled palette for multi-series charts (radar). Order chosen so adjacent
  // series have maximum hue separation, distinguishable even at low alpha.
  const SERIES_PALETTE = [PLUM, COPPER, INFO, PLUM_HI, SAGE, CHAMPAGNE];
  function paletteFor(n) {
    return Array.from({ length: n }, (_, i) => SERIES_PALETTE[i % SERIES_PALETTE.length]);
  }

  // Build a left→right linear gradient on a bar's chartArea.
  // Supports optional 3-stop fade: from → mid (60%) → fadeEnd (transparent at 100%).
  function makeBarGradient(c, area, from, mid, fadeEnd) {
    if (!area) return from;
    const g = c.createLinearGradient(area.left, 0, area.right, 0);
    if (fadeEnd) {
      g.addColorStop(0, from);
      g.addColorStop(0.6, mid || from);
      g.addColorStop(1, fadeEnd);
    } else {
      g.addColorStop(0, from);
      g.addColorStop(1, mid || from);
    }
    return g;
  }

  // Plugin factory: wraps dataset draw with a canvas shadow so bars glow.
  function glowPlugin(id, color, blur) {
    return {
      id: id,
      beforeDatasetDraw(chart) {
        chart.ctx.save();
        chart.ctx.shadowColor = color;
        chart.ctx.shadowBlur  = blur;
      },
      afterDatasetDraw(chart) {
        chart.ctx.restore();
      },
    };
  }
  // Glow plugins kept defined for backward-compat but with greatly reduced
  // blur radius + opacity. Bars rely on gradient fill for signal, not glow.
  const plumGlow   = glowPlugin('plumGlow',   'rgba(139, 74, 107, 0.18)', 6);
  const copperGlow = glowPlugin('copperGlow', 'rgba(199, 125, 74, 0.15)', 5);

  // Copper edge highlight — draws a 1px vertical line at the right edge of
  // each horizontal bar, creating an "engraved tip" effect (redesign.md §3).
  function copperEdgePlugin() {
    return {
      id: 'copperEdge',
      afterDatasetDraw(chart) {
        const ctx = chart.ctx;
        const meta = chart.getDatasetMeta(0);
        if (!meta || !meta.data) return;
        ctx.save();
        ctx.strokeStyle = 'rgba(212, 175, 122, 0.40)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        meta.data.forEach(bar => {
          const x = bar.x + bar.width;
          ctx.moveTo(x, bar.y);
          ctx.lineTo(x, bar.y + bar.height);
        });
        ctx.stroke();
        ctx.restore();
      }
    };
  }

  // Convert hex → rgba string with given alpha (for radar fills).
  function hexToRgba(hex, alpha) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  // ── Data from server ──
  const leaderboard     = {{ leaderboard | tojson }};
  const dimNames        = {{ dim_names | tojson }};
  const llmEntries      = leaderboard.filter(e => e.model_type === "llm");
  const baselineEntries = leaderboard.filter(e => e.model_type === "baseline");

  // ── Display-name replacement throughout the DOM ──
  document.querySelectorAll('.model-display-name').forEach(el => {
    const id = el.dataset.id;
    if (id) el.textContent = displayName(id);
  });

  // ── Model card enhancement (preserve card.html.j2 untouched) ──
  document.querySelectorAll('.model-card').forEach(card => {
    const rank = parseInt(card.dataset.rank, 10);
    const entry = leaderboard.find(e => e.rank === rank);
    if (!entry) return;

    const nameEl = card.querySelector('.model-name');
    if (nameEl) nameEl.textContent = displayName(entry.model_id);

    const truncated = (entry.details || []).some(d =>
      d && d.score && d.score.validation && d.score.validation.parse_error
    );
    if (truncated && nameEl) {
      const badge = document.createElement('span');
      badge.className = 'trunc-badge';
      badge.textContent = 'Truncated';
      badge.title = 'Response exceeded max_tokens — JSON truncated.';
      nameEl.appendChild(badge);

      const note = document.createElement('div');
      note.className = 'trunc-note';
      note.textContent = 'Response exceeded max_tokens — JSON truncated. Score reflects partial output only.';
      const scoreEl = card.querySelector('.card-score');
      if (scoreEl) scoreEl.appendChild(note);
    }

    card.querySelectorAll('.card-dims tbody tr').forEach(tr => {
      const firstCell = tr.querySelector('td, th');
      if (!firstCell) return;
      const text = firstCell.textContent.trim().toLowerCase();
      const tip = DIM_TOOLTIPS_BY_TEXT[text];
      if (tip) {
        tr.title = tip;
        tr.classList.add('has-tooltip');
      }
    });
  });

  // ── Hero stats ──
  const allCases = new Set();
  leaderboard.forEach(e => (e.details || []).forEach(d => {
    if (d && d.case_id) allCases.add(d.case_id);
  }));
  const caseCount = allCases.size || (leaderboard[0]?.details?.length || 0);

  countUp(document.getElementById('stat-models'), llmEntries.length, 900, 0);
  countUp(document.getElementById('stat-cases'),  caseCount,          900, 0);

  const disclaimerCases = document.getElementById('disclaimer-cases');
  if (disclaimerCases) disclaimerCases.textContent = caseCount || 1;

  const topEl    = document.getElementById('stat-top-score');
  const topSubEl = document.getElementById('stat-top-score-sub');
  if (llmEntries.length > 0) {
    const topEntry = llmEntries.reduce((acc, e) => e.avg_score > acc.avg_score ? e : acc);
    countUp(topEl, topEntry.avg_score, 1100, 1);
    if (topSubEl) topSubEl.textContent = displayName(topEntry.model_id);
  } else {
    topEl.textContent = '—';
    if (topSubEl) topSubEl.textContent = 'No LLM data';
  }

  const llmWithCost   = llmEntries.filter(e => (e.total_cost || 0) > 0);
  const bestValueEl   = document.getElementById('stat-best-value');
  const bestValueSub  = document.getElementById('stat-best-value-sub');
  if (llmWithCost.length === 0) {
    bestValueEl.textContent = 'N/A';
    bestValueEl.classList.remove('small');
    if (bestValueSub) bestValueSub.textContent = 'Pending — costs $0 in current run';
  } else {
    const best = llmWithCost.reduce((acc, e) =>
      (e.avg_score / e.total_cost) > (acc.avg_score / acc.total_cost) ? e : acc
    );
    const ratio = best.avg_score / best.total_cost;
    bestValueEl.classList.remove('small');
    countUp(bestValueEl, ratio, 1100, ratio >= 100 ? 0 : 1);
    if (bestValueSub) bestValueSub.textContent = displayName(best.model_id);
  }

  // ── Disclaimer dismissal ──
  const disclaimer = document.getElementById('prelimDisclaimer');
  const dismissBtn = document.getElementById('dismissDisclaimer');
  if (disclaimer && sessionStorage.getItem('evalsecDismissDisclaimer') === '1') {
    disclaimer.classList.add('is-dismissed');
  }
  if (dismissBtn) {
    dismissBtn.addEventListener('click', () => {
      if (disclaimer) disclaimer.classList.add('is-dismissed');
      try { sessionStorage.setItem('evalsecDismissDisclaimer', '1'); } catch (_) {}
    });
  }

  // ── Methodology tab switching ──
  const tabs   = document.querySelectorAll('.method-tab');
  const panels = document.querySelectorAll('.method-panel');
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabs.forEach(t => {
        const sel = t === btn;
        t.classList.toggle('selected', sel);
        t.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
      panels.forEach(p => p.classList.toggle('active', p.dataset.panel === target));
    });
  });

  // ── Bar Chart (LLM composite scores) ──
  if (chartLoaded && llmEntries.length > 0) {
    new Chart(document.getElementById('barChart'), {
      type: 'bar',
      data: {
        labels: llmEntries.map(e => displayName(e.model_id)),
        datasets: [{
          label: 'Composite Score',
          data: llmEntries.map(e => e.avg_score),
          // Plum gradient with fade-to-transparent at the right edge, plus
          // copper engraved-tip border rendered via copperEdge plugin.
          backgroundColor: (ctx) => {
            const { chart } = ctx;
            return makeBarGradient(chart.ctx, chart.chartArea, PLUM_LO, PLUM_HI, 'rgba(168, 98, 127, 0)');
          },
          hoverBackgroundColor: (ctx) => {
            const { chart } = ctx;
            return makeBarGradient(chart.ctx, chart.chartArea, PLUM, PLUM_HI, 'rgba(168, 98, 127, 0)');
          },
          borderRadius: 6,
          borderSkipped: false,
          maxBarThickness: 44,
          categoryPercentage: 0.85,
          barPercentage: 0.92,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        indexAxis: 'y',
        animation: { duration: 1200, easing: 'easeOutQuart' },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(20, 16, 15, 0.92)',
            borderColor: 'rgba(139, 74, 107, 0.30)',
            borderWidth: 1,
            titleColor: '#F5EFE6',
            bodyColor: '#EAE2D7',
            padding: 10,
            cornerRadius: 8,
            titleFont: { family: FONT_SANS, weight: '500' },
            bodyFont:  { family: FONT_MONO, size: 12 },
          },
        },
        scales: {
          x: {
            min: 0, max: 100,
            grid: {
              color: 'rgba(245, 239, 230, 0.04)',
              borderDash: [4, 4],
              drawTicks: false,
            },
            ticks: { color: '#6E6359', font: { family: FONT_MONO, size: 10 } },
            border: { display: false },
          },
          y: {
            grid: { display: false },
            ticks: {
              color: '#EAE2D7',
              font: { family: FONT_SANS, weight: '500', size: 12 },
            },
            border: { display: false },
          }
        }
      },
      plugins: [plumGlow, copperEdgePlugin()],
    });
  }

  // Map known model IDs to specific plum/copper colors (redesign.md §4)
  // instead of cycling through a generic palette.
  function modelColor(modelId, index) {
    const map = {
      "deepseek_v4_pro":  PLUM,
      "claude_sonnet_46": COPPER,
      "kimi_k2_thinking": PLUM_HI,
      "qwen_3_5":         COPPER_LO,
    };
    return map[modelId] || (index % 2 === 0 ? PLUM : COPPER);
  }

  // ── Radar Chart (LLM only, readable dim labels) ──
  if (chartLoaded && llmEntries.length > 0) {
    const radarDatasets = llmEntries.map((entry, i) => {
      const stroke = modelColor(entry.model_id, i);
      return {
        label: displayName(entry.model_id),
        data: dimNames.map(d => (entry.dimension_scores[d] || 0)),
        borderColor: stroke,
        backgroundColor: hexToRgba(stroke, 0.15),
        borderWidth: 2,
        pointRadius: 3,
        pointBackgroundColor: stroke,
        pointBorderColor: stroke,
        pointHoverRadius: 5,
        pointHoverBackgroundColor: stroke,
        pointHoverBorderColor: '#F5EFE6',
        pointHoverBorderWidth: 2,
      };
    });

    new Chart(document.getElementById('radarChart'), {
      type: 'radar',
      data: {
        labels: dimNames.map(d => dimLabel(d).toUpperCase()),
        datasets: radarDatasets,
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        animation: { duration: 900, easing: 'easeOutQuart' },
        scales: {
          r: {
            min: 0, max: 100,
            ticks: {
              stepSize: 25,
              backdropColor: 'transparent',
              color: '#524A44',
              font: { family: FONT_MONO, size: 9 },
            },
            // Dotted grid rings per redesign.md §4 — subtle, industrial feel
            grid: {
              color: 'rgba(245, 239, 230, 0.06)',
              circular: true,
              lineWidth: 1,
              borderDash: [2, 4],
            },
            angleLines: {
              color: 'rgba(245, 239, 230, 0.06)',
              lineWidth: 1,
              borderDash: [2, 4],
            },
            pointLabels: {
              color: '#B0A498',
              font: { family: FONT_MONO, size: 10, weight: '500' },
            },
          }
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              boxWidth: 10,
              boxHeight: 10,
              padding: 14,
              color: '#EAE2D7',
              font: { family: FONT_SANS, size: 11, weight: '500' },
              usePointStyle: true,
              pointStyle: 'circle',
            },
          },
          tooltip: {
            backgroundColor: 'rgba(20, 16, 15, 0.92)',
            borderColor: 'rgba(139, 74, 107, 0.30)',
            borderWidth: 1,
            titleColor: '#F5EFE6',
            bodyColor: '#EAE2D7',
            padding: 10,
            cornerRadius: 8,
            titleFont: { family: FONT_SANS, weight: '500' },
            bodyFont:  { family: FONT_MONO, size: 12 },
          },
        }
      }
    });
  }

  // ── Baseline Bar Chart (copper, "no AI" tier) ──
  const baselineCanvas = document.getElementById('baselineBarChart');
  if (chartLoaded && baselineCanvas && baselineEntries.length > 0) {
    new Chart(baselineCanvas, {
      type: 'bar',
      data: {
        labels: baselineEntries.map(e => displayName(e.model_id)),
        datasets: [{
          label: 'Deterministic Score',
          data: baselineEntries.map(e => e.avg_score),
          backgroundColor: (ctx) => {
            const { chart } = ctx;
            return makeBarGradient(chart.ctx, chart.chartArea, COPPER_LO, COPPER);
          },
          hoverBackgroundColor: (ctx) => {
            const { chart } = ctx;
            return makeBarGradient(chart.ctx, chart.chartArea, COPPER, COPPER_HI);
          },
          borderRadius: 6,
          borderSkipped: false,
          maxBarThickness: 36,
          categoryPercentage: 0.85,
          barPercentage: 0.92,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        indexAxis: 'y',
        animation: { duration: 1100, easing: 'easeOutQuart' },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(20, 16, 15, 0.92)',
            borderColor: 'rgba(199, 125, 74, 0.30)',
            borderWidth: 1,
            titleColor: '#F5EFE6',
            bodyColor: '#EAE2D7',
            padding: 10,
            cornerRadius: 8,
            titleFont: { family: FONT_SANS, weight: '500' },
            bodyFont:  { family: FONT_MONO, size: 12 },
          },
        },
        scales: {
          x: {
            min: 0, max: 100,
            grid: {
              color: 'rgba(245, 239, 230, 0.04)',
              borderDash: [4, 4],
              drawTicks: false,
            },
            ticks: { color: '#6E6359', font: { family: FONT_MONO, size: 10 } },
            border: { display: false },
          },
          y: {
            grid: { display: false },
            ticks: {
              color: '#EAE2D7',
              font: { family: FONT_SANS, weight: '500', size: 12 },
            },
            border: { display: false },
          }
        }
      },
      plugins: [copperGlow],
    });
  }

  // ── Scroll reveal + bar fill animation (IntersectionObserver) ──
  // Stagger groups: tag children with .reveal + an 80ms incremental delay so
  // they cascade rather than enter together.
  document.querySelectorAll('.reveal-stagger').forEach((parent) => {
    Array.from(parent.children).forEach((child, i) => {
      child.classList.add('reveal');
      child.style.setProperty('--reveal-delay', `${i * 80}ms`);
    });
  });

  // Snapshot then zero each card bar so we can animate width 0 → target when
  // the parent card enters the viewport. Inline width was set server-side
  // by Jinja for SSR; we just stage it for transition.
  document.querySelectorAll('.bar-fill').forEach((bar) => {
    const w = bar.style.width;
    if (w && !reduceMotion) {
      bar.dataset.targetWidth = w;
      bar.style.width = '0%';
    }
  });

  if ('IntersectionObserver' in window && !reduceMotion) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target;
        el.classList.add('is-revealed');
        if (el.classList.contains('bar-fill') && el.dataset.targetWidth) {
          const t = el.dataset.targetWidth;
          requestAnimationFrame(() => { el.style.width = t; });
        }
        io.unobserve(el);
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal, .bar-fill').forEach((el) => io.observe(el));
  } else {
    // Fallback / reduced-motion: reveal everything immediately, no animation.
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-revealed'));
    document.querySelectorAll('.bar-fill').forEach((bar) => {
      if (bar.dataset.targetWidth) bar.style.width = bar.dataset.targetWidth;
    });
  }
})();
} catch(e) {
  console.error('evalsec dashboard init error:', e);
}
</script>

</body>
</html>
