<!DOCTYPE html>
<html lang="en" data-color-scheme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">

  <meta property="og:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta property="og:description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://evalsec.farhan.ngenz.org">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta name="twitter:description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">

  <title>evalsec — DevSecOps LLM Benchmark</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="./chart.umd.min.js"></script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ─────────────────────────────────────────────
       DESIGN TOKENS — Deep Plum + Copper on warm black
       ───────────────────────────────────────────── */
    :root {
      color-scheme: dark;

      /* Background layers — warm-shifted */
      --bg-base:        #0A0708;
      --bg-elevated:    #14100F;
      --bg-overlay:     #1C1614;
      --bg-glass:       rgba(28, 22, 20, 0.55);

      /* Primary accent — Deep Plum (muted wine, NOT neon) */
      --accent-primary:    #8B4A6B;
      --accent-primary-hi: #A8627F;
      --accent-primary-lo: #6B3852;
      --accent-glow:       rgba(139, 74, 107, 0.12);

      /* Secondary accent — Copper / Bronze (baselines / "no AI" metrics) */
      --accent-secondary:      #C77D4A;
      --accent-secondary-hi:   #E09968;
      --accent-secondary-lo:   #9D5E33;
      --accent-secondary-soft: rgba(199, 125, 74, 0.10);
      --accent-secondary-line: rgba(199, 125, 74, 0.25);
      --accent-secondary-glow: rgba(199, 125, 74, 0.12);

      /* Champagne — premium highlights for metric numbers */
      --accent-tertiary:   #D4AF7A;

      /* Semantic — warm-toned */
      --success: #7FB069;
      --warning: #E8A04E;
      --danger:  #D45D5D;
      --info:    #6B8FA8;

      /* Warm Slate neutrals — mid-tone palette per redesign.md */
      --neutral-600:    #524A44;

      /* Text hierarchy — warm off-white */
      --text-primary:   #F5EFE6;
      --text-secondary: #B0A498;
      --text-tertiary:  #6E6359;
      --text-disabled:  #524A44;

      /* Borders — warm tinted */
      --border-subtle:  rgba(245, 239, 230, 0.05);
      --border-default: rgba(245, 239, 230, 0.08);
      --border-stronger: rgba(245, 239, 230, 0.14);
      --border-accent:  rgba(199, 125, 74, 0.25);

      /* Spacing — 8px grid */
      --space-1:  4px;
      --space-2:  8px;
      --space-3:  12px;
      --space-4:  16px;
      --space-6:  24px;
      --space-8:  32px;
      --space-12: 48px;
      --space-16: 64px;
      --space-24: 96px;

      /* Tracking */
      --tracking-tight: -0.04em;
      --tracking-body:  -0.01em;
      --tracking-wide:   0.12em;

      /* Premium easing */
      --ease-premium: cubic-bezier(0.16, 1, 0.3, 1);

      /* ────────────────────────────────────────────
         Backward-compat aliases (mapped to new tokens
         so existing CSS selectors keep working without
         renaming every reference in this commit).
         ──────────────────────────────────────────── */
      --bg:           var(--bg-base);
      --surface:      var(--bg-elevated);
      --surface-2:    var(--bg-overlay);
      --text:         var(--text-primary);
      --text-soft:    #EAE2D7;
      --muted:        var(--text-secondary);
      --muted-2:      var(--text-tertiary);
      --accent:       var(--accent-primary);
      --accent-2:     var(--accent-primary-hi);
      --accent-deep:  var(--accent-primary-lo);
      --accent-soft:  rgba(139, 74, 107, 0.08);
      --accent-line:  var(--border-accent);
      --warn:         var(--warning);
      --warn-soft:    rgba(232, 160, 78, 0.08);
      --border:       var(--border-default);
      --border-soft:  var(--border-subtle);
      --border-strong: var(--border-stronger);

      /* Radii */
      --radius-sm:    8px;
      --radius:       12px;
      --radius-lg:    16px;
      --radius-xl:    24px;
      --radius-2xl:   28px;

      /* Shadows — softened, no stacking glow */
      --shadow-1:     0 1px 2px rgba(0,0,0,0.4);
      --shadow-2:     0 12px 32px -12px rgba(0,0,0,0.6);
      --shadow-glow:  0 0 0 1px rgba(199,125,74,0.08),
                      0 12px 28px -16px rgba(139,74,107,0.30),
                      inset 0 1px 0 rgba(245,239,230,0.04);

      /* Typography */
      --font-sans: "Geist", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

      /* Legacy grain (kept for card-internal usage) */
      --grain: radial-gradient(1px 1px at 25% 35%, rgba(255,255,255,0.04) 50%, transparent 50%),
               radial-gradient(1px 1px at 75% 65%, rgba(255,255,255,0.04) 50%, transparent 50%);
    }

    html {
      color-scheme: dark;
      background: var(--bg-base);
    }

    html, body {
      color: var(--text-primary);
      font-family: var(--font-sans);
      font-feature-settings: "ss01", "cv11";
      line-height: 1.55;
      letter-spacing: var(--tracking-body);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      min-height: 100%;
    }

    body {
      position: relative;
      background:
        radial-gradient(ellipse 70% 50% at 50% -10%, rgba(139, 74, 107, 0.08), transparent 60%),
        radial-gradient(ellipse 50% 30% at 85% 30%, rgba(199, 125, 74, 0.04), transparent 70%),
        radial-gradient(ellipse 70% 45% at 15% 75%, rgba(139, 74, 107, 0.05), transparent 70%),
        var(--bg-base);
      background-attachment: fixed;
      isolation: isolate;
    }

    /* Subtle SVG noise overlay — kills the "flat digital" feel */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.018;
      mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      z-index: 0;
    }

    /* Lift actual content above the noise overlay */
    body > * { position: relative; z-index: 1; }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    a {
      color: var(--accent-primary-hi);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    a:hover { color: var(--accent-primary); }

    /* Selection highlight */
    ::selection {
      background: rgba(139, 74, 107, 0.30);
      color: var(--text-primary);
    }
    ::-moz-selection {
      background: rgba(139, 74, 107, 0.30);
      color: var(--text-primary);
    }

    /* Custom scrollbar — thin, transparent track, plum thumb */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: rgba(139, 74, 107, 0.25);
      border-radius: 999px;
      border: 2px solid transparent;
      background-clip: padding-box;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(139, 74, 107, 0.45); background-clip: padding-box; }
    html { scrollbar-color: rgba(139, 74, 107, 0.30) transparent; scrollbar-width: thin; }

    /* Focus ring — plum, visible only for keyboard focus */
    :focus { outline: none; }
    :focus-visible {
      outline: 2px solid rgba(139, 74, 107, 0.55);
      outline-offset: 2px;
      border-radius: 4px;
    }

    /* Respect reduced motion preference */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* ─────────────────────────────────────────────
       HERO
       ───────────────────────────────────────────── */
    .hero {
      position: relative;
      padding: 6rem 0 4rem;
      text-align: center;
      overflow: hidden;
    }

    /* Ambient horizon halo — wide, soft, top of hero */
    .hero::before {
      content: "";
      position: absolute;
      top: -20%;
      left: 50%;
      transform: translateX(-50%);
      width: 1200px;
      height: 600px;
      background: radial-gradient(closest-side, rgba(139, 74, 107, 0.18), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .hero-inner { position: relative; z-index: 1; }

    /* Tight bokeh orb behind the logo */
    .hero-orb {
      position: absolute;
      top: 48%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 480px;
      height: 480px;
      background: radial-gradient(closest-side,
        rgba(139, 74, 107, 0.40) 0%,
        rgba(139, 74, 107, 0.18) 35%,
        transparent 70%);
      filter: blur(40px);
      z-index: -1;
      pointer-events: none;
      border-radius: 50%;
    }

    .beta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.42rem 0.95rem;
      background: linear-gradient(135deg,
        rgba(139, 74, 107, 0.16) 0%,
        rgba(139, 74, 107, 0.06) 100%);
      color: var(--accent-primary-hi);
      border: 1px solid var(--border-accent);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      margin-bottom: 1.75rem;
      box-shadow:
        0 0 24px -6px var(--accent-glow),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .pulse-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--accent-primary-hi);
      box-shadow: 0 0 0 0 var(--accent-primary);
      animation: pulse 2.4s var(--ease-premium) infinite;
    }
    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(139, 74, 107, 0.55); }
      70%  { box-shadow: 0 0 0 9px rgba(139, 74, 107, 0); }
      100% { box-shadow: 0 0 0 0 rgba(139, 74, 107, 0); }
    }

    .hero-title {
      position: relative;
      font-size: clamp(3rem, 8vw, 6rem);
      font-weight: 600;
      letter-spacing: -0.055em;
      line-height: 0.95;
      margin-bottom: 1.1rem;
      background: linear-gradient(135deg, #F5EFE6 0%, #D4AF7A 55%, #A8627F 100%);
      -webkit-background-clip: text;
              background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .hero-title .accent-dot {
      /* keep the period solid plum so it pops against the gradient */
      -webkit-text-fill-color: var(--accent-primary);
      color: var(--accent-primary);
      background: none;
    }

    .hero-subtitle {
      font-size: clamp(1.05rem, 2vw, 1.3rem);
      color: var(--text-soft);
      font-weight: 500;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }
    .hero-desc {
      font-size: 1.02rem;
      color: var(--text-secondary);
      max-width: 44rem;
      margin: 0 auto;
      letter-spacing: -0.005em;
    }

    .meta-pills {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 2.25rem;
    }
    .meta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.42rem 0.9rem;
      border: 1px solid var(--border-subtle);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-secondary);
      background: rgba(28, 22, 20, 0.55);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: border-color 0.2s var(--ease-premium), color 0.2s var(--ease-premium);
    }
    .meta-pill:hover {
      border-color: var(--border-default);
      color: var(--text-primary);
    }
    .meta-pill .meta-icon {
      color: var(--text-tertiary);
      flex-shrink: 0;
      transition: color 0.2s var(--ease-premium);
    }
    .meta-pill:hover .meta-icon { color: var(--accent-primary-hi); }

    /* ─────────────────────────────────────────────
       SECTION HEADINGS
       ───────────────────────────────────────────── */
    .section-title {
      font-size: clamp(1.75rem, 3.5vw, 2.5rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1.1;
      text-align: center;
      margin-bottom: 0.6rem;
    }
    .section-title .accent-dot { color: var(--accent); }
    .section-sub {
      text-align: center;
      color: var(--muted);
      font-size: 1rem;
      max-width: 36rem;
      margin: 0 auto 2rem;
      letter-spacing: -0.01em;
    }

    /* ─────────────────────────────────────────────
       HERO STATS (KPI cards)
       ───────────────────────────────────────────── */
    .stats-section { margin-bottom: 6rem; }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    @media (max-width: 820px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .stat {
      position: relative;
      background: linear-gradient(135deg,
        rgba(28, 22, 20, 0.80) 0%,
        rgba(20, 16, 15, 0.60) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.6rem 1.5rem 1.35rem;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition:
        border-color 0.35s var(--ease-premium),
        transform 0.35s var(--ease-premium),
        box-shadow 0.35s var(--ease-premium);
      overflow: hidden;
    }
    /* Featured gradient accent line at the top of each card */
    .stat::before {
      content: "";
      position: absolute;
      top: 0;
      left: 12%;
      right: 12%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent,
        rgba(139, 74, 107, 0.55),
        transparent);
      opacity: 0.5;
      transition: opacity 0.35s var(--ease-premium);
    }
    .stat:hover {
      border-color: var(--border-accent);
      transform: translateY(-2px) scale(1.015);
      box-shadow: var(--shadow-glow);
    }
    .stat:hover::before { opacity: 1; }

    .stat-icon {
      position: absolute;
      top: 1.1rem;
      right: 1.1rem;
      width: 18px;
      height: 18px;
      color: var(--neutral-600);
      pointer-events: none;
      transition:
        opacity 0.35s var(--ease-premium),
        color 0.35s var(--ease-premium);
    }
    .stat:hover .stat-icon {
      opacity: 0.7;
      color: var(--accent-primary-hi);
    }

    .stat-value {
      font-family: var(--font-mono);
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      background: linear-gradient(135deg, #F5EFE6 0%, #D4AF7A 100%);
      -webkit-background-clip: text;
              background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .stat-value.small {
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      letter-spacing: -0.03em;
    }
    .stat-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--text-tertiary);
      margin-top: 0.95rem;
      font-weight: 500;
    }
    .stat-sub {
      display: block;
      font-size: 0.78rem;
      color: var(--text-tertiary);
      margin-top: 0.3rem;
      letter-spacing: -0.005em;
    }

    /* ─────────────────────────────────────────────
       METHODOLOGY TABS
       ───────────────────────────────────────────── */
    .method-section { margin-bottom: 6rem; }

    .method-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    }

    .method-tab {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.7rem 1.15rem;
      background: rgba(28, 22, 20, 0.55);
      border: 1px solid var(--border-subtle);
      border-radius: 999px;
      font-family: inherit;
      font-size: 0.84rem;
      font-weight: 500;
      color: var(--text-secondary);
      cursor: pointer;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition:
        color 0.2s var(--ease-premium),
        border-color 0.2s var(--ease-premium),
        background 0.2s var(--ease-premium),
        box-shadow 0.2s var(--ease-premium);
    }
    .method-tab:hover {
      border-color: var(--border-default);
      color: var(--text-primary);
    }
    .method-tab .method-tab-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--text-tertiary);
      transition: color 0.2s var(--ease-premium);
    }
    .method-tab .method-tab-icon svg {
      width: 14px;
      height: 14px;
    }
    .method-tab:hover .method-tab-icon { color: var(--text-secondary); }
    .method-tab.selected {
      color: var(--text-primary);
      background: linear-gradient(135deg,
        rgba(139, 74, 107, 0.18) 0%,
        rgba(139, 74, 107, 0.05) 100%);
      border-color: var(--border-accent);
      box-shadow:
        0 0 22px -6px var(--accent-glow),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .method-tab.selected .method-tab-icon { color: var(--accent-primary-hi); }

    .method-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-2xl);
      padding: 0.55rem;
      background: var(--surface);
    }
    .method-inner {
      background: var(--surface-2);
      border-radius: calc(var(--radius-2xl) - 5px);
      padding: 2rem clamp(1.25rem, 4vw, 3rem);
      min-height: 220px;
    }

    .method-panel { display: none; }
    .method-panel.active { display: block; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .method-panel h3 {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
      color: var(--text);
    }
    .method-panel p {
      color: var(--text-soft);
      font-size: 0.95rem;
      max-width: 60ch;
      margin-bottom: 0.65rem;
    }
    .method-panel p:last-child { margin-bottom: 0; }
    .method-panel ul {
      list-style: none;
      padding: 0;
      color: var(--text-soft);
      font-size: 0.93rem;
    }
    .method-panel ul > li {
      padding-left: 1.15rem;
      position: relative;
      margin-bottom: 0.5rem;
    }
    .method-panel ul > li::before {
      content: "—";
      position: absolute; left: 0;
      color: var(--accent);
    }
    .method-panel ul ul {
      margin-top: 0.4rem;
      margin-left: 0.4rem;
      font-size: 0.88rem;
    }
    .method-panel ul ul > li::before { content: "·"; color: var(--muted-2); }
    .method-panel strong { color: var(--text); font-weight: 600; }

    /* ─────────────────────────────────────────────
       CHARTS
       ───────────────────────────────────────────── */
    .charts-section { margin-bottom: 4.5rem; }

    .charts-frame {
      position: relative;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-2xl);
      padding: 0.65rem;
      background: linear-gradient(135deg,
        rgba(28, 22, 20, 0.80) 0%,
        rgba(20, 16, 15, 0.60) 100%);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: var(--shadow-2);
      overflow: hidden;
    }
    .charts-frame::before {
      content: "";
      position: absolute;
      top: 0; left: 14%; right: 14%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent,
        rgba(139, 74, 107, 0.50),
        transparent);
    }
    .charts-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem;
      background: transparent;
      border-radius: calc(var(--radius-2xl) - 6px);
      padding: 0;
    }
    @media (max-width: 900px) {
      .charts-inner { grid-template-columns: 1fr; }
    }

    .chart-card {
      background: rgba(10, 7, 8, 0.45);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.45rem 1.5rem 1.2rem;
      transition: border-color 0.3s var(--ease-premium);
    }
    .chart-card:hover { border-color: rgba(255, 255, 255, 0.10); }
    .chart-card h3 {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: 0.35rem;
    }
    .chart-sub {
      font-size: 0.78rem;
      color: var(--text-tertiary);
      margin-bottom: 1.15rem;
      letter-spacing: -0.005em;
    }
    .chart-card canvas { max-height: 340px; }

    .baseline-chart-frame .charts-inner {
      grid-template-columns: 1fr;
    }
    .baseline-chart-frame canvas { max-height: 240px; }

    .chart-fallback {
      display: none;
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--text-tertiary);
      font-size: 0.85rem;
      border: 1px dashed var(--border-stronger);
      border-radius: var(--radius);
    }
    .chart-fallback.visible { display: block; }

    /* ─────────────────────────────────────────────
       DISCLAIMER
       ───────────────────────────────────────────── */
    .disclaimer {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: linear-gradient(135deg,
        rgba(232, 160, 78, 0.10) 0%,
        rgba(232, 160, 78, 0.03) 100%);
      border: 1px solid rgba(232, 160, 78, 0.30);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.35rem;
      margin-bottom: 1.5rem;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }
    .disclaimer.is-dismissed { display: none; }
    .disclaimer-icon {
      width: 30px; height: 30px;
      border-radius: 50%;
      background: rgba(232, 160, 78, 0.16);
      color: var(--warning);
      border: 1px solid rgba(232, 160, 78, 0.40);
      font-family: var(--font-mono);
      font-size: 0.92rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .disclaimer-body { flex: 1; color: var(--text-soft); font-size: 0.92rem; line-height: 1.5; }
    .disclaimer-body strong { color: var(--warning); font-weight: 600; }
    .disclaimer-close {
      background: transparent;
      border: none;
      color: var(--text-tertiary);
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      padding: 0 0.35rem;
      font-family: inherit;
      transition: color 0.2s var(--ease-premium);
    }
    .disclaimer-close:hover { color: var(--text-primary); }

    /* ─────────────────────────────────────────────
       LEADERBOARD
       ───────────────────────────────────────────── */
    .ranking-section { margin-bottom: 5rem; }

    .leaderboard {
      position: relative;
      background: linear-gradient(135deg,
        rgba(28, 22, 20, 0.80) 0%,
        rgba(20, 16, 15, 0.60) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      overflow: hidden;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .leaderboard::before {
      content: "";
      position: absolute;
      top: 0; left: 14%; right: 14%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent,
        rgba(139, 74, 107, 0.50),
        transparent);
      z-index: 1;
    }
    .lb-header {
      padding: 1.6rem 1.75rem 1rem;
      border-bottom: 1px solid var(--border-subtle);
    }
    .lb-header h2 {
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--text-primary);
    }
    .lb-note {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-top: 0.35rem;
    }
    .leaderboard.baseline-board::before {
      background: linear-gradient(90deg,
        transparent,
        rgba(199, 125, 74, 0.40),
        transparent);
    }
    .leaderboard.baseline-board .lb-header h2 { color: var(--text-secondary); font-weight: 500; }

    .lb-wrap { overflow-x: auto; }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      text-align: left;
      padding: 0.95rem 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--text-tertiary);
      border-bottom: 1px solid var(--border-subtle);
      background: transparent;
      white-space: nowrap;
    }
    thead th:first-child { padding-left: 1.75rem; }
    thead th:last-child  { padding-right: 1.75rem; }

    tbody td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      font-size: 0.9rem;
      color: var(--text-soft);
      font-variant-numeric: tabular-nums;
    }
    tbody td:first-child { padding-left: 1.75rem; }
    tbody td:last-child  { padding-right: 1.75rem; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr {
      cursor: pointer;
      transition: background 0.2s var(--ease-premium);
    }
    tbody tr:hover { background: rgba(255, 255, 255, 0.025); }

    tbody tr.top-row {
      background: linear-gradient(90deg,
        rgba(139, 74, 107, 0.10) 0%,
        rgba(139, 74, 107, 0.02) 35%,
        transparent 100%);
    }
    tbody tr.top-row td:first-child {
      box-shadow: inset 2px 0 0 var(--accent-secondary);  /* copper accent line per redesign.md §6 */
    }
    tbody tr.top-row:hover {
      background: linear-gradient(90deg,
        rgba(139, 74, 107, 0.16) 0%,
        rgba(139, 74, 107, 0.04) 35%,
        transparent 100%);
    }

    .baseline-board tbody td { color: var(--text-secondary); }
    .baseline-board tbody td.model-name-cell { color: var(--text-soft); }

    .rank-cell {
      width: 4rem;
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
    }
    .rank-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 500;
      color: var(--text-secondary);
      background: rgba(28, 22, 20, 0.55);
      border: 1px solid var(--border-subtle);
      font-variant-numeric: tabular-nums;
    }
    .rank-pill.rank-1 {
      color: var(--accent-primary-hi);
      border-color: var(--border-accent);
      background: linear-gradient(135deg,
        rgba(139, 74, 107, 0.22) 0%,
        rgba(139, 74, 107, 0.06) 100%);
      box-shadow:
        0 0 14px -2px var(--accent-glow),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .rank-pill.rank-2 {
      color: #F5EFE6;
      border-color: rgba(255, 255, 255, 0.20);
      background: linear-gradient(135deg,
        rgba(255, 255, 255, 0.10) 0%,
        rgba(255, 255, 255, 0.02) 100%);
    }
    .rank-pill.rank-3 {
      color: var(--warning);
      border-color: rgba(232, 160, 78, 0.30);
      background: linear-gradient(135deg,
        rgba(232, 160, 78, 0.14) 0%,
        rgba(232, 160, 78, 0.03) 100%);
    }

    .model-name-cell {
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--text-primary);
    }
    .model-id-mono {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-tertiary);
      font-weight: 400;
      display: block;
      margin-top: 0.28rem;
      letter-spacing: 0;
    }

    .score-cell {
      font-family: var(--font-mono);
      font-weight: 500;
      color: var(--text-primary);
    }
    .score-bar-wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
    }
    .score-bar {
      display: inline-block;
      height: 5px;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--accent-primary-lo), var(--accent-primary-hi));
      box-shadow: 0 0 12px -2px var(--accent-glow);
      max-width: 70px;
    }
    .baseline-board .score-bar {
      background: linear-gradient(90deg, var(--accent-secondary-lo), var(--accent-secondary)) !important;
      box-shadow: 0 0 12px -2px var(--accent-secondary-glow);
    }

    .cost-cell {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--text-secondary);
    }

    .trunc-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.42rem;
      padding: 0.22rem 0.65rem 0.22rem 0.55rem;
      background: rgba(232, 160, 78, 0.10);
      color: var(--warning);
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border-radius: 999px;
      margin-left: 0.55rem;
      border: 1px solid rgba(232, 160, 78, 0.30);
      white-space: nowrap;
      vertical-align: middle;
    }
    .trunc-badge::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--warning);
      box-shadow: 0 0 8px -1px var(--warning);
      flex-shrink: 0;
    }
    .trunc-note {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--warning);
      margin-top: 0.5rem;
      line-height: 1.5;
      max-width: 32ch;
      opacity: 0.85;
    }

    th.has-tooltip {
      cursor: help;
      text-decoration: underline dotted;
      text-decoration-color: var(--text-disabled);
      text-underline-offset: 4px;
    }

    .card-dims tbody tr.has-tooltip th,
    .card-dims tbody tr.has-tooltip td:first-child {
      cursor: help;
      border-bottom: 1px dotted currentColor;
    }

    /* ─────────────────────────────────────────────
       BASELINE DIVIDER
       ───────────────────────────────────────────── */
    .baseline-section { margin-bottom: 5rem; }
    .divider {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin: 2.5rem 0 1.85rem;
    }
    .divider::before, .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border-default), transparent);
    }
    .divider span {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.42rem 0.95rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--accent-secondary);
      background: linear-gradient(135deg,
        rgba(199, 125, 74, 0.10) 0%,
        rgba(199, 125, 74, 0.04) 100%);
      border: 1px solid var(--accent-secondary-line);
      border-radius: 999px;
      box-shadow:
        0 0 24px -6px var(--accent-secondary-glow),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .baseline-chart-frame { margin-bottom: 1.5rem; }
    .baseline-chart-frame::before {
      background: linear-gradient(90deg,
        transparent,
        rgba(199, 125, 74, 0.45),
        transparent);
    }

    /* ─────────────────────────────────────────────
       MODEL CARDS (drill-down)
       ───────────────────────────────────────────── */
    .cards-section { margin-bottom: 5rem; }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
    }

    .model-card {
      position: relative;
      background: linear-gradient(135deg,
        rgba(28, 22, 20, 0.80) 0%,
        rgba(20, 16, 15, 0.60) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 1.65rem;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition:
        border-color 0.35s var(--ease-premium),
        transform 0.35s var(--ease-premium),
        box-shadow 0.35s var(--ease-premium);
      overflow: hidden;
    }
    .model-card::before {
      content: "";
      position: absolute;
      top: 0; left: 12%; right: 12%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent,
        rgba(139, 74, 107, 0.50),
        transparent);
      opacity: 0.5;
      transition: opacity 0.35s var(--ease-premium), background 0.35s var(--ease-premium);
    }
    .model-card:hover {
      border-color: var(--border-accent);
      transform: translateY(-2px);
      box-shadow: var(--shadow-glow);
    }
    .model-card:hover::before { opacity: 1; }
    /* Baseline drill-down cards swap the accent line + bar fill to copper */
    .model-card--baseline::before {
      background: linear-gradient(90deg,
        transparent,
        rgba(199, 125, 74, 0.45),
        transparent);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 1.4rem;
      flex-wrap: wrap;
    }
    .card-header .rank-pill { flex-shrink: 0; }
    .model-name {
      flex: 1;
      min-width: 0;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--text-primary);
    }

    /* Type badge — LLM / baseline marker beside the model name */
    .type-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.22rem 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 500;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      flex-shrink: 0;
    }
    .type-llm {
      background: rgba(139, 74, 107, 0.10);
      color: var(--accent-primary-hi);
      border: 1px solid var(--border-accent);
    }
    .type-baseline {
      background: rgba(199, 125, 74, 0.08);
      color: var(--accent-secondary);
      border: 1px solid var(--accent-secondary-line);
    }

    .card-score { text-align: center; margin-bottom: 1.4rem; }
    .score-value {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: clamp(2.4rem, 3.5vw, 2.85rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      background: linear-gradient(135deg, #F5EFE6 0%, #D4AF7A 100%);
      -webkit-background-clip: text;
              background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .model-card--baseline .score-value {
      background: linear-gradient(135deg, #F5EFE6 0%, var(--accent-secondary) 100%);
      -webkit-background-clip: text;
              background-clip: text;
    }
    .score-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--text-tertiary);
      margin-top: 0.55rem;
      font-weight: 500;
    }

    .card-dims {
      width: 100%;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
    .card-dims caption {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--text-tertiary);
      margin-bottom: 0.65rem;
      text-align: left;
      font-weight: 500;
    }
    /* The caption + per-row dim names are enough; the synthetic header row is noise */
    .card-dims thead { display: none; }
    .card-dims th, .card-dims td {
      padding: 0.42rem 0;
      border: none;
    }
    .card-dims th {
      color: var(--text-secondary);
      font-weight: 400;
      width: 50%;
      text-align: left;
      font-size: 0.82rem;
      letter-spacing: -0.005em;
      text-transform: capitalize;
    }

    .bar-wrapper {
      position: relative;
      height: 1.1rem;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 999px;
      overflow: hidden;
    }
    .bar-fill {
      position: absolute;
      top: 0; left: 0;
      height: 100%;
      background: linear-gradient(90deg, var(--accent-primary-lo), var(--accent-primary-hi));
      box-shadow: 0 0 10px -2px var(--accent-glow);
      border-radius: 999px;
      transition: width 1.2s var(--ease-premium);
    }
    .model-card--baseline .bar-fill {
      background: linear-gradient(90deg, var(--accent-secondary-lo), var(--accent-secondary));
      box-shadow: 0 0 10px -2px var(--accent-secondary-glow);
    }
    .bar-label {
      position: relative;
      display: block;
      padding: 0 0.55rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 400;
      line-height: 1.1rem;
      white-space: nowrap;
      color: var(--text-primary);
    }

    .card-cost {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
    }
    .cost-label {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--text-tertiary);
    }
    .cost-value {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text-primary);
      font-variant-numeric: tabular-nums;
    }

    /* ─────────────────────────────────────────────
       FOOTER
       ───────────────────────────────────────────── */
    footer {
      position: relative;
      margin-top: 5rem;
      padding: 3rem 0 2.5rem;
      text-align: center;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: -0.005em;
    }
    footer::before {
      content: "";
      position: absolute;
      top: 0;
      left: 10%;
      right: 10%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent,
        var(--border-default),
        transparent);
    }
    .footer-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.6rem;
      justify-content: center;
      align-items: center;
    }
    .footer-cell {
      white-space: nowrap;
      color: var(--text-secondary);
    }
    .footer-cell a { color: var(--text-secondary); }
    .footer-cell a:hover { color: var(--accent-primary-hi); }
    .footer-value {
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 0.76rem;
    }
    .footer-mark {
      margin-top: 1.6rem;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--text-disabled);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
    }
    .footer-mark .accent-dot { color: var(--accent-primary); }

    /* ─────────────────────────────────────────────
       SCROLL REVEAL — IntersectionObserver-driven
       ───────────────────────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.4s var(--ease-premium),
        transform 0.4s var(--ease-premium);
      transition-delay: var(--reveal-delay, 0ms);
      will-change: opacity, transform;
    }
    .reveal.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
</head>
<body>

