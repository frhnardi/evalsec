<!DOCTYPE html>
<html lang="en" data-color-scheme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">

  <meta property="og:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta property="og:description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://evalsec.farhan.ngenz.org">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta name="twitter:description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">

  <title>evalsec — DevSecOps LLM Benchmark</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <script src="./chart.umd.min.js"></script>

  <style>
    @property --angle {
      syntax: "<angle>";
      initial-value: 0deg;
      inherits: false;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:           #fafafa;
      --surface:      #ffffff;
      --surface-2:    #f5f5f5;
      --border:       #e5e7eb;
      --border-soft:  #ececef;
      --border-strong:#d4d4d8;
      --text:         #0a0a0a;
      --text-soft:    #27272a;
      --muted:        #71717a;
      --muted-2:      #a1a1aa;
      --accent:       #14b8a6;
      --accent-2:     #5eead4;
      --accent-deep:  #0d9488;
      --accent-soft:  rgba(20, 184, 166, 0.10);
      --accent-line:  rgba(20, 184, 166, 0.28);
      --warn:         #f59e0b;
      --warn-soft:    rgba(245, 158, 11, 0.10);
      --success:      #10b981;
      --danger:       #ef4444;
      --radius-sm:    8px;
      --radius:       12px;
      --radius-lg:    16px;
      --radius-xl:    24px;
      --radius-2xl:   28px;
      --shadow-1:     0 1px 2px rgba(0,0,0,0.04);
      --shadow-2:     0 8px 24px -8px rgba(0,0,0,0.08);
      --font-sans:    "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono:    "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      --grain:        radial-gradient(1px 1px at 25% 35%, rgba(0,0,0,0.04) 50%, transparent 50%),
                      radial-gradient(1px 1px at 75% 65%, rgba(0,0,0,0.04) 50%, transparent 50%);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg:           #08070b;
        --surface:      #0f0e13;
        --surface-2:    #141319;
        --border:       rgba(255,255,255,0.07);
        --border-soft:  rgba(255,255,255,0.04);
        --border-strong:rgba(255,255,255,0.14);
        --text:         #fafafa;
        --text-soft:    #e4e4e7;
        --muted:        #a1a1aa;
        --muted-2:      #71717a;
        --accent:       #14b8a6;
        --accent-2:     #5eead4;
        --accent-deep:  #0d9488;
        --accent-soft:  rgba(20, 184, 166, 0.14);
        --accent-line:  rgba(20, 184, 166, 0.40);
        --warn:         #fbbf24;
        --warn-soft:    rgba(251, 191, 36, 0.10);
        --shadow-1:     0 1px 2px rgba(0,0,0,0.4);
        --shadow-2:     0 12px 32px -12px rgba(0,0,0,0.6);
        --grain:        radial-gradient(1px 1px at 25% 35%, rgba(255,255,255,0.04) 50%, transparent 50%),
                        radial-gradient(1px 1px at 75% 65%, rgba(255,255,255,0.04) 50%, transparent 50%);
      }
    }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    body {
      background-image: var(--grain);
      background-size: 28px 28px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* ─────────────────────────────────────────────
       HERO
       ───────────────────────────────────────────── */
    .hero {
      position: relative;
      padding: 5rem 0 3.5rem;
      text-align: center;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      top: -10%;
      left: 50%;
      transform: translateX(-50%);
      width: 720px;
      height: 400px;
      background: radial-gradient(closest-side, var(--accent-soft), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .hero-inner { position: relative; z-index: 1; }

    .beta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.9rem;
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid var(--accent-line);
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 1.75rem;
    }
    .pulse-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 0 var(--accent);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(163,105,255,0.6); }
      70%  { box-shadow: 0 0 0 8px rgba(163,105,255,0); }
      100% { box-shadow: 0 0 0 0 rgba(163,105,255,0); }
    }

    .hero-title {
      font-size: clamp(3rem, 8vw, 6rem);
      font-weight: 500;
      letter-spacing: -0.055em;
      line-height: 0.95;
      margin-bottom: 1rem;
    }
    .hero-title .accent-dot { color: var(--accent); }

    .hero-subtitle {
      font-size: clamp(1.1rem, 2.2vw, 1.4rem);
      color: var(--text-soft);
      font-weight: 500;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }
    .hero-desc {
      font-size: 1.05rem;
      color: var(--muted);
      max-width: 44rem;
      margin: 0 auto;
      letter-spacing: -0.005em;
    }

    .meta-pills {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 2rem;
    }
    .meta-pill {
      padding: 0.4rem 0.85rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.74rem;
      color: var(--muted);
      font-family: var(--font-mono);
      background: var(--surface);
    }

    /* ─────────────────────────────────────────────
       SECTION HEADINGS
       ───────────────────────────────────────────── */
    .section-title {
      font-size: clamp(1.75rem, 3.5vw, 2.5rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1.1;
      text-align: center;
      margin-bottom: 0.6rem;
    }
    .section-title .accent-dot { color: var(--accent); }
    .section-sub {
      text-align: center;
      color: var(--muted);
      font-size: 1rem;
      max-width: 36rem;
      margin: 0 auto 2rem;
      letter-spacing: -0.01em;
    }

    /* ─────────────────────────────────────────────
       HERO STATS
       ───────────────────────────────────────────── */
    .stats-section { margin-bottom: 6rem; }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    @media (max-width: 820px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .stat {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.5rem 1.4rem 1.35rem;
      transition: border-color 0.25s ease, transform 0.25s ease;
      overflow: hidden;
    }
    .stat::before {
      content: "";
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .stat:hover {
      border-color: var(--accent-line);
      transform: translateY(-2px);
    }
    .stat:hover::before { opacity: 1; }

    .stat-value {
      font-size: 2.5rem;
      font-weight: 600;
      letter-spacing: -0.04em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .stat-value.small {
      font-size: 1.6rem;
      font-weight: 600;
      letter-spacing: -0.025em;
    }
    .stat-label {
      display: block;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
      margin-top: 0.65rem;
      font-weight: 600;
    }
    .stat-sub {
      display: block;
      font-size: 0.78rem;
      color: var(--muted-2);
      margin-top: 0.25rem;
      letter-spacing: -0.005em;
    }

    /* ─────────────────────────────────────────────
       METHODOLOGY TABS
       ───────────────────────────────────────────── */
    .method-section { margin-bottom: 6rem; }

    .method-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    }

    .method-tab {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.75rem 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-family: inherit;
      font-size: 0.86rem;
      font-weight: 500;
      color: var(--text-soft);
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .method-tab:hover { border-color: var(--border-strong); color: var(--text); }
    .method-tab .method-tab-icon {
      font-size: 1rem;
      line-height: 1;
    }
    .method-tab.selected {
      color: var(--text);
      background: var(--surface);
    }
    .method-tab.selected::after {
      content: "";
      position: absolute;
      inset: -1.5px;
      border-radius: inherit;
      padding: 1.5px;
      background: conic-gradient(from var(--angle), transparent 0%, var(--accent) 18%, transparent 30%, transparent 60%, var(--accent-2) 78%, transparent 90%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
              mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
              mask-composite: exclude;
      animation: spin 4.5s linear infinite;
      pointer-events: none;
    }
    @keyframes spin { to { --angle: 360deg; } }

    .method-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-2xl);
      padding: 0.55rem;
      background: var(--surface);
    }
    .method-inner {
      background: var(--surface-2);
      border-radius: calc(var(--radius-2xl) - 5px);
      padding: 2rem clamp(1.25rem, 4vw, 3rem);
      min-height: 220px;
    }

    .method-panel { display: none; }
    .method-panel.active { display: block; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .method-panel h3 {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
      color: var(--text);
    }
    .method-panel p {
      color: var(--text-soft);
      font-size: 0.95rem;
      max-width: 60ch;
      margin-bottom: 0.65rem;
    }
    .method-panel p:last-child { margin-bottom: 0; }
    .method-panel ul {
      list-style: none;
      padding: 0;
      color: var(--text-soft);
      font-size: 0.93rem;
    }
    .method-panel ul > li {
      padding-left: 1.15rem;
      position: relative;
      margin-bottom: 0.5rem;
    }
    .method-panel ul > li::before {
      content: "—";
      position: absolute; left: 0;
      color: var(--accent);
    }
    .method-panel ul ul {
      margin-top: 0.4rem;
      margin-left: 0.4rem;
      font-size: 0.88rem;
    }
    .method-panel ul ul > li::before { content: "·"; color: var(--muted-2); }
    .method-panel strong { color: var(--text); font-weight: 600; }

    /* ─────────────────────────────────────────────
       CHARTS
       ───────────────────────────────────────────── */
    .charts-section { margin-bottom: 4.5rem; }

    .charts-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-2xl);
      padding: 0.55rem;
      background: var(--surface);
      box-shadow: var(--shadow-2);
    }
    .charts-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem;
      background: var(--surface-2);
      border-radius: calc(var(--radius-2xl) - 5px);
      padding: 0.55rem;
    }
    @media (max-width: 900px) {
      .charts-inner { grid-template-columns: 1fr; }
    }

    .chart-card {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 1.4rem 1.4rem 1.1rem;
    }
    .chart-card h3 {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 0.3rem;
    }
    .chart-sub {
      font-size: 0.8rem;
      color: var(--muted-2);
      margin-bottom: 1rem;
    }
    .chart-card canvas { max-height: 340px; }

    .baseline-chart-frame .charts-inner {
      grid-template-columns: 1fr;
    }
    .baseline-chart-frame canvas { max-height: 240px; }

    .chart-fallback {
      display: none;
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--muted-2);
      font-size: 0.88rem;
      border: 1px dashed var(--border-strong);
      border-radius: var(--radius);
    }
    .chart-fallback.visible { display: block; }
    .chart-fallback-icon {
      font-size: 1.6rem;
      margin-bottom: 0.5rem;
      opacity: 0.5;
    }

    /* ─────────────────────────────────────────────
       DISCLAIMER
       ───────────────────────────────────────────── */
    .disclaimer {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: var(--warn-soft);
      border: 1px solid var(--warn);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.35rem;
      margin-bottom: 1.5rem;
    }
    .disclaimer.is-dismissed { display: none; }
    .disclaimer-icon {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--warn);
      color: #000;
      font-size: 0.95rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .disclaimer-body { flex: 1; color: var(--text-soft); font-size: 0.92rem; line-height: 1.5; }
    .disclaimer-body strong { color: var(--warn); font-weight: 600; }
    .disclaimer-close {
      background: transparent;
      border: none;
      color: var(--muted);
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      padding: 0 0.35rem;
      font-family: inherit;
    }
    .disclaimer-close:hover { color: var(--text); }

    /* ─────────────────────────────────────────────
       LEADERBOARD
       ───────────────────────────────────────────── */
    .ranking-section { margin-bottom: 5rem; }

    .leaderboard {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      overflow: hidden;
    }
    .lb-header {
      padding: 1.5rem 1.75rem 0.9rem;
      border-bottom: 1px solid var(--border-soft);
    }
    .lb-header h2 {
      font-size: 1.15rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    .lb-note {
      font-size: 0.82rem;
      color: var(--muted);
      margin-top: 0.3rem;
    }
    .leaderboard.baseline-board .lb-header h2 { color: var(--muted); font-weight: 500; }

    .lb-wrap { overflow-x: auto; }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      text-align: left;
      padding: 0.85rem 1.25rem;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      border-bottom: 1px solid var(--border-soft);
      background: transparent;
      white-space: nowrap;
    }
    thead th:first-child { padding-left: 1.75rem; }
    thead th:last-child  { padding-right: 1.75rem; }

    tbody td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border-soft);
      font-size: 0.9rem;
      color: var(--text-soft);
      font-variant-numeric: tabular-nums;
    }
    tbody td:first-child { padding-left: 1.75rem; }
    tbody td:last-child  { padding-right: 1.75rem; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr { transition: background 0.15s ease; }
    tbody tr:hover { background: var(--surface-2); }

    tbody tr.top-row {
      background: linear-gradient(90deg, var(--accent-soft) 0%, transparent 100%);
    }
    tbody tr.top-row td:first-child {
      border-left: 3px solid var(--accent);
    }
    tbody tr.top-row:hover { filter: brightness(1.04); }

    .baseline-board tbody td { color: var(--muted); }
    .baseline-board tbody td.model-name-cell { color: var(--text-soft); }

    .rank-cell {
      font-weight: 600;
      width: 3.5rem;
      font-size: 1rem;
      color: var(--muted);
    }
    .medal { font-size: 1.3rem; }

    .model-name-cell { font-weight: 500; letter-spacing: -0.01em; color: var(--text); }
    .model-id-mono {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted-2);
      font-weight: 400;
      display: block;
      margin-top: 0.2rem;
    }

    .score-cell { font-weight: 600; }
    .score-bar-wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
    }
    .score-bar {
      display: inline-block;
      height: 5px;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      max-width: 70px;
    }

    .cost-cell {
      font-family: var(--font-mono);
      font-size: 0.83rem;
      color: var(--muted);
    }

    .type-badge {
      display: inline-block;
      padding: 0.18rem 0.6rem;
      font-size: 0.65rem;
      font-weight: 600;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .type-llm {
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid var(--accent-line);
    }
    .type-baseline {
      background: var(--warn-soft);
      color: var(--warn);
      border: 1px solid var(--warn);
    }

    .trunc-badge {
      display: inline-block;
      padding: 0.18rem 0.55rem;
      background: var(--warn-soft);
      color: var(--warn);
      font-size: 0.68rem;
      font-weight: 600;
      border-radius: 999px;
      margin-left: 0.55rem;
      border: 1px solid var(--warn);
      white-space: nowrap;
    }
    .trunc-note {
      font-size: 0.72rem;
      color: var(--warn);
      margin-top: 0.45rem;
      line-height: 1.45;
      max-width: 32ch;
    }

    th.has-tooltip {
      cursor: help;
      text-decoration: underline dotted;
      text-decoration-color: var(--muted-2);
      text-underline-offset: 4px;
    }

    .card-dims tbody tr.has-tooltip th,
    .card-dims tbody tr.has-tooltip td:first-child {
      cursor: help;
      border-bottom: 1px dotted currentColor;
    }

    /* ─────────────────────────────────────────────
       BASELINE DIVIDER
       ───────────────────────────────────────────── */
    .baseline-section { margin-bottom: 5rem; }
    .divider {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin: 2rem 0 1.75rem;
    }
    .divider::before, .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    .divider span {
      font-size: 0.74rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .baseline-chart-frame { margin-bottom: 1.5rem; }

    /* ─────────────────────────────────────────────
       MODEL CARDS
       ───────────────────────────────────────────── */
    .cards-section { margin-bottom: 5rem; }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
    }

    .model-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 1.5rem;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .model-card:hover {
      border-color: var(--accent-line);
      transform: translateY(-2px);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }

    .rank-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.2rem; height: 2.2rem;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.8rem;
      font-weight: 600;
      flex-shrink: 0;
      border: 1px solid var(--accent-line);
    }
    .model-name {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--text);
    }

    .card-score { text-align: center; margin-bottom: 1.25rem; }
    .score-value {
      font-size: 2.75rem;
      font-weight: 500;
      letter-spacing: -0.04em;
      line-height: 1;
      color: var(--text);
    }
    .score-label {
      display: block;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted);
      margin-top: 0.4rem;
      font-weight: 600;
    }

    .card-dims {
      width: 100%;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
    .card-dims caption {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
      margin-bottom: 0.55rem;
      text-align: left;
      font-weight: 600;
    }
    .card-dims th, .card-dims td {
      padding: 0.4rem 0;
      border: none;
    }
    .card-dims th {
      color: var(--muted);
      font-weight: 400;
      width: 50%;
      text-align: left;
    }

    .bar-wrapper {
      position: relative;
      height: 1.05rem;
      background: var(--surface-2);
      border-radius: 999px;
      overflow: hidden;
    }
    .bar-fill {
      position: absolute;
      top: 0; left: 0;
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      border-radius: 999px;
      transition: width 0.3s ease;
    }
    .bar-label {
      position: relative;
      display: block;
      padding: 0 0.5rem;
      font-size: 0.72rem;
      font-weight: 500;
      line-height: 1.05rem;
      white-space: nowrap;
      color: var(--text);
      font-family: var(--font-mono);
    }

    .card-cost {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-soft);
    }
    .cost-label { color: var(--muted); }
    .cost-value { font-family: var(--font-mono); color: var(--text-soft); }

    /* ─────────────────────────────────────────────
       FOOTER
       ───────────────────────────────────────────── */
    footer {
      margin-top: 5rem;
      padding: 3rem 0 2.5rem;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--muted);
      font-size: 0.83rem;
    }
    .footer-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      justify-content: center;
      align-items: center;
    }
    .footer-cell { white-space: nowrap; }
    .footer-value { color: var(--text-soft); font-family: var(--font-mono); font-size: 0.78rem; }
    .footer-mark {
      margin-top: 1.25rem;
      font-size: 0.72rem;
      color: var(--muted-2);
      letter-spacing: 0.08em;
    }
    .footer-mark .accent-dot { color: var(--accent); }
  </style>
</head>
<body>

<header class="hero">
  <div class="container hero-inner">
    <span class="beta-pill"><span class="pulse-dot"></span> BETA · v0.1.0</span>

    <h1 class="hero-title">evalsec<span class="accent-dot">.</span></h1>
    <p class="hero-subtitle">DevSecOps LLM Benchmark</p>
    <p class="hero-desc">
      Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.
    </p>

    <div class="meta-pills">
      <span class="meta-pill">📅 {{ graded_at }}</span>
      <span class="meta-pill">🎯 task: {{ task }}</span>
      <span class="meta-pill">⚖ judge: Claude Opus 4.7</span>
      <span class="meta-pill">📊 {{ response_count }} responses</span>
    </div>
  </div>
</header>

<main class="container">

  <!-- ── Hero Stats ── -->
  <section class="stats-section">
    <div class="stats-grid">
      <div class="stat">
        <div class="stat-value" id="stat-models">—</div>
        <span class="stat-label">Models tested</span>
        <span class="stat-sub">LLMs evaluated</span>
      </div>
      <div class="stat">
        <div class="stat-value" id="stat-cases">—</div>
        <span class="stat-label">Cases evaluated</span>
        <span class="stat-sub">Per model</span>
      </div>
      <div class="stat">
        <div class="stat-value" id="stat-top-score">—</div>
        <span class="stat-label">Top score</span>
        <span class="stat-sub" id="stat-top-score-sub">LLMs only</span>
      </div>
      <div class="stat">
        <div class="stat-value small" id="stat-best-value">—</div>
        <span class="stat-label">Best value</span>
        <span class="stat-sub" id="stat-best-value-sub">Score per dollar</span>
      </div>
    </div>
  </section>

  <!-- ── Methodology ── -->
  <section class="method-section">
    <h2 class="section-title">How this benchmark works<span class="accent-dot">.</span></h2>
    <p class="section-sub">Three reasons why evalsec scores differently from CVSS-only triage.</p>

    <div class="method-tabs" role="tablist">
      <button class="method-tab selected" type="button" data-tab="what" role="tab" aria-selected="true">
        <span class="method-tab-icon">🎯</span><span>What We Test</span>
      </button>
      <button class="method-tab" type="button" data-tab="how" role="tab" aria-selected="false">
        <span class="method-tab-icon">⚖</span><span>How We Score</span>
      </button>
      <button class="method-tab" type="button" data-tab="why" role="tab" aria-selected="false">
        <span class="method-tab-icon">🔒</span><span>Why It Matters</span>
      </button>
    </div>

    <div class="method-frame">
      <div class="method-inner">
        <div class="method-panel active" data-panel="what" role="tabpanel">
          <h3>What We Test</h3>
          <p>
            Each test case contains a real Trivy vulnerability scan output from a popular
            container image (nginx, redis, postgres, etc.) plus a realistic Kubernetes/EKS
            deployment context. Models must triage the findings by determining real
            <strong>exploitability</strong> — not just CVSS score.
          </p>
        </div>

        <div class="method-panel" data-panel="how" role="tabpanel">
          <h3>How We Score</h3>
          <p>Each response goes through two passes:</p>
          <ul>
            <li>
              <strong>Pass 1 — deterministic (20%)</strong> · regex matches, JSON validity,
              CVE coverage, format compliance.
            </li>
            <li>
              <strong>Pass 2 — LLM judge (80%)</strong> · Claude Opus 4.7 scores responses
              on four rubric dimensions:
              <ul>
                <li><strong>Reachability</strong> — does the model use deployment context?</li>
                <li><strong>Prioritization</strong> — correct urgency ranking?</li>
                <li><strong>Actionability</strong> — specific, executable recommendations?</li>
                <li><strong>Conciseness</strong> — focused output without padding?</li>
              </ul>
            </li>
          </ul>
        </div>

        <div class="method-panel" data-panel="why" role="tabpanel">
          <h3>Why It Matters</h3>
          <p>
            Most CVE triage benchmarks score against CVSS alone. <strong>evalsec</strong>
            measures whether LLMs can reason about exploitability in realistic production
            deployments — the actual skill DevSecOps engineers need.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Charts ── -->
  <section class="charts-section">
    <h2 class="section-title">The leaderboard at a glance<span class="accent-dot">.</span></h2>
    <p class="section-sub">Composite scores and per-dimension strengths across all evaluated LLMs.</p>

    <div class="charts-frame">
      <div class="charts-inner">
        <div class="chart-card">
          <h3>Composite Score</h3>
          <div class="chart-sub">Higher is better · 0–100 scale</div>
          <canvas id="barChart"></canvas>
          <div class="chart-fallback" id="barChartFallback">
            <div class="chart-fallback-icon">📊</div>
            <div>Chart requires Chart.js — check browser console for details.</div>
          </div>
        </div>
        <div class="chart-card">
          <h3>Per-Dimension Radar</h3>
          <div class="chart-sub">Strengths across rubric dimensions</div>
          <canvas id="radarChart"></canvas>
          <div class="chart-fallback" id="radarChartFallback">
            <div class="chart-fallback-icon">🕸️</div>
            <div>Chart requires Chart.js — check browser console for details.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── LLM Leaderboard ── -->
  <section class="ranking-section">
    <aside class="disclaimer" id="prelimDisclaimer">
      <div class="disclaimer-icon" aria-hidden="true">!</div>
      <div class="disclaimer-body">
        <strong>Preliminary results</strong> — based on
        <strong><span id="disclaimer-cases">1</span> of 17</strong>
        test cases. Final rankings may shift significantly with the full benchmark.
        Full results coming soon.
      </div>
      <button class="disclaimer-close" type="button" aria-label="Dismiss notice" id="dismissDisclaimer">×</button>
    </aside>

    {% set llm_entries = leaderboard | selectattr("model_type", "equalto", "llm") | list %}
    <div class="leaderboard">
      <div class="lb-header">
        <h2>LLM Rankings</h2>
        <div class="lb-note">Scored by Claude Opus 4.7 across rubric dimensions, normalized to 0–100.</div>
      </div>
      <div class="lb-wrap">
        <table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>Model</th>
              <th>Score</th>
              <th class="has-tooltip" title="Does the model use stack context to determine real exploitability vs just relying on CVSS scores?">Reachability</th>
              <th class="has-tooltip" title="Does the model rank findings by correct urgency (critical first, deferrable last)?">Prioritization</th>
              <th class="has-tooltip" title="Are recommendations specific and executable, with concrete commands or patch versions?">Actionability</th>
              <th class="has-tooltip" title="Is the response focused without preamble or padding, under target length?">Conciseness</th>
              <th>Cost</th>
            </tr>
          </thead>
          <tbody>
            {% for entry in llm_entries %}
            {% set is_truncated = entry.details | selectattr("score.validation.parse_error") | list | length > 0 %}
            {% set reach = entry.dimension_scores.get("reachability_reasoning", 0) %}
            {% set prio  = entry.dimension_scores.get("prioritization", 0) %}
            {% set act   = entry.dimension_scores.get("actionability", 0) %}
            {% set conc  = entry.dimension_scores.get("conciseness", 0) %}
            <tr class="{% if loop.index == 1 %}top-row{% endif %}" data-model-id="{{ entry.model_id }}">
              <td class="rank-cell">
                {% if loop.index == 1 %}<span class="medal">🥇</span>
                {% elif loop.index == 2 %}<span class="medal">🥈</span>
                {% elif loop.index == 3 %}<span class="medal">🥉</span>
                {% else %}#{{ loop.index }}
                {% endif %}
              </td>
              <td class="model-name-cell">
                <span class="model-display-name" data-id="{{ entry.model_id }}">{{ entry.model_id }}</span>
                {% if is_truncated %}<span class="trunc-badge" title="Response exceeded max_tokens — JSON truncated. Score reflects partial output only.">⚠ Truncated</span>{% endif %}
                <span class="model-id-mono">{{ entry.model_id }}</span>
                {% if is_truncated %}
                <div class="trunc-note">Response exceeded max_tokens — JSON truncated. Score reflects partial output only.</div>
                {% endif %}
              </td>
              <td class="score-cell">
                <div class="score-bar-wrap">
                  <span class="score-bar" style="width: {{ entry.avg_score * 0.7 }}px;"></span>
                  {{ "%.1f"|format(entry.avg_score) }}
                </div>
              </td>
              <td>{{ "%.1f"|format(reach) }}</td>
              <td>{{ "%.1f"|format(prio) }}</td>
              <td>{{ "%.1f"|format(act) }}</td>
              <td>{{ "%.1f"|format(conc) }}</td>
              <td class="cost-cell">${{ "%.4f"|format(entry.total_cost) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ── Baseline Section ── -->
  {% set baselines = leaderboard | selectattr("model_type", "equalto", "baseline") | list %}
  {% if baselines %}
  <section class="baseline-section">
    <div class="divider"><span>Baseline methods · no AI reasoning</span></div>

    <div class="charts-frame baseline-chart-frame">
      <div class="charts-inner">
        <div class="chart-card">
          <h3>Baseline Scores</h3>
          <div class="chart-sub">Deterministic methods · for reference only, not directly comparable to LLMs</div>
          <canvas id="baselineBarChart"></canvas>
          <div class="chart-fallback" id="baselineBarChartFallback">
            <div class="chart-fallback-icon">📊</div>
            <div>Chart requires Chart.js — check browser console for details.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="leaderboard baseline-board">
      <div class="lb-header">
        <h2>Baseline Comparison</h2>
        <div class="lb-note">Baselines use deterministic scoring only (no LLM judge pass). Scores are not directly comparable to LLMs.</div>
      </div>
      <div class="lb-wrap">
        <table>
          <thead>
            <tr>
              <th>Model</th>
              <th>Score</th>
              <th class="has-tooltip" title="How accurate were verdicts (exploitable/not exploitable/partial) vs ground truth?">Verdict Accuracy</th>
              <th class="has-tooltip" title="How accurate was the priority ordering vs ground truth?">Priority Accuracy</th>
            </tr>
          </thead>
          <tbody>
            {% for entry in baselines %}
            <tr data-model-id="{{ entry.model_id }}">
              <td class="model-name-cell">
                <span class="model-display-name" data-id="{{ entry.model_id }}">{{ entry.model_id }}</span>
                <span class="model-id-mono">{{ entry.model_id }}</span>
              </td>
              <td class="score-cell">
                <div class="score-bar-wrap">
                  <span class="score-bar" style="width: {{ entry.avg_score * 0.7 }}px; background: linear-gradient(90deg, var(--warn), #fbbf24);"></span>
                  {{ "%.1f"|format(entry.avg_score) }}
                </div>
              </td>
              <td>{{ "%.1f"|format(entry.avg_verdict) }}</td>
              <td>{{ "%.1f"|format(entry.avg_priority) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ── Model Cards ── -->
  <section class="cards-section">
    <h2 class="section-title">Drill-down per model<span class="accent-dot">.</span></h2>
    <p class="section-sub">Full per-dimension breakdown for every evaluated model.</p>
    <div class="cards-grid">
      {% for entry in leaderboard %}
      {% include "card.html.j2" %}
      {% endfor %}
    </div>
  </section>

</main>

<footer>
  <div class="container">
    <div class="footer-row">
      <span class="footer-cell">Last updated: <span class="footer-value">{{ graded_at }}</span></span>
      <span class="footer-cell">Source: <a href="https://github.com/frhnardi/evalsec">github.com/frhnardi/evalsec</a></span>
      <span class="footer-cell"><a href="https://github.com/frhnardi/evalsec/blob/main/docs/methodology.md">Methodology</a></span>
      <span class="footer-cell"><a href="https://github.com/frhnardi/evalsec/blob/main/CONTRIBUTING.md">Contribute</a></span>
      <span class="footer-cell">License: <span class="footer-value">MIT</span></span>
    </div>
    <div class="footer-mark">evalsec<span class="accent-dot">.</span> built by Farhan Ardi · for the DevSecOps community.</div>
  </div>
</footer>

<script>
try {
(function() {
  const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

  // ── Display name + dimension label maps ──
  const MODEL_DISPLAY = {
    "claude_sonnet_46":      "Claude Sonnet 4.6",
    "kimi_k2_thinking":      "Kimi K2.6 Thinking",
    "qwen_3_5":              "Qwen 3.5",
    "deepseek_v4_pro":       "DeepSeek V4 Pro",
    "claude_opus_47":        "Claude Opus 4.7 (Judge)",
    "baseline_cvss":         "Baseline: CVSS Sort",
    "baseline_trivy":        "Baseline: Trivy Severity",
    "baseline_epss":         "Baseline: EPSS Score",
    "baseline_reachability": "Baseline: Reachability",
  };
  const displayName = id => MODEL_DISPLAY[id] || id;

  const DIM_LABELS = {
    reachability_reasoning: "Reachability",
    prioritization:         "Prioritization",
    actionability:          "Actionability",
    conciseness:            "Conciseness",
    format:                 "Format",
    coverage:               "Coverage",
    verdict:                "Verdict Accuracy",
    priority:               "Priority Order",
  };
  const dimLabel = d => DIM_LABELS[d] || d.replace(/_/g, " ");

  const DIM_TOOLTIPS = {
    reachability_reasoning: "Does the model use stack context to determine real exploitability vs just relying on CVSS scores?",
    prioritization:         "Does the model rank findings by correct urgency (critical first, deferrable last)?",
    actionability:          "Are recommendations specific and executable, with concrete commands or patch versions?",
    conciseness:            "Is the response focused without preamble or padding, under target length?",
    format:                 "Is output valid JSON matching the expected schema?",
    coverage:               "Did the model address all CVEs in the input scan?",
    verdict:                "How accurate were verdicts (exploitable/not exploitable/partial) vs ground truth?",
    priority:               "How accurate was the priority ordering vs ground truth?",
    hall_penalty:           "Penalty for fabricated CVEs not in original scan (lower is better)",
  };
  const DIM_TOOLTIPS_BY_TEXT = {};
  Object.entries(DIM_TOOLTIPS).forEach(([k, v]) => {
    DIM_TOOLTIPS_BY_TEXT[k.replace(/_/g, " ")] = v;
  });
  DIM_TOOLTIPS_BY_TEXT["hall. penalty"] = DIM_TOOLTIPS.hall_penalty;
  DIM_TOOLTIPS_BY_TEXT["regex"]         = "Regex / pattern match score on deterministic Pass 1.";
  DIM_TOOLTIPS_BY_TEXT["cost"]          = "Total API cost for this model across all evaluated cases.";

  // ── Chart.js theme ──
  let chartLoaded = false;
  try {
    Chart.defaults.color       = isDark ? '#a1a1aa' : '#71717a';
    Chart.defaults.borderColor = isDark ? 'rgba(255,255,255,0.06)' : '#e5e7eb';
    Chart.defaults.font.family = '"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    chartLoaded = true;
  } catch (_) {
    console.warn('Chart.js failed to load — chart canvas elements will show fallback message.');
    // Show fallback UI for each chart card
    ['barChart', 'radarChart', 'baselineBarChart'].forEach(id => {
      const fb = document.getElementById(id + 'Fallback');
      if (fb) fb.classList.add('visible');
    });
  }

  const ACCENT  = '#14b8a6';
  const ACCENT2 = '#5eead4';
  const ACCENT3 = '#0d9488';
  const NEUTRAL = isDark ? '#52525b' : '#a1a1aa';
  const WARN    = isDark ? '#fbbf24' : '#f59e0b';

  function paletteFor(n) {
    const base = [ACCENT, ACCENT2, ACCENT3];
    return Array.from({ length: n }, (_, i) => base[i] || NEUTRAL);
  }

  // ── Data from server ──
  const leaderboard     = {{ leaderboard | tojson }};
  const dimNames        = {{ dim_names | tojson }};
  const llmEntries      = leaderboard.filter(e => e.model_type === "llm");
  const baselineEntries = leaderboard.filter(e => e.model_type === "baseline");

  // ── Display-name replacement throughout the DOM ──
  document.querySelectorAll('.model-display-name').forEach(el => {
    const id = el.dataset.id;
    if (id) el.textContent = displayName(id);
  });

  // ── Model card enhancement (preserve card.html.j2 untouched) ──
  document.querySelectorAll('.model-card').forEach(card => {
    const rank = parseInt(card.dataset.rank, 10);
    const entry = leaderboard.find(e => e.rank === rank);
    if (!entry) return;

    const nameEl = card.querySelector('.model-name');
    if (nameEl) nameEl.textContent = displayName(entry.model_id);

    const truncated = (entry.details || []).some(d =>
      d && d.score && d.score.validation && d.score.validation.parse_error
    );
    if (truncated && nameEl) {
      const badge = document.createElement('span');
      badge.className = 'trunc-badge';
      badge.textContent = '⚠ Truncated';
      badge.title = 'Response exceeded max_tokens — JSON truncated.';
      nameEl.appendChild(badge);

      const note = document.createElement('div');
      note.className = 'trunc-note';
      note.textContent = 'Response exceeded max_tokens — JSON truncated. Score reflects partial output only.';
      const scoreEl = card.querySelector('.card-score');
      if (scoreEl) scoreEl.appendChild(note);
    }

    card.querySelectorAll('.card-dims tbody tr').forEach(tr => {
      const firstCell = tr.querySelector('td, th');
      if (!firstCell) return;
      const text = firstCell.textContent.trim().toLowerCase();
      const tip = DIM_TOOLTIPS_BY_TEXT[text];
      if (tip) {
        tr.title = tip;
        tr.classList.add('has-tooltip');
      }
    });
  });

  // ── Hero stats ──
  const allCases = new Set();
  leaderboard.forEach(e => (e.details || []).forEach(d => {
    if (d && d.case_id) allCases.add(d.case_id);
  }));
  const caseCount = allCases.size || (leaderboard[0]?.details?.length || 0);

  document.getElementById('stat-models').textContent = llmEntries.length;
  document.getElementById('stat-cases').textContent  = caseCount;

  const disclaimerCases = document.getElementById('disclaimer-cases');
  if (disclaimerCases) disclaimerCases.textContent = caseCount || 1;

  const topEl    = document.getElementById('stat-top-score');
  const topSubEl = document.getElementById('stat-top-score-sub');
  if (llmEntries.length > 0) {
    const topEntry = llmEntries.reduce((acc, e) => e.avg_score > acc.avg_score ? e : acc);
    topEl.textContent = topEntry.avg_score.toFixed(1);
    if (topSubEl) topSubEl.textContent = displayName(topEntry.model_id);
  } else {
    topEl.textContent = '—';
    if (topSubEl) topSubEl.textContent = 'No LLM data';
  }

  const llmWithCost   = llmEntries.filter(e => (e.total_cost || 0) > 0);
  const bestValueEl   = document.getElementById('stat-best-value');
  const bestValueSub  = document.getElementById('stat-best-value-sub');
  if (llmWithCost.length === 0) {
    bestValueEl.textContent = 'N/A';
    bestValueEl.classList.remove('small');
    if (bestValueSub) bestValueSub.textContent = 'Pending — costs $0 in current run';
  } else {
    const best = llmWithCost.reduce((acc, e) =>
      (e.avg_score / e.total_cost) > (acc.avg_score / acc.total_cost) ? e : acc
    );
    const ratio = best.avg_score / best.total_cost;
    const ratioStr = ratio >= 100
      ? Math.round(ratio).toLocaleString()
      : ratio.toFixed(1);
    bestValueEl.textContent = ratioStr;
    bestValueEl.classList.remove('small');
    if (bestValueSub) bestValueSub.textContent = displayName(best.model_id);
  }

  // ── Disclaimer dismissal ──
  const disclaimer = document.getElementById('prelimDisclaimer');
  const dismissBtn = document.getElementById('dismissDisclaimer');
  if (disclaimer && sessionStorage.getItem('evalsecDismissDisclaimer') === '1') {
    disclaimer.classList.add('is-dismissed');
  }
  if (dismissBtn) {
    dismissBtn.addEventListener('click', () => {
      if (disclaimer) disclaimer.classList.add('is-dismissed');
      try { sessionStorage.setItem('evalsecDismissDisclaimer', '1'); } catch (_) {}
    });
  }

  // ── Methodology tab switching ──
  const tabs   = document.querySelectorAll('.method-tab');
  const panels = document.querySelectorAll('.method-panel');
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabs.forEach(t => {
        const sel = t === btn;
        t.classList.toggle('selected', sel);
        t.setAttribute('aria-selected', sel ? 'true' : 'false');
      });
      panels.forEach(p => p.classList.toggle('active', p.dataset.panel === target));
    });
  });

  // ── Bar Chart (LLM composite scores) ──
  if (chartLoaded && llmEntries.length > 0) {
    const colors = paletteFor(llmEntries.length);
    new Chart(document.getElementById('barChart'), {
      type: 'bar',
      data: {
        labels: llmEntries.map(e => displayName(e.model_id)),
        datasets: [{
          label: 'Composite Score',
          data: llmEntries.map(e => e.avg_score),
          backgroundColor: colors,
          borderRadius: 8,
          borderSkipped: false,
          maxBarThickness: 28,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: {
          x: { min: 0, max: 100, grid: { color: isDark ? 'rgba(255,255,255,0.05)' : '#f0f0f3' } },
          y: { grid: { display: false }, ticks: { font: { weight: '500' } } }
        }
      }
    });
  }

  // ── Radar Chart (LLM only, readable dim labels) ──
  if (chartLoaded && llmEntries.length > 0) {
    const colors = paletteFor(llmEntries.length);
    const radarDatasets = llmEntries.map((entry, i) => ({
      label: displayName(entry.model_id),
      data: dimNames.map(d => (entry.dimension_scores[d] || 0)),
      borderColor: colors[i],
      backgroundColor: colors[i] + '22',
      borderWidth: 2,
      pointRadius: 3,
      pointBackgroundColor: colors[i],
    }));

    new Chart(document.getElementById('radarChart'), {
      type: 'radar',
      data: {
        labels: dimNames.map(dimLabel),
        datasets: radarDatasets,
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        scales: {
          r: {
            min: 0, max: 100,
            ticks: { stepSize: 25, backdropColor: 'transparent', font: { size: 10 } },
            grid:  { color: isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)' },
            angleLines: { color: isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)' },
            pointLabels: { font: { size: 11, weight: '500' } }
          }
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: { boxWidth: 10, padding: 14, font: { size: 12 } },
          }
        }
      }
    });
  }

  // ── Baseline Bar Chart ──
  const baselineCanvas = document.getElementById('baselineBarChart');
  if (chartLoaded && baselineCanvas && baselineEntries.length > 0) {
    new Chart(baselineCanvas, {
      type: 'bar',
      data: {
        labels: baselineEntries.map(e => displayName(e.model_id)),
        datasets: [{
          label: 'Deterministic Score',
          data: baselineEntries.map(e => e.avg_score),
          backgroundColor: WARN,
          borderRadius: 8,
          borderSkipped: false,
          maxBarThickness: 22,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: {
          x: { min: 0, max: 100, grid: { color: isDark ? 'rgba(255,255,255,0.05)' : '#f0f0f3' } },
          y: { grid: { display: false }, ticks: { font: { weight: '500' } } }
        }
      }
    });
  }
})();
} catch(e) {
  console.error('evalsec dashboard init error:', e);
}
</script>

</body>
</html>
