<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">
  <meta name="theme-color" content="#ffffff">

  <meta property="og:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta property="og:description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://evalsec.farhan.ngenz.org">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta name="twitter:description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">

  <title>evalsec — DevSecOps LLM Benchmark</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="./chart.umd.min.js"></script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ─────────────────────────────────────────────
       THEME — Light mode (default)
       ───────────────────────────────────────────── */
    :root {
      color-scheme: light;

      /* Surface — pure white */
      --background: #FFFFFF;
      --foreground: #000000;
      --muted-foreground: #6B7280;
      --border: rgba(0, 0, 0, 0.10);

      /* Primary — pure black */
      --primary: #000000;
      --primary-hover: #1F1F1F;
      --primary-border-hover: #000000;
      --primary-foreground: #FFFFFF;

      /* Secondary — neutral surface */
      --secondary: rgba(0, 0, 0, 0.04);
      --secondary-hover: #F5F5F5;
      --secondary-border-hover: #000000;
      --secondary-foreground: #000000;

      /* Cards */
      --card: rgba(255, 255, 255, 0.70);
      --card-strong: rgba(255, 255, 255, 0.92);

      /* Grid */
      --grid: rgba(0, 0, 0, 0.85);

      /* Shadows — neutral */
      --shadow-primary: rgba(0, 0, 0, 0.25);
      --shadow-secondary: rgba(0, 0, 0, 0.15);

      /* Semantic status colors — preserved (used by charts/badges) */
      --success: #22C55E;
      --warning: #f59e0b;
      --danger:  #EF4444;
      --info:    #6B7280;

      --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --font-mono: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;

      --radius-sm: 8px;
      --radius: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
    }

    /* ─────────────────────────────────────────────
       THEME — Dark mode
       ───────────────────────────────────────────── */
    html.dark {
      color-scheme: dark;

      /* Surface — pure black */
      --background: #000000;
      --foreground: #FFFFFF;
      --muted-foreground: #A1A1AA;
      --border: rgba(255, 255, 255, 0.12);

      /* Primary — pure white */
      --primary: #FFFFFF;
      --primary-hover: #E5E5E5;
      --primary-border-hover: #FFFFFF;
      --primary-foreground: #000000;

      /* Secondary */
      --secondary: rgba(255, 255, 255, 0.06);
      --secondary-hover: #1A1A1A;
      --secondary-border-hover: #FFFFFF;
      --secondary-foreground: #FFFFFF;

      /* Cards */
      --card: rgba(20, 20, 20, 0.70);
      --card-strong: rgba(20, 20, 20, 0.92);

      /* Grid */
      --grid: rgba(255, 255, 255, 0.85);

      /* Shadows */
      --shadow-primary: rgba(255, 255, 255, 0.15);
      --shadow-secondary: rgba(255, 255, 255, 0.08);
    }

    /* ─────────────────────────────────────────────
       BASE
       ───────────────────────────────────────────── */
    html {
      background: var(--background);
      scroll-behavior: smooth;
    }

    html, body {
      color: var(--foreground);
      font-family: var(--font-sans);
      font-feature-settings: "ss01", "cv11";
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      min-height: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--background);
      /* overflow-clip is cheaper than hidden — no scroll container created */
      overflow-x: clip;
    }

    a {
      color: var(--primary);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    a:hover { color: var(--primary-hover); }

    ::selection {
      background: rgba(128, 128, 128, 0.30);
      color: var(--foreground);
    }
    ::-moz-selection {
      background: rgba(128, 128, 128, 0.30);
      color: var(--foreground);
    }

    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: rgba(128, 128, 128, 0.35);
      border-radius: 999px;
      border: 2px solid transparent;
      background-clip: padding-box;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(128, 128, 128, 0.55); background-clip: padding-box; }
    html { scrollbar-color: rgba(128, 128, 128, 0.35) transparent; scrollbar-width: thin; }

    :focus { outline: none; }
    :focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
      border-radius: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* ─────────────────────────────────────────────
       SITE BACKGROUND — Infinite SVG Grid + Orbs
       ───────────────────────────────────────────── */
    .site-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      overflow: hidden;
      background: var(--background);
      pointer-events: none;
      /* Force a GPU layer so background never repaints during scroll */
      transform: translateZ(0);
      will-change: transform;
    }

    .grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      color: var(--grid);
      pointer-events: none;
      display: block;
    }

    .grid-base {
      opacity: 0.08;
    }

    .grid-spotlight {
      opacity: 0.35;
      mask-image: radial-gradient(
        320px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        black 0%,
        transparent 80%
      );
      -webkit-mask-image: radial-gradient(
        320px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        black 0%,
        transparent 80%
      );
      will-change: mask-image;
    }

    html.dark .grid-base {
      opacity: 0.10;
    }

    html.dark .grid-spotlight {
      opacity: 0.40;
    }

    /* ─────────────────────────────────────────────
       THEME TOGGLE
       ───────────────────────────────────────────── */
    .theme-toggle {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 50;
      width: 48px;
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: color-mix(in srgb, var(--background) 50%, transparent);
      color: var(--foreground);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.16);
      backdrop-filter: blur(12px);
      cursor: pointer;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
    }

    .theme-toggle:hover {
      transform: scale(1.10);
    }

    .theme-toggle:active {
      transform: scale(0.95);
    }

    .theme-icon {
      position: absolute;
      font-size: 1.25rem;
      line-height: 1;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .moon-icon {
      color: var(--foreground);
      opacity: 1;
    }

    .sun-icon {
      color: #eab308;
      opacity: 0;
      transform: rotate(-45deg);
    }

    html.dark .moon-icon {
      opacity: 0;
      transform: rotate(12deg);
    }

    html.dark .sun-icon {
      opacity: 1;
      transform: rotate(0deg);
    }

    html.dark .theme-toggle:hover .sun-icon {
      transform: rotate(45deg);
    }

    /* ─────────────────────────────────────────────
       NAVBAR
       ───────────────────────────────────────────── */
    .navbar {
      position: sticky;
      top: 1rem;
      z-index: 40;
      width: min(1120px, calc(100% - 2rem));
      margin: 1rem auto 0;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1rem;
      padding: 0.65rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: color-mix(in srgb, var(--background) 64%, transparent);
      backdrop-filter: blur(16px);
      box-shadow: 0 20px 50px rgba(0,0,0,0.12);
    }

    .brand {
      padding-left: 0.75rem;
      color: var(--foreground);
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.04em;
      text-decoration: none;
    }

    .nav-tabs {
      display: flex;
      justify-content: center;
      gap: 0.25rem;
    }

    .nav-tab {
      border: 1px solid transparent;
      border-radius: 999px;
      padding: 0.55rem 0.9rem;
      background: transparent;
      color: var(--muted-foreground);
      font: 600 0.875rem/1 var(--font-sans);
      cursor: pointer;
      transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease;
    }

    .nav-tab:hover {
      color: var(--foreground);
      background: var(--secondary);
      transform: translateY(-1px);
    }

    .nav-tab.is-active {
      color: var(--primary-foreground);
      background: var(--primary);
      border-color: var(--primary-border-hover);
      box-shadow: 0 16px 36px -18px var(--shadow-primary);
    }

    @media (max-width: 720px) {
      .navbar {
        top: 0.75rem;
        grid-template-columns: 1fr auto;
        border-radius: 24px;
      }

      .nav-tabs {
        grid-column: 1 / -1;
        justify-content: flex-start;
        overflow-x: auto;
        padding: 0.25rem;
      }

      .nav-tab {
        white-space: nowrap;
      }
    }

    /* ─────────────────────────────────────────────
       TAB PANELS
       ───────────────────────────────────────────── */
    .tab-panel {
      display: none;
      opacity: 0;
    }

    /* Animation lives on .is-active so it actually replays on each
       tab switch instead of running once against a display:none node. */
    .tab-panel.is-active {
      display: block;
      animation: panelIn 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes panelIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ─────────────────────────────────────────────
       BUTTONS
       ───────────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 44px;
      padding: 0.75rem 1.35rem;
      border-radius: 0.5rem;
      border: 2px solid transparent;
      font-weight: 650;
      text-decoration: none;
      cursor: pointer;
      transition:
        transform 180ms cubic-bezier(.2,.8,.2,1),
        background 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .btn:hover {
      transform: translateY(-4px) scale(1.05);
    }

    .btn:active {
      transform: translateY(0) scale(0.98);
    }

    .btn-primary {
      background: var(--primary);
      color: var(--primary-foreground);
      border: 1px solid var(--primary);
      border-radius: 10px;
      padding: 12px 24px;
      font-weight: 600;
      transition: all 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-primary:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 10px 30px -10px var(--shadow-primary);
    }

    .btn-secondary {
      background: transparent;
      color: var(--foreground);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 24px;
      font-weight: 600;
      transition: all 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-secondary:hover {
      border-color: var(--foreground);
      background: var(--secondary);
      transform: translateY(-1px);
    }

    /* ─────────────────────────────────────────────
       LAYOUT
       ───────────────────────────────────────────── */
    .app-shell {
      width: min(1120px, calc(100% - 2rem));
      margin: 0 auto;
      padding: clamp(3rem, 8vw, 6rem) 0 4rem;
    }

    .hero {
      min-height: calc(100vh - 120px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 6rem 0 4rem;
    }

    .stack-lg {
      display: grid;
      gap: 1.5rem;
    }

    .section-title {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 650;
      letter-spacing: -0.055em;
      text-align: center;
      margin-bottom: 0.6rem;
    }

    .section-sub {
      text-align: center;
      color: var(--muted-foreground);
      font-size: 1rem;
      max-width: 36rem;
      margin: 0 auto 2rem;
    }

    .muted {
      color: var(--muted-foreground);
    }

    .mono {
      font-family: var(--font-mono);
    }

    /* ─────────────────────────────────────────────
       HERO
       ───────────────────────────────────────────── */
    .hero-title {
      font-size: clamp(3.5rem, 10vw, 7rem);
      font-weight: 700;
      letter-spacing: -0.075em;
      line-height: 0.92;
      margin-bottom: 1.1rem;
    }

    .hero-subtitle {
      font-size: clamp(1.05rem, 2vw, 1.3rem);
      color: var(--muted-foreground);
      font-weight: 500;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }

    .hero-desc {
      font-size: 1.02rem;
      color: var(--muted-foreground);
      max-width: 44rem;
      margin: 0 auto;
    }

    .beta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.42rem 0.95rem;
      background: var(--secondary);
      color: var(--primary);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 1.75rem;
      backdrop-filter: blur(8px);
    }

    .pulse-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--primary);
      box-shadow: 0 0 0 0 var(--primary);
      animation: pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(128, 128, 128, 0.50); }
      70%  { box-shadow: 0 0 0 9px rgba(128, 128, 128, 0); }
      100% { box-shadow: 0 0 0 0 rgba(128, 128, 128, 0); }
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-top: 2.25rem;
    }

    .meta-pills {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 2.25rem;
    }

    .meta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.42rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted-foreground);
      background: var(--card);
      backdrop-filter: blur(10px);
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .meta-pill:hover {
      border-color: var(--primary-border-hover);
      color: var(--foreground);
    }

    .meta-pill svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    /* ─────────────────────────────────────────────
       CARD
       ───────────────────────────────────────────── */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      backdrop-filter: blur(12px);
      transition: border-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
                  transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .card:hover {
      border-color: var(--foreground);
      transform: translateY(-1px);
    }

    .card-strong {
      background: var(--card-strong);
    }

    .metric-card {
      padding: 1.25rem;
    }

    .metric-value {
      font-size: clamp(2rem, 5vw, 3.75rem);
      font-weight: 650;
      letter-spacing: -0.06em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      color: var(--foreground);
    }

    .metric-label {
      margin-top: 0.75rem;
      color: var(--muted-foreground);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    /* ─────────────────────────────────────────────
       STATS GRID
       ───────────────────────────────────────────── */
    .stats-section { margin-bottom: 6rem; }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    @media (max-width: 900px) {
      .metrics-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 520px) {
      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }

    .stat {
      cursor: default;
    }

    /* ─────────────────────────────────────────────
       LEADERBOARD TABLE
       ───────────────────────────────────────────── */
    .leaderboard-section { margin-bottom: 5rem; }

    .leaderboard {
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: var(--card);
      backdrop-filter: blur(16px);
    }

    .lb-header {
      padding: 1.6rem 1.75rem 1rem;
      border-bottom: 1px solid var(--border);
    }

    .lb-header h2 {
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--foreground);
    }

    .lb-note {
      font-size: 0.8rem;
      color: var(--muted-foreground);
      margin-top: 0.35rem;
    }

    .lb-wrap { overflow-x: auto; }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      text-align: left;
      padding: 0.95rem 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    thead th:first-child { padding-left: 1.75rem; }
    thead th:last-child  { padding-right: 1.75rem; }

    tbody td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
      color: var(--foreground);
      font-variant-numeric: tabular-nums;
    }
    tbody td:first-child { padding-left: 1.75rem; }
    tbody td:last-child  { padding-right: 1.75rem; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr {
      cursor: pointer;
      transition: background 0.2s ease;
    }
    tbody tr:hover { background: rgba(128, 128, 128, 0.04); }

    .rank-cell { width: 4rem; }

    .rank-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 500;
      color: var(--muted-foreground);
      background: var(--secondary);
      border: 1px solid var(--border);
      font-variant-numeric: tabular-nums;
    }

    .rank-pill.rank-1 {
      color: #ffffff;
      background: var(--primary);
      border-color: var(--primary-border-hover);
      box-shadow: 0 0 16px -2px rgba(128, 128, 128, 0.35);
    }

    .rank-pill.rank-2 {
      color: var(--foreground);
      border-color: rgba(160, 160, 160, 0.30);
      background: linear-gradient(135deg, rgba(160, 160, 160, 0.12) 0%, rgba(160, 160, 160, 0.03) 100%);
    }

    .rank-pill.rank-3 {
      color: var(--primary);
      border-color: rgba(160, 160, 160, 0.30);
      background: linear-gradient(135deg, rgba(160, 160, 160, 0.10) 0%, rgba(160, 160, 160, 0.03) 100%);
    }

    .model-name-cell {
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--foreground);
    }

    .model-id-mono {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--muted-foreground);
      font-weight: 400;
      display: block;
      margin-top: 0.28rem;
    }

    .score-cell {
      font-family: var(--font-mono);
      font-weight: 500;
      color: var(--foreground);
    }

    .score-bar-wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
    }

    .score-bar {
      display: inline-block;
      height: 5px;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--primary-hover), var(--primary));
      max-width: 70px;
    }

    .cost-cell {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--muted-foreground);
    }

    .trunc-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.42rem;
      padding: 0.22rem 0.65rem 0.22rem 0.55rem;
      background: rgba(128, 128, 128, 0.10);
      color: var(--primary);
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border-radius: 999px;
      margin-left: 0.55rem;
      border: 1px solid rgba(128, 128, 128, 0.30);
      white-space: nowrap;
      vertical-align: middle;
    }

    .trunc-badge::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--primary);
      flex-shrink: 0;
    }

    .trunc-note {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--primary);
      margin-top: 0.5rem;
      max-width: 32ch;
      opacity: 0.85;
    }

    th.has-tooltip {
      cursor: help;
      text-decoration: underline dotted;
      text-decoration-color: var(--muted-foreground);
      text-underline-offset: 4px;
    }

    /* ─────────────────────────────────────────────
       BASELINE
       ───────────────────────────────────────────── */
    .divider {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin: 2.5rem 0 1.85rem;
    }

    .divider::before, .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }

    .divider span {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.42rem 0.95rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted-foreground);
      background: var(--secondary);
      border: 1px solid var(--border);
      border-radius: 999px;
    }

    /* ─────────────────────────────────────────────
       CHARTS
       ───────────────────────────────────────────── */
    .charts-section { margin-bottom: 4.5rem; }

    .charts-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 0.65rem;
      background: var(--card);
      backdrop-filter: blur(16px);
      overflow: hidden;
    }

    .charts-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem;
    }

    @media (max-width: 900px) {
      .charts-inner { grid-template-columns: 1fr; }
    }

    .chart-card {
      background: var(--card-strong);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.45rem 1.5rem 1.2rem;
    }

    .chart-card h3 {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 500;
      color: var(--muted-foreground);
      margin-bottom: 0.35rem;
    }

    .chart-sub {
      font-size: 0.78rem;
      color: var(--muted-foreground);
      margin-bottom: 1.15rem;
    }

    .chart-card canvas { max-height: 340px; }

    .chart-fallback {
      display: none;
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--muted-foreground);
      font-size: 0.85rem;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
    }
    .chart-fallback.visible { display: block; }

    .baseline-chart-frame .charts-inner {
      grid-template-columns: 1fr;
    }
    .baseline-chart-frame canvas { max-height: 240px; }

    /* ─────────────────────────────────────────────
       DISCLAIMER
       ───────────────────────────────────────────── */
    .disclaimer {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: rgba(128, 128, 128, 0.08);
      border: 1px solid rgba(128, 128, 128, 0.25);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.35rem;
      margin-bottom: 1.5rem;
    }

    .disclaimer.is-dismissed { display: none; }

    .disclaimer-icon {
      width: 30px; height: 30px;
      border-radius: 50%;
      background: rgba(128, 128, 128, 0.16);
      color: var(--primary);
      border: 1px solid rgba(128, 128, 128, 0.35);
      font-family: var(--font-mono);
      font-size: 0.92rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .disclaimer-body {
      flex: 1;
      color: var(--foreground);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .disclaimer-body strong { color: var(--primary); }

    .disclaimer-close {
      background: transparent;
      border: none;
      color: var(--muted-foreground);
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      padding: 0 0.35rem;
      font-family: inherit;
      transition: color 0.2s ease;
    }
    .disclaimer-close:hover { color: var(--foreground); }

    /* ─────────────────────────────────────────────
       MODEL CHIPS
       ───────────────────────────────────────────── */
    .model-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: 2rem;
    }

    .chip {
      padding: 0.6rem 1.15rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--card);
      color: var(--muted-foreground);
      font-family: var(--font-sans);
      font-size: 0.84rem;
      font-weight: 500;
      cursor: pointer;
      backdrop-filter: blur(10px);
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .chip:hover {
      border-color: var(--primary-border-hover);
      color: var(--foreground);
    }

    .chip.is-active {
      color: var(--primary-foreground);
      background: var(--primary);
      border-color: var(--primary-border-hover);
      box-shadow: 0 16px 36px -18px var(--shadow-primary);
    }

    .model-panel {
      display: none;
    }

    .model-panel.is-active {
      display: block;
      animation: panelIn 220ms ease both;
    }

    /* ─────────────────────────────────────────────
       MODEL CARD (drill-down)
       ───────────────────────────────────────────── */
    .model-card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 1.65rem;
      backdrop-filter: blur(16px);
      transition: border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
      overflow: hidden;
      max-width: 600px;
      margin: 0 auto;
    }

    .model-card:hover {
      border-color: var(--primary-border-hover);
      transform: translateY(-2px);
    }

    .model-card--baseline {
      border-color: rgba(128, 128, 128, 0.25);
    }

    .model-card--baseline:hover {
      border-color: rgba(128, 128, 128, 0.50);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 1.4rem;
      flex-wrap: wrap;
    }

    .card-header .rank-pill { flex-shrink: 0; }

    .model-name {
      flex: 1;
      min-width: 0;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--foreground);
    }

    .type-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.22rem 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 500;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      flex-shrink: 0;
    }

    .type-llm {
      background: rgba(128, 128, 128, 0.10);
      color: var(--primary);
      border: 1px solid rgba(128, 128, 128, 0.30);
    }

    .type-baseline {
      background: rgba(128, 128, 128, 0.12);
      color: var(--muted-foreground);
      border: 1px solid rgba(128, 128, 128, 0.34);
    }

    .card-score { text-align: center; margin-bottom: 1.4rem; }

    .score-value {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: clamp(2.4rem, 3.5vw, 2.85rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      color: var(--foreground);
    }

    .score-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
      margin-top: 0.55rem;
      font-weight: 500;
    }

    .card-dims {
      width: 100%;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }

    .card-dims caption {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
      margin-bottom: 0.65rem;
      text-align: left;
      font-weight: 500;
    }

    .card-dims thead { display: none; }

    .card-dims th, .card-dims td {
      padding: 0.42rem 0;
      border: none;
    }

    .card-dims th {
      color: var(--muted-foreground);
      font-weight: 400;
      width: 50%;
      text-align: left;
      font-size: 0.82rem;
      text-transform: capitalize;
    }

    .bar-wrapper {
      position: relative;
      height: 1.1rem;
      background: var(--secondary);
      border-radius: 999px;
      overflow: hidden;
    }

    .bar-fill {
      position: absolute;
      top: 0; left: 0;
      height: 100%;
      background: linear-gradient(90deg, var(--primary-hover), var(--primary));
      border-radius: 999px;
      transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .bar-label {
      position: relative;
      display: block;
      padding: 0 0.55rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 400;
      line-height: 1.1rem;
      white-space: nowrap;
      color: var(--foreground);
    }

    .card-cost {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }

    .cost-label {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
    }

    .cost-value {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--foreground);
      font-variant-numeric: tabular-nums;
    }

    /* ─────────────────────────────────────────────
       METHODOLOGY ACCORDION
       ───────────────────────────────────────────── */
    .method-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 0.55rem;
      background: var(--card);
      backdrop-filter: blur(16px);
    }

    .method-inner {
      background: var(--card-strong);
      border-radius: calc(var(--radius-xl) - 5px);
      padding: 2rem clamp(1.25rem, 4vw, 3rem);
    }

    .method-panel h3 {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
      color: var(--foreground);
    }

    .method-panel p {
      color: var(--foreground);
      font-size: 0.95rem;
      max-width: 60ch;
      margin-bottom: 0.65rem;
    }

    .method-panel p:last-child { margin-bottom: 0; }

    .method-panel ul {
      list-style: none;
      padding: 0;
      color: var(--foreground);
      font-size: 0.93rem;
    }

    .method-panel ul > li {
      padding-left: 1.15rem;
      position: relative;
      margin-bottom: 0.5rem;
    }

    .method-panel ul > li::before {
      content: "—";
      position: absolute; left: 0;
      color: var(--primary);
    }

    .method-panel ul ul {
      margin-top: 0.4rem;
      margin-left: 0.4rem;
      font-size: 0.88rem;
    }

    .method-panel ul ul > li::before { content: "·"; color: var(--muted-foreground); }

    .method-panel strong { color: var(--foreground); font-weight: 600; }

    .method-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .method-tab {
      padding: 0.55rem 1.2rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--card);
      color: var(--muted-foreground);
      font-family: var(--font-sans);
      font-size: 0.84rem;
      font-weight: 500;
      cursor: pointer;
      backdrop-filter: blur(10px);
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .method-tab:hover {
      border-color: var(--primary-border-hover);
      color: var(--foreground);
    }

    .method-tab.selected,
    .method-tab[aria-selected="true"] {
      color: var(--primary-foreground);
      background: var(--primary);
      border-color: var(--primary-border-hover);
      box-shadow: 0 16px 36px -18px var(--shadow-primary);
    }

    .method-panel { display: none; }
    .method-panel.active { display: block; animation: fadeIn 0.3s ease; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ─────────────────────────────────────────────
       MINI LEADERBOARD (Overview tab)
       ───────────────────────────────────────────── */
    .mini-lb { margin-bottom: 2rem; }

    .mini-lb-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border);
    }

    .mini-lb-item:last-child { border-bottom: none; }

    .mini-lb-rank {
      width: 2rem;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--muted-foreground);
    }

    .mini-lb-name {
      flex: 1;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--foreground);
    }

    .mini-lb-score {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--foreground);
    }

    /* ─────────────────────────────────────────────
       FOOTER
       ───────────────────────────────────────────── */
    footer {
      margin-top: 5rem;
      padding: 3rem 0 2.5rem;
      text-align: center;
      color: var(--muted-foreground);
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }

    footer::before {
      content: "";
      display: block;
      width: 80%;
      margin: 0 auto 2rem;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }

    .footer-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.6rem;
      justify-content: center;
      align-items: center;
    }

    .footer-cell { white-space: nowrap; }

    .footer-cell a { color: var(--muted-foreground); }
    .footer-cell a:hover { color: var(--primary); }

    .footer-value {
      color: var(--foreground);
      font-family: var(--font-mono);
      font-size: 0.76rem;
    }

    .footer-mark {
      margin-top: 1.6rem;
      font-size: 0.68rem;
      color: var(--muted-foreground);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* ─────────────────────────────────────────────
       SCROLL REVEAL
       ───────────────────────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--reveal-delay, 0ms);
      will-change: opacity, transform;
    }

    .reveal.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
</head>
<body>

  <!-- ── Site Background: Infinite SVG Grid + Spotlight + Orbs ── -->
  <div class="site-bg" aria-hidden="true">
    <svg class="grid grid-base" aria-hidden="true"
         width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="gridPatternBase" width="40" height="40" patternUnits="userSpaceOnUse" x="0" y="0">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#gridPatternBase)"></rect>
    </svg>

    <svg class="grid grid-spotlight" aria-hidden="true"
         width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="gridPatternSpotlight" width="40" height="40" patternUnits="userSpaceOnUse" x="0" y="0">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#gridPatternSpotlight)"></rect>
    </svg>

  </div>

  <!-- ── Theme Toggle ── -->
  <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
    <span class="theme-icon moon-icon">☾</span>
    <span class="theme-icon sun-icon">☀</span>
  </button>

  <!-- ── Navbar ── -->
  <header class="navbar">
    <a class="brand" href="#">evalsec.</a>

    <nav class="nav-tabs" aria-label="Primary navigation">
      <button class="nav-tab is-active" data-tab="overview">Overview</button>
      <button class="nav-tab" data-tab="leaderboard">Leaderboard</button>
      <button class="nav-tab" data-tab="models">Models</button>
      <button class="nav-tab" data-tab="methodology">Methodology</button>
    </nav>

    <!-- Spacer to push theme toggle to right edge of navbar on desktop;
         on mobile the theme-toggle is fixed position so this doesn't matter -->
    <div></div>
  </header>

  <!-- ── Main Content ── -->
  <main class="app-shell">

    <!-- ════════════════════════════════════════
         TAB 1: OVERVIEW
         ════════════════════════════════════════ -->
    <section id="overview" class="tab-panel is-active">

      <div class="hero">
        <span class="beta-pill">
          <span class="pulse-dot"></span>
          BETA · v0.1.0
        </span>

        <h1 class="hero-title">evalsec.</h1>
        <p class="hero-subtitle">DevSecOps LLM Benchmark</p>
        <p class="hero-desc">
          Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#" data-tab-link="leaderboard">View Leaderboard</a>
          <a class="btn btn-secondary" href="#" data-tab-link="methodology">Read Methodology</a>
        </div>

        <div class="meta-pills">
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            {{ graded_at }}
          </span>
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            task: {{ task }}
          </span>
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
            judge: Claude Opus 4.7
          </span>
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            {{ response_count }} responses
          </span>
        </div>
      </div>

      <!-- ── Stats ── -->
      <section class="stats-section">
        <div class="metrics-grid">
          <div class="stat card metric-card">
            <div class="metric-value" id="stat-models">—</div>
            <span class="metric-label">Models tested</span>
          </div>
          <div class="stat card metric-card">
            <div class="metric-value" id="stat-cases">—</div>
            <span class="metric-label">Cases evaluated</span>
          </div>
          <div class="stat card metric-card">
            <div class="metric-value" id="stat-top-score">—</div>
            <span class="metric-label">Top score</span>
          </div>
          <div class="stat card metric-card">
            <div class="metric-value" id="stat-best-value">—</div>
            <span class="metric-label">Best value</span>
          </div>
        </div>
      </section>

      <!-- ── Mini Leaderboard (Top 3) ── -->
      {% set llm_entries = leaderboard | selectattr("model_type", "equalto", "llm") | list %}
      {% set top3 = llm_entries[:3] %}
      {% if top3 %}
      <section class="reveal">
        <h2 class="section-title">Leaderboard at a glance</h2>
        <p class="section-sub">Top 3 performing models so far.</p>
        <div class="card card-strong mini-lb">
          {% for entry in top3 %}
          <div class="mini-lb-item">
            <span class="mini-lb-rank">#{{ loop.index }}</span>
            <span class="mini-lb-name">{{ entry.model_id }}</span>
            <span class="mini-lb-score">{{ "%.1f"|format(entry.avg_score) }}</span>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

    </section>

    <!-- ════════════════════════════════════════
         TAB 2: LEADERBOARD
         ════════════════════════════════════════ -->
    <section id="leaderboard" class="tab-panel">

      <!-- ── Charts ── -->
      <section class="charts-section reveal">
        <h2 class="section-title">The leaderboard at a glance</h2>
        <p class="section-sub">Composite scores and per-dimension strengths across all evaluated LLMs.</p>

        <div class="charts-frame">
          <div class="charts-inner">
            <div class="chart-card">
              <h3>Composite Score</h3>
              <div class="chart-sub">Higher is better · 0–100 scale</div>
              <canvas id="barChart"></canvas>
              <div class="chart-fallback" id="barChartFallback">
                Chart requires Chart.js — check browser console for details.
              </div>
            </div>
            <div class="chart-card">
              <h3>Per-Dimension Radar</h3>
              <div class="chart-sub">Strengths across rubric dimensions</div>
              <canvas id="radarChart"></canvas>
              <div class="chart-fallback" id="radarChartFallback">
                Chart requires Chart.js — check browser console for details.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── LLM Leaderboard ── -->
      <section class="leaderboard-section reveal">
        <aside class="disclaimer" id="prelimDisclaimer">
          <div class="disclaimer-icon" aria-hidden="true">!</div>
          <div class="disclaimer-body">
            <strong>Preliminary results</strong> — based on
            <strong><span id="disclaimer-cases">1</span> of 17</strong>
            test cases. Final rankings may shift significantly with the full benchmark.
            Full results coming soon.
          </div>
          <button class="disclaimer-close" type="button" aria-label="Dismiss notice" id="dismissDisclaimer">×</button>
        </aside>

        <div class="leaderboard">
          <div class="lb-header">
            <h2>LLM Rankings</h2>
            <div class="lb-note">Scored by Claude Opus 4.7 across rubric dimensions, normalized to 0–100.</div>
          </div>
          <div class="lb-wrap">
            <table>
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Model</th>
                  <th>Score</th>
                  <th class="has-tooltip" title="Does the model use stack context to determine real exploitability vs just relying on CVSS scores?">Reachability</th>
                  <th class="has-tooltip" title="Does the model rank findings by correct urgency (critical first, deferrable last)?">Prioritization</th>
                  <th class="has-tooltip" title="Are recommendations specific and executable, with concrete commands or patch versions?">Actionability</th>
                  <th class="has-tooltip" title="Is the response focused without preamble or padding, under target length?">Conciseness</th>
                  <th>Cost</th>
                </tr>
              </thead>
              <tbody>
                {% for entry in llm_entries %}
                {% set ns = namespace(truncated=false) %}
                {% for d in (entry.details or []) %}
                  {% if d.score is mapping and d.score.get('validation', {}).get('parse_error') %}
                    {% set ns.truncated = true %}
                  {% endif %}
                {% endfor %}
                {% set is_truncated = ns.truncated %}
                {% set reach = entry.dimension_scores.get("reachability_reasoning", 0) %}
                {% set prio  = entry.dimension_scores.get("prioritization", 0) %}
                {% set act   = entry.dimension_scores.get("actionability", 0) %}
                {% set conc  = entry.dimension_scores.get("conciseness", 0) %}
                <tr data-model-id="{{ entry.model_id }}">
                  <td class="rank-cell">
                    <span class="rank-pill rank-{{ loop.index if loop.index <= 3 else 'n' }}">{{ loop.index }}</span>
                  </td>
                  <td class="model-name-cell">
                    <span class="model-display-name" data-id="{{ entry.model_id }}">{{ entry.model_id }}</span>
                    {% if is_truncated %}<span class="trunc-badge" title="Response exceeded max_tokens — JSON truncated. Score reflects partial output only.">Truncated</span>{% endif %}
                    <span class="model-id-mono">{{ entry.model_id }}</span>
                    {% if is_truncated %}
                    <div class="trunc-note">Response exceeded max_tokens — JSON truncated. Score reflects partial output only.</div>
                    {% endif %}
                  </td>
                  <td class="score-cell">
                    <div class="score-bar-wrap">
                      <span class="score-bar" style="width: {{ entry.avg_score * 0.7 }}px;"></span>
                      {{ "%.1f"|format(entry.avg_score) }}
                    </div>
                  </td>
                  <td>{{ "%.1f"|format(reach) }}</td>
                  <td>{{ "%.1f"|format(prio) }}</td>
                  <td>{{ "%.1f"|format(act) }}</td>
                  <td>{{ "%.1f"|format(conc) }}</td>
                  <td class="cost-cell">${{ "%.4f"|format(entry.total_cost) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ── Baseline Section ── -->
      {% set baselines = leaderboard | selectattr("model_type", "equalto", "baseline") | list %}
      {% if baselines %}
      <section class="reveal">
        <div class="divider"><span>Baseline methods · no AI reasoning</span></div>

        <div class="charts-frame baseline-chart-frame">
          <div class="charts-inner">
            <div class="chart-card">
              <h3>Baseline Scores</h3>
              <div class="chart-sub">Deterministic methods · for reference only, not directly comparable to LLMs</div>
              <canvas id="baselineBarChart"></canvas>
              <div class="chart-fallback" id="baselineBarChartFallback">
                Chart requires Chart.js — check browser console for details.
              </div>
            </div>
          </div>
        </div>

        <div class="leaderboard" style="margin-top: 1.5rem;">
          <div class="lb-header">
            <h2>Baseline Comparison</h2>
            <div class="lb-note">Baselines use deterministic scoring only (no LLM judge pass). Scores are not directly comparable to LLMs.</div>
          </div>
          <div class="lb-wrap">
            <table>
              <thead>
                <tr>
                  <th>Model</th>
                  <th>Score</th>
                  <th class="has-tooltip" title="How accurate were verdicts (exploitable/not exploitable/partial) vs ground truth?">Verdict Accuracy</th>
                  <th class="has-tooltip" title="How accurate was the priority ordering vs ground truth?">Priority Accuracy</th>
                </tr>
              </thead>
              <tbody>
                {% for entry in baselines %}
                <tr data-model-id="{{ entry.model_id }}">
                  <td class="model-name-cell">
                    <span class="model-display-name" data-id="{{ entry.model_id }}">{{ entry.model_id }}</span>
                    <span class="model-id-mono">{{ entry.model_id }}</span>
                  </td>
                  <td class="score-cell">
                    <div class="score-bar-wrap">
                      <span class="score-bar" style="width: {{ entry.avg_score * 0.7 }}px;"></span>
                      {{ "%.1f"|format(entry.avg_score) }}
                    </div>
                  </td>
                  <td>{{ "%.1f"|format(entry.avg_verdict) }}</td>
                  <td>{{ "%.1f"|format(entry.avg_priority) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </section>
      {% endif %}

    </section>

    <!-- ════════════════════════════════════════
         TAB 3: MODELS
         ════════════════════════════════════════ -->
    <section id="models" class="tab-panel">
      <h2 class="section-title">Drill-down per model</h2>
      <p class="section-sub">Full per-dimension breakdown for every evaluated model. Select a model below.</p>

      <div class="model-chips">
        {% for entry in leaderboard %}
        <button class="chip {% if loop.first %}is-active{% endif %}" data-model="{{ entry.model_id }}">
          {{ entry.model_id }}
        </button>
        {% endfor %}
      </div>

      <div class="model-panels">
        {% for entry in leaderboard %}
        <div class="model-panel {% if loop.first %}is-active{% endif %}" data-model-panel="{{ entry.model_id }}">
          {% include "card.html.j2" %}
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- ════════════════════════════════════════
         TAB 4: METHODOLOGY
         ════════════════════════════════════════ -->
    <section id="methodology" class="tab-panel">
      <h2 class="section-title">How this benchmark works</h2>
      <p class="section-sub">Three reasons why evalsec scores differently from CVSS-only triage.</p>

      <div class="method-frame">
        <div class="method-inner">
          <div class="method-tabs" role="tablist" aria-label="Methodology sections">
            <button class="method-tab selected" type="button" data-tab="what" role="tab" aria-selected="true" aria-controls="panel-what">What We Test</button>
            <button class="method-tab" type="button" data-tab="how" role="tab" aria-selected="false" aria-controls="panel-how">How We Score</button>
            <button class="method-tab" type="button" data-tab="why" role="tab" aria-selected="false" aria-controls="panel-why">Why It Matters</button>
          </div>
          <div class="method-panel active" data-panel="what">
            <h3>What We Test</h3>
            <p>
              Each test case contains a real Trivy vulnerability scan output from a popular
              container image (nginx, redis, postgres, etc.) plus a realistic Kubernetes/EKS
              deployment context. Models must triage the findings by determining real
              <strong>exploitability</strong> — not just CVSS score.
            </p>
          </div>

          <div class="method-panel" data-panel="how">
            <h3>How We Score</h3>
            <p>Each response goes through two passes:</p>
            <ul>
              <li>
                <strong>Pass 1 — deterministic (20%)</strong> · regex matches, JSON validity,
                CVE coverage, format compliance.
              </li>
              <li>
                <strong>Pass 2 — LLM judge (80%)</strong> · Claude Opus 4.7 scores responses
                on four rubric dimensions:
                <ul>
                  <li><strong>Reachability</strong> — does the model use deployment context?</li>
                  <li><strong>Prioritization</strong> — correct urgency ranking?</li>
                  <li><strong>Actionability</strong> — specific, executable recommendations?</li>
                  <li><strong>Conciseness</strong> — focused output without padding?</li>
                </ul>
              </li>
            </ul>
          </div>

          <div class="method-panel" data-panel="why">
            <h3>Why It Matters</h3>
            <p>
              Most CVE triage benchmarks score against CVSS alone. <strong>evalsec</strong>
              measures whether LLMs can reason about exploitability in realistic production
              deployments — the actual skill DevSecOps engineers need.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ── Footer ── -->
  <footer>
    <div class="app-shell" style="padding-top: 0; padding-bottom: 0;">
      <div class="footer-row">
        <span class="footer-cell">Last updated: <span class="footer-value">{{ graded_at }}</span></span>
        <span class="footer-cell">Source: <a href="https://github.com/frhnardi/evalsec">github.com/frhnardi/evalsec</a></span>
        <span class="footer-cell"><a href="https://github.com/frhnardi/evalsec/blob/main/docs/methodology.md">Methodology</a></span>
        <span class="footer-cell"><a href="https://github.com/frhnardi/evalsec/blob/main/CONTRIBUTING.md">Contribute</a></span>
        <span class="footer-cell">License: <span class="footer-value">MIT</span></span>
      </div>
      <div class="footer-mark">evalsec. built by Farhan Ardi · for the DevSecOps community.</div>
    </div>
  </footer>

  <script>
  try {
  (function() {
    // ── Theme ──
    const themeToggle = document.getElementById('themeToggle');
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      document.documentElement.classList.add('dark');
    }

    function updateThemeMeta() {
      const meta = document.querySelector('meta[name="theme-color"]');
      const isDark = document.documentElement.classList.contains('dark');
      meta?.setAttribute('content', isDark ? '#000000' : '#ffffff');
    }

    updateThemeMeta();

    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeMeta();
    });

    // ── Tab Switching ──
    const navTabs = document.querySelectorAll('[data-tab]');
    const panels = document.querySelectorAll('.tab-panel');

    function activateTab(tabName) {
      // Batch the DOM read first…
      const targetPanel = document.getElementById(tabName);
      if (!targetPanel) return;

      // …then batch all writes inside one rAF to avoid layout thrashing.
      requestAnimationFrame(() => {
        navTabs.forEach((tab) => {
          tab.classList.toggle('is-active', tab.dataset.tab === tabName);
        });
        panels.forEach((panel) => {
          panel.classList.toggle('is-active', panel.id === tabName);
        });

        history.replaceState(null, '', '#' + tabName);

        // Only scroll if the user isn't already near the top.
        if (window.scrollY > 50) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    navTabs.forEach((tab) => {
      tab.addEventListener('click', () => activateTab(tab.dataset.tab));
    });

    // Handle tab-link buttons in overview (CTA buttons that switch tab)
    document.querySelectorAll('[data-tab-link]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        activateTab(link.dataset.tabLink);
      });
    });

    // Hash-based routing
    const initialTab = location.hash.replace('#', '') || 'overview';
    if (document.getElementById(initialTab)) {
      activateTab(initialTab);
    }

    // ── Model Chip Switching ──
    const modelChips = document.querySelectorAll('[data-model]');
    const modelPanels = document.querySelectorAll('[data-model-panel]');

    modelChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const model = chip.dataset.model;

        modelChips.forEach((item) => {
          item.classList.toggle('is-active', item === chip);
        });

        modelPanels.forEach((panel) => {
          panel.classList.toggle('is-active', panel.dataset.modelPanel === model);
        });
      });
    });

    // ── Infinite Grid Animation ──
    const root = document.documentElement;
    const basePattern = document.getElementById('gridPatternBase');
    const spotlightPattern = document.getElementById('gridPatternSpotlight');

    let gridSize = 40;
    let offsetX = 0;
    let offsetY = 0;
    const speedX = 0.4;  // slightly slower — reads as elegant, not busy
    const speedY = 0.4;
    let rafId = null;
    let isVisible = true;

    function animateGrid() {
      // Keep the loop alive but skip work while the tab is backgrounded.
      if (!isVisible) {
        rafId = requestAnimationFrame(animateGrid);
        return;
      }

      offsetX = (offsetX + speedX) % gridSize;
      offsetY = (offsetY + speedY) % gridSize;

      if (basePattern) {
        basePattern.setAttribute('x', offsetX.toFixed(2));
        basePattern.setAttribute('y', offsetY.toFixed(2));
      }
      if (spotlightPattern) {
        spotlightPattern.setAttribute('x', offsetX.toFixed(2));
        spotlightPattern.setAttribute('y', offsetY.toFixed(2));
      }

      rafId = requestAnimationFrame(animateGrid);
    }

    // Pause grid work when the tab is hidden — cuts idle CPU to ~0.
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
    });

    // Respect prefers-reduced-motion — no grid drift at all.
    const gridReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!gridReducedMotion.matches) {
      animateGrid();
    }

    // ── Mouse Spotlight — rAF-throttled ──
    // pointermove fires 100+×/s; without throttling each fire triggers a
    // CSS recalc on the spotlight mask → main-thread jank during scroll.
    let mouseMoveScheduled = false;
    let pendingMouseX = 0;
    let pendingMouseY = 0;

    window.addEventListener('pointermove', (event) => {
      pendingMouseX = event.clientX;
      pendingMouseY = event.clientY;

      if (!mouseMoveScheduled) {
        mouseMoveScheduled = true;
        requestAnimationFrame(() => {
          root.style.setProperty('--mouse-x', pendingMouseX + 'px');
          root.style.setProperty('--mouse-y', pendingMouseY + 'px');
          mouseMoveScheduled = false;
        });
      }
    }, { passive: true });

    // ── Display Name Maps ──
    const MODEL_DISPLAY = {
      "claude_sonnet_46":      "Claude Sonnet 4.6",
      "kimi_k2_thinking":      "Kimi K2.6 Thinking",
      "qwen_3_5":              "Qwen 3.5",
      "deepseek_v4_pro":       "DeepSeek V4 Pro",
      "claude_opus_47":        "Claude Opus 4.7 (Judge)",
      "baseline_cvss":         "Baseline: CVSS Sort",
      "baseline_trivy":        "Baseline: Trivy Severity",
      "baseline_epss":         "Baseline: EPSS Score",
      "baseline_reachability": "Baseline: Reachability",
    };
    const displayName = id => MODEL_DISPLAY[id] || id;

    const DIM_LABELS = {
      reachability_reasoning: "Reachability",
      prioritization:         "Prioritization",
      actionability:          "Actionability",
      conciseness:            "Conciseness",
      format:                 "Format",
      coverage:               "Coverage",
      verdict:                "Verdict Accuracy",
      priority:               "Priority Order",
    };
    const dimLabel = d => DIM_LABELS[d] || d.replace(/_/g, " ");

    const DIM_TOOLTIPS = {
      reachability_reasoning: "Does the model use stack context to determine real exploitability vs just relying on CVSS scores?",
      prioritization:         "Does the model rank findings by correct urgency (critical first, deferrable last)?",
      actionability:          "Are recommendations specific and executable, with concrete commands or patch versions?",
      conciseness:            "Is the response focused without preamble or padding, under target length?",
      format:                 "Is output valid JSON matching the expected schema?",
      coverage:               "Did the model address all CVEs in the input scan?",
      verdict:                "How accurate were verdicts (exploitable/not exploitable/partial) vs ground truth?",
      priority:               "How accurate was the priority ordering vs ground truth?",
      hall_penalty:           "Penalty for fabricated CVEs not in original scan (lower is better)",
    };
    const DIM_TOOLTIPS_BY_TEXT = {};
    Object.entries(DIM_TOOLTIPS).forEach(([k, v]) => {
      DIM_TOOLTIPS_BY_TEXT[k.replace(/_/g, " ")] = v;
    });
    DIM_TOOLTIPS_BY_TEXT["hall. penalty"] = DIM_TOOLTIPS.hall_penalty;
    DIM_TOOLTIPS_BY_TEXT["regex"]         = "Regex / pattern match score on deterministic Pass 1.";
    DIM_TOOLTIPS_BY_TEXT["cost"]          = "Total API cost for this model across all evaluated cases.";

    // ── Chart.js Theme ──
    const FONT_SANS = 'Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
    const FONT_MONO = '"JetBrains Mono", "SFMono-Regular", Consolas, monospace';

    let chartLoaded = false;
    try {
      Chart.defaults.color       = 'rgba(0, 0, 0, 0.75)';
      Chart.defaults.borderColor = 'rgba(0, 0, 0, 0.06)';
      Chart.defaults.font.family = FONT_SANS;
      Chart.defaults.font.size   = 12;
      chartLoaded = true;
    } catch (_) {
      console.warn('Chart.js failed to load — chart canvas elements will show fallback message.');
      ['barChart', 'radarChart', 'baselineBarChart'].forEach(id => {
        const fb = document.getElementById(id + 'Fallback');
        if (fb) fb.classList.add('visible');
      });
    }

    // Dark mode chart defaults override
    function updateChartTheme() {
      if (!chartLoaded) return;
      const isDark = document.documentElement.classList.contains('dark');
      Chart.defaults.color       = isDark ? 'rgba(255, 255, 255, 0.75)' : 'rgba(0, 0, 0, 0.75)';
      Chart.defaults.borderColor = isDark ? 'rgba(255, 255, 255, 0.06)' : 'rgba(0, 0, 0, 0.06)';
    }
    updateChartTheme();

    // ── Palette — grayscale (pure black & white theme) ──
    // Charts build once at load; the ramp is picked from the initial theme
    // so each series reads against the active background — dark inks on a
    // white page, light inks on a black page.
    const isDarkInit = document.documentElement.classList.contains('dark');
    const INK     = isDarkInit ? '#FFFFFF' : '#0A0A0A';  // foreground extreme
    const INK_HI  = isDarkInit ? '#E2E2E2' : '#2A2A2A';
    const INK_DIM = isDarkInit ? '#B4B4B4' : '#4C4C4C';
    const ASH     = isDarkInit ? '#8C8C8C' : '#7C7C7C';  // mid — reads on both
    const ASH_LO  = isDarkInit ? '#666666' : '#9E9E9E';
    const FOG     = isDarkInit ? '#A6A6A6' : '#5E5E5E';

    // Cycled palette for multi-series charts — spaced grayscale steps.
    const SERIES_PALETTE = [INK, ASH, INK_DIM, ASH_LO, FOG, INK_HI];

    function paletteFor(n) {
      return Array.from({ length: n }, (_, i) => SERIES_PALETTE[i % SERIES_PALETTE.length]);
    }

    // Build linear gradient helper
    function makeBarGradient(ctx, area, from, mid, fadeEnd) {
      if (!area) return from;
      const g = ctx.createLinearGradient(area.left, 0, area.right, 0);
      if (fadeEnd) {
        g.addColorStop(0, from);
        g.addColorStop(0.6, mid || from);
        g.addColorStop(1, fadeEnd);
      } else {
        g.addColorStop(0, from);
        g.addColorStop(1, mid || from);
      }
      return g;
    }

    // Plugin factory
    function glowPlugin(id, color, blur) {
      return {
        id: id,
        beforeDatasetDraw(chart) {
          chart.ctx.save();
          chart.ctx.shadowColor = color;
          chart.ctx.shadowBlur  = blur;
        },
        afterDatasetDraw(chart) {
          chart.ctx.restore();
        },
      };
    }

    const inkGlow = glowPlugin('inkGlow', isDarkInit ? 'rgba(255, 255, 255, 0.30)' : 'rgba(10, 10, 10, 0.26)', 16);
    const ashGlow = glowPlugin('ashGlow', isDarkInit ? 'rgba(200, 200, 200, 0.26)' : 'rgba(90, 90, 90, 0.22)', 14);

    // Taupe edge highlight plugin
    function edgePlugin() {
      return {
        id: 'taupeEdge',
        afterDatasetDraw(chart) {
          const ctx = chart.ctx;
          const meta = chart.getDatasetMeta(0);
          if (!meta || !meta.data) return;
          ctx.save();
          ctx.strokeStyle = isDarkInit ? 'rgba(255, 255, 255, 0.42)' : 'rgba(10, 10, 10, 0.40)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          meta.data.forEach(bar => {
            const x = bar.x + bar.width;
            ctx.moveTo(x, bar.y);
            ctx.lineTo(x, bar.y + bar.height);
          });
          ctx.stroke();
          ctx.restore();
        }
      };
    }

    function hexToRgba(hex, alpha) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')';
    }

    // ── Data from server ──
    const leaderboard     = {{ leaderboard | tojson }};
    const dimNames        = {{ dim_names | tojson }};
    const llmEntries      = leaderboard.filter(e => e.model_type === "llm");
    const baselineEntries = leaderboard.filter(e => e.model_type === "baseline");

    // ── Display-name replacement throughout the DOM ──
    document.querySelectorAll('.model-display-name').forEach(el => {
      const id = el.dataset.id;
      if (id) el.textContent = displayName(id);
    });

    // Update chip names too
    document.querySelectorAll('.chip[data-model]').forEach(el => {
      const id = el.dataset.model;
      if (id) el.textContent = displayName(id);
    });

    // Update mini-lb names
    document.querySelectorAll('.mini-lb-name').forEach(el => {
      const id = el.textContent.trim();
      if (id) el.textContent = displayName(id);
    });

    // ── Model card enhancement ──
    document.querySelectorAll('.model-card').forEach(card => {
      const rank = parseInt(card.dataset.rank, 10);
      const entry = leaderboard.find(e => e.rank === rank);
      if (!entry) return;

      const nameEl = card.querySelector('.model-name');
      if (nameEl) nameEl.textContent = displayName(entry.model_id);

      const truncated = (entry.details || []).some(d =>
        d && d.score && d.score.validation && d.score.validation.parse_error
      );
      if (truncated && nameEl) {
        const badge = document.createElement('span');
        badge.className = 'trunc-badge';
        badge.textContent = 'Truncated';
        badge.title = 'Response exceeded max_tokens — JSON truncated.';
        nameEl.appendChild(badge);

        const note = document.createElement('div');
        note.className = 'trunc-note';
        note.textContent = 'Response exceeded max_tokens — JSON truncated. Score reflects partial output only.';
        const scoreEl = card.querySelector('.card-score');
        if (scoreEl) scoreEl.appendChild(note);
      }

      card.querySelectorAll('.card-dims tbody tr').forEach(tr => {
        const firstCell = tr.querySelector('td, th');
        if (!firstCell) return;
        const text = firstCell.textContent.trim().toLowerCase();
        const tip = DIM_TOOLTIPS_BY_TEXT[text];
        if (tip) {
          tr.title = tip;
          tr.classList.add('has-tooltip');
        }
      });
    });

    // ── Hero stats ──
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function formatNum(v, decimals) {
      if (decimals === 0) return Math.round(v).toLocaleString();
      return v.toFixed(decimals);
    }

    function countUp(el, target, duration, decimals) {
      if (!el || target == null) return;
      if (reduceMotion) { el.textContent = formatNum(target, decimals); return; }
      const start = performance.now();
      function ease(t) { return 1 - Math.pow(1 - t, 4); }
      function frame(now) {
        const t = Math.min(1, (now - start) / duration);
        el.textContent = formatNum(target * ease(t), decimals);
        if (t < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    const allCases = new Set();
    leaderboard.forEach(e => (e.details || []).forEach(d => {
      if (d && d.case_id) allCases.add(d.case_id);
    }));
    const caseCount = allCases.size || (leaderboard[0]?.details?.length || 0);

    countUp(document.getElementById('stat-models'), llmEntries.length, 900, 0);
    countUp(document.getElementById('stat-cases'),  caseCount,          900, 0);

    const disclaimerCases = document.getElementById('disclaimer-cases');
    if (disclaimerCases) disclaimerCases.textContent = caseCount || 1;

    const topEl = document.getElementById('stat-top-score');
    if (llmEntries.length > 0) {
      const topEntry = llmEntries.reduce((acc, e) => e.avg_score > acc.avg_score ? e : acc);
      countUp(topEl, topEntry.avg_score, 1100, 1);
    } else {
      topEl.textContent = '—';
    }

    const llmWithCost = llmEntries.filter(e => (e.total_cost || 0) > 0);
    const bestValueEl = document.getElementById('stat-best-value');
    if (llmWithCost.length === 0) {
      bestValueEl.textContent = 'N/A';
    } else {
      const best = llmWithCost.reduce((acc, e) =>
        (e.avg_score / e.total_cost) > (acc.avg_score / acc.total_cost) ? e : acc
      );
      const ratio = best.avg_score / best.total_cost;
      countUp(bestValueEl, ratio, 1100, ratio >= 100 ? 0 : 1);
    }

    // ── Disclaimer dismissal ──
    const disclaimer = document.getElementById('prelimDisclaimer');
    const dismissBtn = document.getElementById('dismissDisclaimer');
    if (disclaimer && sessionStorage.getItem('evalsecDismissDisclaimer') === '1') {
      disclaimer.classList.add('is-dismissed');
    }
    if (dismissBtn) {
      dismissBtn.addEventListener('click', () => {
        if (disclaimer) disclaimer.classList.add('is-dismissed');
        try { sessionStorage.setItem('evalsecDismissDisclaimer', '1'); } catch (_) {}
      });
    }

    // ── Methodology tab switching ──
    const methTabs   = document.querySelectorAll('.method-tab');
    const methPanels = document.querySelectorAll('.method-panel');
    methTabs.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;
        methTabs.forEach(t => {
          const sel = t === btn;
          t.classList.toggle('selected', sel);
          t.setAttribute('aria-selected', sel ? 'true' : 'false');
        });
        methPanels.forEach(p => p.classList.toggle('active', p.dataset.panel === target));
      });
    });

    // ── Bar Chart (LLM composite scores) ──
    if (chartLoaded && llmEntries.length > 0) {
      new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
          labels: llmEntries.map(e => displayName(e.model_id)),
          datasets: [{
            label: 'Composite Score',
            data: llmEntries.map(e => e.avg_score),
            backgroundColor: (ctx) => {
              const { chart } = ctx;
              return makeBarGradient(chart.ctx, chart.chartArea, ASH, INK);
            },
            hoverBackgroundColor: (ctx) => {
              const { chart } = ctx;
              return makeBarGradient(chart.ctx, chart.chartArea, INK_DIM, INK);
            },
            borderRadius: 6,
            borderSkipped: false,
            maxBarThickness: 44,
            categoryPercentage: 0.85,
            barPercentage: 0.92,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          indexAxis: 'y',
          animation: { duration: 1200, easing: 'easeOutQuart' },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(255, 255, 255, 0.95)',
              borderColor: 'rgba(128, 128, 128, 0.25)',
              borderWidth: 1,
              titleColor: '#0A0A0A',
              bodyColor: '#525252',
              padding: 10,
              cornerRadius: 8,
              titleFont: { family: FONT_SANS, weight: '500' },
              bodyFont:  { family: FONT_MONO, size: 12 },
            },
          },
          scales: {
            x: {
              min: 0, max: 100,
              grid: {
                color: 'rgba(0, 0, 0, 0.06)',
                borderDash: [4, 4],
                drawTicks: false,
              },
              ticks: { color: 'rgba(0, 0, 0, 0.40)', font: { family: FONT_MONO, size: 10 } },
              border: { display: false },
            },
            y: {
              grid: { display: false },
              ticks: {
                color: 'rgba(0, 0, 0, 0.85)',
                font: { family: FONT_SANS, weight: '500', size: 12 },
              },
              border: { display: false },
            }
          }
        },
        plugins: [inkGlow, edgePlugin()],
      });
    }

    // ── Model color map ──
    function modelColor(modelId, index) {
      const map = {
        "deepseek_v4_pro":  INK,
        "claude_sonnet_46": ASH,
        "kimi_k2_thinking": INK_DIM,
        "qwen_3_5":         ASH_LO,
      };
      return map[modelId] || (index % 2 === 0 ? INK : ASH);
    }

    // ── Radar Chart ──
    if (chartLoaded && llmEntries.length > 0) {
      const radarDatasets = llmEntries.map((entry, i) => {
        const stroke = modelColor(entry.model_id, i);
        return {
          label: displayName(entry.model_id),
          data: dimNames.map(d => (entry.dimension_scores[d] || 0)),
          borderColor: stroke,
          backgroundColor: hexToRgba(stroke, 0.22),
          borderWidth: 2.25,
          pointRadius: 3,
          pointBackgroundColor: stroke,
          pointBorderColor: stroke,
          pointHoverRadius: 5,
          pointHoverBackgroundColor: stroke,
          pointHoverBorderColor: '#ffffff',
          pointHoverBorderWidth: 2,
        };
      });

      new Chart(document.getElementById('radarChart'), {
        type: 'radar',
        data: {
          labels: dimNames.map(d => dimLabel(d).toUpperCase()),
          datasets: radarDatasets,
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          animation: { duration: 900, easing: 'easeOutQuart' },
          scales: {
            r: {
              min: 0, max: 100,
              ticks: {
                stepSize: 25,
                backdropColor: 'transparent',
                color: 'rgba(0, 0, 0, 0.30)',
                font: { family: FONT_MONO, size: 9 },
              },
              grid: {
                color: 'rgba(0, 0, 0, 0.06)',
                circular: true,
                lineWidth: 1,
                borderDash: [2, 4],
              },
              angleLines: {
                color: 'rgba(0, 0, 0, 0.08)',
                lineWidth: 1,
                borderDash: [2, 4],
              },
              pointLabels: {
                color: 'rgba(0, 0, 0, 0.50)',
                font: { family: FONT_MONO, size: 10, weight: '500' },
              },
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                boxWidth: 10,
                boxHeight: 10,
                padding: 14,
                color: 'rgba(0, 0, 0, 0.75)',
                font: { family: FONT_SANS, size: 11, weight: '500' },
                usePointStyle: true,
                pointStyle: 'circle',
              },
            },
            tooltip: {
              backgroundColor: 'rgba(255, 255, 255, 0.95)',
              borderColor: 'rgba(128, 128, 128, 0.25)',
              borderWidth: 1,
              titleColor: '#0A0A0A',
              bodyColor: '#525252',
              padding: 10,
              cornerRadius: 8,
              titleFont: { family: FONT_SANS, weight: '500' },
              bodyFont:  { family: FONT_MONO, size: 12 },
            },
          }
        }
      });
    }

    // ── Baseline Bar Chart ──
    const baselineCanvas = document.getElementById('baselineBarChart');
    if (chartLoaded && baselineCanvas && baselineEntries.length > 0) {
      new Chart(baselineCanvas, {
        type: 'bar',
        data: {
          labels: baselineEntries.map(e => displayName(e.model_id)),
          datasets: [{
            label: 'Deterministic Score',
            data: baselineEntries.map(e => e.avg_score),
            backgroundColor: (ctx) => {
              const { chart } = ctx;
              return makeBarGradient(chart.ctx, chart.chartArea, FOG, ASH, hexToRgba(ASH, 0.5));
            },
            hoverBackgroundColor: (ctx) => {
              const { chart } = ctx;
              return makeBarGradient(chart.ctx, chart.chartArea, ASH, INK_DIM, hexToRgba(INK_DIM, 0.5));
            },
            borderRadius: 6,
            borderSkipped: false,
            maxBarThickness: 36,
            categoryPercentage: 0.85,
            barPercentage: 0.92,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          indexAxis: 'y',
          animation: { duration: 1100, easing: 'easeOutQuart' },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(255, 255, 255, 0.95)',
              borderColor: 'rgba(128, 128, 128, 0.25)',
              borderWidth: 1,
              titleColor: '#0A0A0A',
              bodyColor: '#525252',
              padding: 10,
              cornerRadius: 8,
              titleFont: { family: FONT_SANS, weight: '500' },
              bodyFont:  { family: FONT_MONO, size: 12 },
            },
          },
          scales: {
            x: {
              min: 0, max: 100,
              grid: {
                color: 'rgba(0, 0, 0, 0.06)',
                borderDash: [4, 4],
                drawTicks: false,
              },
              ticks: { color: 'rgba(0, 0, 0, 0.40)', font: { family: FONT_MONO, size: 10 } },
              border: { display: false },
            },
            y: {
              grid: { display: false },
              ticks: {
                color: 'rgba(0, 0, 0, 0.85)',
                font: { family: FONT_SANS, weight: '500', size: 12 },
              },
              border: { display: false },
            }
          }
        },
        plugins: [ashGlow],
      });
    }

    // ── Chart theme update on toggle ──
    themeToggle?.addEventListener('click', () => {
      // Re-render charts with new theme colors after a small delay for transition
      setTimeout(updateChartTheme, 200);
    });

    // ── Scroll reveal ──
    document.querySelectorAll('.reveal-stagger').forEach((parent) => {
      Array.from(parent.children).forEach((child, i) => {
        child.classList.add('reveal');
        child.style.setProperty('--reveal-delay', (i * 80) + 'ms');
      });
    });

    document.querySelectorAll('.bar-fill').forEach((bar) => {
      const w = bar.style.width;
      if (w && !reduceMotion) {
        bar.dataset.targetWidth = w;
        bar.style.width = '0%';
      }
    });

    if ('IntersectionObserver' in window && !reduceMotion) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target;
          el.classList.add('is-revealed');
          if (el.classList.contains('bar-fill') && el.dataset.targetWidth) {
            const t = el.dataset.targetWidth;
            requestAnimationFrame(() => { el.style.width = t; });
          }
          io.unobserve(el);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal, .bar-fill').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-revealed'));
      document.querySelectorAll('.bar-fill').forEach((bar) => {
        if (bar.dataset.targetWidth) bar.style.width = bar.dataset.targetWidth;
      });
    }
  })();
  } catch(e) {
    console.error('evalsec dashboard init error:', e);
  }
  </script>

</body>
</html>
