</header>

<main class="container">

  <!-- ── Hero Stats ── -->
  <section class="stats-section">
    <div class="stats-grid reveal-stagger">
      <div class="stat">
        <svg class="stat-icon" aria-hidden="true"><use href="#i-boxes"/></svg>
        <div class="stat-value" id="stat-models">—</div>
        <span class="stat-label">Models tested</span>
        <span class="stat-sub">LLMs evaluated</span>
      </div>
      <div class="stat">
        <svg class="stat-icon" aria-hidden="true"><use href="#i-list-checks"/></svg>
        <div class="stat-value" id="stat-cases">—</div>
        <span class="stat-label">Cases evaluated</span>
        <span class="stat-sub">Per model</span>
      </div>
      <div class="stat">
        <svg class="stat-icon" aria-hidden="true"><use href="#i-trophy"/></svg>
        <div class="stat-value" id="stat-top-score">—</div>
        <span class="stat-label">Top score</span>
        <span class="stat-sub" id="stat-top-score-sub">LLMs only</span>
      </div>
      <div class="stat">
        <svg class="stat-icon" aria-hidden="true"><use href="#i-sparkles"/></svg>
        <div class="stat-value small" id="stat-best-value">—</div>
        <span class="stat-label">Best value</span>
        <span class="stat-sub" id="stat-best-value-sub">Score per dollar</span>
      </div>
    </div>
  </section>

  <!-- ── Methodology ── -->
  <section class="method-section reveal">
    <h2 class="section-title">How this benchmark works<span class="accent-dot">.</span></h2>
    <p class="section-sub">Three reasons why evalsec scores differently from CVSS-only triage.</p>

    <div class="method-tabs" role="tablist">
      <button class="method-tab selected" type="button" data-tab="what" role="tab" aria-selected="true">
        <span class="method-tab-icon"><svg aria-hidden="true"><use href="#i-target"/></svg></span>
        <span>What We Test</span>
      </button>
      <button class="method-tab" type="button" data-tab="how" role="tab" aria-selected="false">
        <span class="method-tab-icon"><svg aria-hidden="true"><use href="#i-scale"/></svg></span>
        <span>How We Score</span>
      </button>
      <button class="method-tab" type="button" data-tab="why" role="tab" aria-selected="false">
        <span class="method-tab-icon"><svg aria-hidden="true"><use href="#i-shield-check"/></svg></span>
        <span>Why It Matters</span>
      </button>
    </div>

    <div class="method-frame">
      <div class="method-inner">
        <div class="method-panel active" data-panel="what" role="tabpanel">
          <h3>What We Test</h3>
          <p>
            Each test case contains a real Trivy vulnerability scan output from a popular
            container image (nginx, redis, postgres, etc.) plus a realistic Kubernetes/EKS
            deployment context. Models must triage the findings by determining real
            <strong>exploitability</strong> — not just CVSS score.
          </p>
        </div>

        <div class="method-panel" data-panel="how" role="tabpanel">
          <h3>How We Score</h3>
          <p>Each response goes through two passes:</p>
          <ul>
            <li>
              <strong>Pass 1 — deterministic (20%)</strong> · regex matches, JSON validity,
              CVE coverage, format compliance.
            </li>
            <li>
              <strong>Pass 2 — LLM judge (80%)</strong> · Claude Opus 4.7 scores responses
              on four rubric dimensions:
              <ul>
                <li><strong>Reachability</strong> — does the model use deployment context?</li>
                <li><strong>Prioritization</strong> — correct urgency ranking?</li>
                <li><strong>Actionability</strong> — specific, executable recommendations?</li>
                <li><strong>Conciseness</strong> — focused output without padding?</li>
              </ul>
            </li>
          </ul>
        </div>

        <div class="method-panel" data-panel="why" role="tabpanel">
          <h3>Why It Matters</h3>
          <p>
            Most CVE triage benchmarks score against CVSS alone. <strong>evalsec</strong>
            measures whether LLMs can reason about exploitability in realistic production
            deployments — the actual skill DevSecOps engineers need.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Charts ── -->
  <section class="charts-section reveal">
    <h2 class="section-title">The leaderboard at a glance<span class="accent-dot">.</span></h2>
    <p class="section-sub">Composite scores and per-dimension strengths across all evaluated LLMs.</p>

    <div class="charts-frame">
      <div class="charts-inner">
        <div class="chart-card">
          <h3>Composite Score</h3>
          <div class="chart-sub">Higher is better · 0–100 scale</div>
          <canvas id="barChart"></canvas>
          <div class="chart-fallback" id="barChartFallback">
            Chart requires Chart.js — check browser console for details.
          </div>
        </div>
        <div class="chart-card">
          <h3>Per-Dimension Radar</h3>
          <div class="chart-sub">Strengths across rubric dimensions</div>
          <canvas id="radarChart"></canvas>
          <div class="chart-fallback" id="radarChartFallback">
            Chart requires Chart.js — check browser console for details.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── LLM Leaderboard ── -->
  <section class="ranking-section reveal">
    <aside class="disclaimer" id="prelimDisclaimer">
      <div class="disclaimer-icon" aria-hidden="true">!</div>
      <div class="disclaimer-body">
        <strong>Preliminary results</strong> — based on
        <strong><span id="disclaimer-cases">1</span> of 17</strong>
        test cases. Final rankings may shift significantly with the full benchmark.
        Full results coming soon.
      </div>
      <button class="disclaimer-close" type="button" aria-label="Dismiss notice" id="dismissDisclaimer">×</button>
    </aside>

    {% set llm_entries = leaderboard | selectattr("model_type", "equalto", "llm") | list %}
    <div class="leaderboard">
      <div class="lb-header">
        <h2>LLM Rankings</h2>
        <div class="lb-note">Scored by Claude Opus 4.7 across rubric dimensions, normalized to 0–100.</div>
      </div>
      <div class="lb-wrap">
        <table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>Model</th>
              <th>Score</th>
              <th class="has-tooltip" title="Does the model use stack context to determine real exploitability vs just relying on CVSS scores?">Reachability</th>
              <th class="has-tooltip" title="Does the model rank findings by correct urgency (critical first, deferrable last)?">Prioritization</th>
              <th class="has-tooltip" title="Are recommendations specific and executable, with concrete commands or patch versions?">Actionability</th>
              <th class="has-tooltip" title="Is the response focused without preamble or padding, under target length?">Conciseness</th>
              <th>Cost</th>
            </tr>
          </thead>
          <tbody>
            {% for entry in llm_entries %}
            {% set ns = namespace(truncated=false) %}
            {% for d in (entry.details or []) %}
              {% if d.score is mapping and d.score.get('validation', {}).get('parse_error') %}
                {% set ns.truncated = true %}
              {% endif %}
            {% endfor %}
            {% set is_truncated = ns.truncated %}
            {% set reach = entry.dimension_scores.get("reachability_reasoning", 0) %}
            {% set prio  = entry.dimension_scores.get("prioritization", 0) %}
            {% set act   = entry.dimension_scores.get("actionability", 0) %}
            {% set conc  = entry.dimension_scores.get("conciseness", 0) %}
            <tr class="{% if loop.index == 1 %}top-row{% endif %}" data-model-id="{{ entry.model_id }}">
              <td class="rank-cell">
                <span class="rank-pill rank-{{ loop.index if loop.index <= 3 else 'n' }}">{{ loop.index }}</span>
              </td>
              <td class="model-name-cell">
                <span class="model-display-name" data-id="{{ entry.model_id }}">{{ entry.model_id }}</span>
                {% if is_truncated %}<span class="trunc-badge" title="Response exceeded max_tokens — JSON truncated. Score reflects partial output only.">Truncated</span>{% endif %}
                <span class="model-id-mono">{{ entry.model_id }}</span>
                {% if is_truncated %}
                <div class="trunc-note">Response exceeded max_tokens — JSON truncated. Score reflects partial output only.</div>
                {% endif %}
              </td>
              <td class="score-cell">
                <div class="score-bar-wrap">
                  <span class="score-bar" style="width: {{ entry.avg_score * 0.7 }}px;"></span>
                  {{ "%.1f"|format(entry.avg_score) }}
                </div>
              </td>
              <td>{{ "%.1f"|format(reach) }}</td>
              <td>{{ "%.1f"|format(prio) }}</td>
              <td>{{ "%.1f"|format(act) }}</td>
              <td>{{ "%.1f"|format(conc) }}</td>
              <td class="cost-cell">${{ "%.4f"|format(entry.total_cost) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ── Baseline Section ── -->
  {% set baselines = leaderboard | selectattr("model_type", "equalto", "baseline") | list %}
  {% if baselines %}
  <section class="baseline-section reveal">
    <div class="divider"><span>Baseline methods · no AI reasoning</span></div>

    <div class="charts-frame baseline-chart-frame">
      <div class="charts-inner">
        <div class="chart-card">
          <h3>Baseline Scores</h3>
          <div class="chart-sub">Deterministic methods · for reference only, not directly comparable to LLMs</div>
          <canvas id="baselineBarChart"></canvas>
          <div class="chart-fallback" id="baselineBarChartFallback">
            Chart requires Chart.js — check browser console for details.
          </div>
        </div>
      </div>
    </div>

    <div class="leaderboard baseline-board">
      <div class="lb-header">
        <h2>Baseline Comparison</h2>
        <div class="lb-note">Baselines use deterministic scoring only (no LLM judge pass). Scores are not directly comparable to LLMs.</div>
      </div>
      <div class="lb-wrap">
        <table>
          <thead>
            <tr>
              <th>Model</th>
              <th>Score</th>
              <th class="has-tooltip" title="How accurate were verdicts (exploitable/not exploitable/partial) vs ground truth?">Verdict Accuracy</th>
              <th class="has-tooltip" title="How accurate was the priority ordering vs ground truth?">Priority Accuracy</th>
            </tr>
          </thead>
          <tbody>
            {% for entry in baselines %}
            <tr data-model-id="{{ entry.model_id }}">
              <td class="model-name-cell">
                <span class="model-display-name" data-id="{{ entry.model_id }}">{{ entry.model_id }}</span>
                <span class="model-id-mono">{{ entry.model_id }}</span>
              </td>
              <td class="score-cell">
                <div class="score-bar-wrap">
                  <span class="score-bar" style="width: {{ entry.avg_score * 0.7 }}px; background: linear-gradient(90deg, var(--warn), #fbbf24);"></span>
                  {{ "%.1f"|format(entry.avg_score) }}
                </div>
              </td>
              <td>{{ "%.1f"|format(entry.avg_verdict) }}</td>
              <td>{{ "%.1f"|format(entry.avg_priority) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ── Model Cards ── -->
  <section class="cards-section reveal">
    <h2 class="section-title">Drill-down per model<span class="accent-dot">.</span></h2>
    <p class="section-sub">Full per-dimension breakdown for every evaluated model.</p>
    <div class="cards-grid reveal-stagger">
      {% for entry in leaderboard %}
      {% include "card.html.j2" %}
      {% endfor %}
    </div>
  </section>

</main>

