<!DOCTYPE html>
<html lang="en" data-color-scheme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">

  <meta property="og:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta property="og:description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://evalsec.farhan.ngenz.org">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta name="twitter:description" content="Open-source benchmark measuring how well LLMs triage real-world vulnerability findings in Kubernetes/EKS environments.">

  <title>evalsec — DevSecOps LLM Benchmark</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="./chart.umd.min.js"></script>

  <style>
    @property --angle {
      syntax: "<angle>";
      initial-value: 0deg;
      inherits: false;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ─────────────────────────────────────────────
       DESIGN TOKENS — Electric Violet on near-black
       ───────────────────────────────────────────── */
    :root {
      color-scheme: dark;

      /* Background layers */
      --bg-base:        #08080C;
      --bg-elevated:    #0E0E14;
      --bg-overlay:     #14141C;
      --bg-glass:       rgba(20, 20, 28, 0.6);

      /* Primary accent — Electric Violet */
      --accent-primary:    #7C5CFF;
      --accent-primary-hi: #9D85FF;
      --accent-primary-lo: #5538E5;
      --accent-glow:       rgba(124, 92, 255, 0.15);

      /* Secondary accent — Cyber Lime (baselines / "no AI" metrics) */
      --accent-secondary:      #C6FF3D;
      --accent-secondary-hi:   #DEFF7A;
      --accent-secondary-lo:   #9CCC1F;
      --accent-secondary-soft: rgba(198, 255, 61, 0.10);
      --accent-secondary-line: rgba(198, 255, 61, 0.30);
      --accent-secondary-glow: rgba(198, 255, 61, 0.18);

      /* Semantic */
      --success: #34D399;
      --warning: #FBA94C;
      --danger:  #F87171;
      --info:    #60A5FA;

      /* Text hierarchy */
      --text-primary:   #F4F4F7;
      --text-secondary: #A1A1AA;
      --text-tertiary:  #71717A;
      --text-disabled:  #52525B;

      /* Borders */
      --border-subtle:  rgba(255, 255, 255, 0.06);
      --border-default: rgba(255, 255, 255, 0.10);
      --border-stronger: rgba(255, 255, 255, 0.16);
      --border-accent:  rgba(124, 92, 255, 0.30);

      /* Spacing — 8px grid */
      --space-1:  4px;
      --space-2:  8px;
      --space-3:  12px;
      --space-4:  16px;
      --space-6:  24px;
      --space-8:  32px;
      --space-12: 48px;
      --space-16: 64px;
      --space-24: 96px;

      /* Tracking */
      --tracking-tight: -0.04em;
      --tracking-body:  -0.01em;
      --tracking-wide:   0.12em;

      /* Premium easing */
      --ease-premium: cubic-bezier(0.16, 1, 0.3, 1);

      /* ────────────────────────────────────────────
         Backward-compat aliases (mapped to new tokens
         so existing CSS selectors keep working without
         renaming every reference in this commit).
         ──────────────────────────────────────────── */
      --bg:           var(--bg-base);
      --surface:      var(--bg-elevated);
      --surface-2:    var(--bg-overlay);
      --text:         var(--text-primary);
      --text-soft:    #E4E4E7;
      --muted:        var(--text-secondary);
      --muted-2:      var(--text-tertiary);
      --accent:       var(--accent-primary);
      --accent-2:     var(--accent-primary-hi);
      --accent-deep:  var(--accent-primary-lo);
      --accent-soft:  rgba(124, 92, 255, 0.10);
      --accent-line:  var(--border-accent);
      --warn:         var(--warning);
      --warn-soft:    rgba(251, 169, 76, 0.10);
      --border:       var(--border-default);
      --border-soft:  var(--border-subtle);
      --border-strong: var(--border-stronger);

      /* Radii */
      --radius-sm:    8px;
      --radius:       12px;
      --radius-lg:    16px;
      --radius-xl:    24px;
      --radius-2xl:   28px;

      /* Shadows */
      --shadow-1:     0 1px 2px rgba(0,0,0,0.4);
      --shadow-2:     0 12px 32px -12px rgba(0,0,0,0.6);
      --shadow-glow:  0 0 0 1px rgba(124,92,255,0.10),
                      0 20px 40px -20px rgba(124,92,255,0.25),
                      inset 0 1px 0 rgba(255,255,255,0.05);

      /* Typography */
      --font-sans: "Geist", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: "Geist Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

      /* Legacy grain (kept for card-internal usage) */
      --grain: radial-gradient(1px 1px at 25% 35%, rgba(255,255,255,0.04) 50%, transparent 50%),
               radial-gradient(1px 1px at 75% 65%, rgba(255,255,255,0.04) 50%, transparent 50%);
    }

    html {
      color-scheme: dark;
      background: var(--bg-base);
    }

    html, body {
      color: var(--text-primary);
      font-family: var(--font-sans);
      font-feature-settings: "ss01", "cv11";
      line-height: 1.55;
      letter-spacing: var(--tracking-body);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      min-height: 100%;
    }

    body {
      position: relative;
      background:
        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(124, 92, 255, 0.12), transparent 70%),
        radial-gradient(ellipse 60% 40% at 80% 20%, rgba(198, 255, 61, 0.04), transparent 60%),
        radial-gradient(ellipse 70% 45% at 15% 75%, rgba(124, 92, 255, 0.06), transparent 70%),
        var(--bg-base);
      background-attachment: fixed;
      isolation: isolate;
    }

    /* Subtle SVG noise overlay — kills the "flat digital" feel */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.025;
      mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      z-index: 0;
    }

    /* Lift actual content above the noise overlay */
    body > * { position: relative; z-index: 1; }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    a {
      color: var(--accent-primary-hi);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    a:hover { color: var(--accent-primary); }

    /* Selection highlight */
    ::selection {
      background: rgba(124, 92, 255, 0.30);
      color: var(--text-primary);
    }
    ::-moz-selection {
      background: rgba(124, 92, 255, 0.30);
      color: var(--text-primary);
    }

    /* Custom scrollbar — thin, transparent track, violet thumb */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: rgba(124, 92, 255, 0.25);
      border-radius: 999px;
      border: 2px solid transparent;
      background-clip: padding-box;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(124, 92, 255, 0.45); background-clip: padding-box; }
    html { scrollbar-color: rgba(124, 92, 255, 0.30) transparent; scrollbar-width: thin; }

    /* Focus ring — violet, visible only for keyboard focus */
    :focus { outline: none; }
    :focus-visible {
      outline: 2px solid rgba(124, 92, 255, 0.55);
      outline-offset: 2px;
      border-radius: 4px;
    }

    /* Respect reduced motion preference */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* ─────────────────────────────────────────────
       HERO
       ───────────────────────────────────────────── */
    .hero {
      position: relative;
      padding: 6rem 0 4rem;
      text-align: center;
      overflow: hidden;
    }

    /* Ambient horizon halo — wide, soft, top of hero */
    .hero::before {
      content: "";
      position: absolute;
      top: -20%;
      left: 50%;
      transform: translateX(-50%);
      width: 1200px;
      height: 600px;
      background: radial-gradient(closest-side, rgba(124, 92, 255, 0.18), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .hero-inner { position: relative; z-index: 1; }

    /* Tight bokeh orb behind the logo */
    .hero-orb {
      position: absolute;
      top: 48%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 480px;
      height: 480px;
      background: radial-gradient(closest-side,
        rgba(124, 92, 255, 0.40) 0%,
        rgba(124, 92, 255, 0.18) 35%,
        transparent 70%);
      filter: blur(40px);
      z-index: -1;
      pointer-events: none;
      border-radius: 50%;
    }

    .beta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.42rem 0.95rem;
      background: linear-gradient(135deg,
        rgba(124, 92, 255, 0.16) 0%,
        rgba(124, 92, 255, 0.06) 100%);
      color: var(--accent-primary-hi);
      border: 1px solid var(--border-accent);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      margin-bottom: 1.75rem;
      box-shadow:
        0 0 24px -6px var(--accent-glow),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .pulse-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--accent-primary-hi);
      box-shadow: 0 0 0 0 var(--accent-primary);
      animation: pulse 2.4s var(--ease-premium) infinite;
    }
    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(124, 92, 255, 0.55); }
      70%  { box-shadow: 0 0 0 9px rgba(124, 92, 255, 0); }
      100% { box-shadow: 0 0 0 0 rgba(124, 92, 255, 0); }
    }

    .hero-title {
      position: relative;
      font-size: clamp(3rem, 8vw, 6rem);
      font-weight: 600;
      letter-spacing: -0.055em;
      line-height: 0.95;
      margin-bottom: 1.1rem;
      background: linear-gradient(135deg, #F4F4F7 0%, #C9BAFF 55%, #9D85FF 100%);
      -webkit-background-clip: text;
              background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .hero-title .accent-dot {
      /* keep the period solid violet so it pops against the gradient */
      -webkit-text-fill-color: var(--accent-primary);
      color: var(--accent-primary);
      background: none;
    }

    .hero-subtitle {
      font-size: clamp(1.05rem, 2vw, 1.3rem);
      color: var(--text-soft);
      font-weight: 500;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }
    .hero-desc {
      font-size: 1.02rem;
      color: var(--text-secondary);
      max-width: 44rem;
      margin: 0 auto;
      letter-spacing: -0.005em;
    }

    .meta-pills {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 2.25rem;
    }
    .meta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.42rem 0.9rem;
      border: 1px solid var(--border-subtle);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-secondary);
      background: rgba(20, 20, 28, 0.55);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: border-color 0.2s var(--ease-premium), color 0.2s var(--ease-premium);
    }
    .meta-pill:hover {
      border-color: var(--border-default);
      color: var(--text-primary);
    }
    .meta-pill .meta-icon {
      color: var(--text-tertiary);
      flex-shrink: 0;
      transition: color 0.2s var(--ease-premium);
    }
    .meta-pill:hover .meta-icon { color: var(--accent-primary-hi); }

    /* ─────────────────────────────────────────────
       SECTION HEADINGS
       ───────────────────────────────────────────── */
    .section-title {
      font-size: clamp(1.75rem, 3.5vw, 2.5rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1.1;
      text-align: center;
      margin-bottom: 0.6rem;
    }
    .section-title .accent-dot { color: var(--accent); }
    .section-sub {
      text-align: center;
      color: var(--muted);
      font-size: 1rem;
      max-width: 36rem;
      margin: 0 auto 2rem;
      letter-spacing: -0.01em;
    }

    /* ─────────────────────────────────────────────
       HERO STATS (KPI cards)
       ───────────────────────────────────────────── */
    .stats-section { margin-bottom: 6rem; }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    @media (max-width: 820px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .stat {
      position: relative;
      background: linear-gradient(135deg,
        rgba(20, 20, 28, 0.80) 0%,
        rgba(14, 14, 20, 0.60) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.6rem 1.5rem 1.35rem;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition:
        border-color 0.35s var(--ease-premium),
        transform 0.35s var(--ease-premium),
        box-shadow 0.35s var(--ease-premium);
      overflow: hidden;
    }
    /* Featured gradient accent line at the top of each card */
    .stat::before {
      content: "";
      position: absolute;
      top: 0;
      left: 12%;
      right: 12%;
      height: 1px;
      background: linear-gradient(90deg,
        transparent,
        rgba(124, 92, 255, 0.55),
        transparent);
      opacity: 0.5;
      transition: opacity 0.35s var(--ease-premium);
    }
    .stat:hover {
      border-color: var(--border-accent);
      transform: translateY(-2px) scale(1.015);
      box-shadow: var(--shadow-glow);
    }
    .stat:hover::before { opacity: 1; }

    .stat-icon {
      position: absolute;
      top: 1.1rem;
      right: 1.1rem;
      width: 18px;
      height: 18px;
      color: var(--text-primary);
      opacity: 0.28;
      pointer-events: none;
      transition:
        opacity 0.35s var(--ease-premium),
        color 0.35s var(--ease-premium);
    }
    .stat:hover .stat-icon {
      opacity: 0.7;
      color: var(--accent-primary-hi);
    }

    .stat-value {
      font-family: var(--font-mono);
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      background: linear-gradient(135deg, #F4F4F7 0%, #C9BAFF 100%);
      -webkit-background-clip: text;
              background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .stat-value.small {
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      letter-spacing: -0.03em;
    }
    .stat-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--text-tertiary);
      margin-top: 0.95rem;
      font-weight: 500;
    }
    .stat-sub {
      display: block;
      font-size: 0.78rem;
      color: var(--text-tertiary);
      margin-top: 0.3rem;
      letter-spacing: -0.005em;
    }

    /* ─────────────────────────────────────────────
       METHODOLOGY TABS
       ───────────────────────────────────────────── */
    .method-section { margin-bottom: 6rem; }

    .method-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    }

    .method-tab {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.75rem 1.25rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-family: inherit;
      font-size: 0.86rem;
      font-weight: 500;
      color: var(--text-soft);
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .method-tab:hover { border-color: var(--border-strong); color: var(--text); }
    .method-tab .method-tab-icon {
      font-size: 1rem;
      line-height: 1;
    }
    .method-tab.selected {
      color: var(--text);
      background: var(--surface);
    }
    .method-tab.selected::after {
      content: "";
      position: absolute;
      inset: -1.5px;
      border-radius: inherit;
      padding: 1.5px;
      background: conic-gradient(from var(--angle), transparent 0%, var(--accent) 18%, transparent 30%, transparent 60%, var(--accent-2) 78%, transparent 90%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
              mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
              mask-composite: exclude;
      animation: spin 4.5s linear infinite;
      pointer-events: none;
    }
    @keyframes spin { to { --angle: 360deg; } }

    .method-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-2xl);
      padding: 0.55rem;
      background: var(--surface);
    }
    .method-inner {
      background: var(--surface-2);
      border-radius: calc(var(--radius-2xl) - 5px);
      padding: 2rem clamp(1.25rem, 4vw, 3rem);
      min-height: 220px;
    }

    .method-panel { display: none; }
    .method-panel.active { display: block; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .method-panel h3 {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
      color: var(--text);
    }
    .method-panel p {
      color: var(--text-soft);
      font-size: 0.95rem;
      max-width: 60ch;
      margin-bottom: 0.65rem;
    }
    .method-panel p:last-child { margin-bottom: 0; }
    .method-panel ul {
      list-style: none;
      padding: 0;
      color: var(--text-soft);
      font-size: 0.93rem;
    }
    .method-panel ul > li {
      padding-left: 1.15rem;
      position: relative;
      margin-bottom: 0.5rem;
    }
    .method-panel ul > li::before {
      content: "—";
      position: absolute; left: 0;
      color: var(--accent);
    }
    .method-panel ul ul {
      margin-top: 0.4rem;
      margin-left: 0.4rem;
      font-size: 0.88rem;
    }
    .method-panel ul ul > li::before { content: "·"; color: var(--muted-2); }
    .method-panel strong { color: var(--text); font-weight: 600; }

    /* ─────────────────────────────────────────────
       CHARTS
       ───────────────────────────────────────────── */
    .charts-section { margin-bottom: 4.5rem; }

    .charts-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-2xl);
      padding: 0.55rem;
      background: var(--surface);
      box-shadow: var(--shadow-2);
    }
    .charts-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem;
      background: var(--surface-2);
      border-radius: calc(var(--radius-2xl) - 5px);
      padding: 0.55rem;
    }
    @media (max-width: 900px) {
      .charts-inner { grid-template-columns: 1fr; }
    }

    .chart-card {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 1.4rem 1.4rem 1.1rem;
    }
    .chart-card h3 {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 0.3rem;
    }
    .chart-sub {
      font-size: 0.8rem;
      color: var(--muted-2);
      margin-bottom: 1rem;
    }
    .chart-card canvas { max-height: 340px; }

    .baseline-chart-frame .charts-inner {
      grid-template-columns: 1fr;
    }
    .baseline-chart-frame canvas { max-height: 240px; }

    .chart-fallback {
      display: none;
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--muted-2);
      font-size: 0.88rem;
      border: 1px dashed var(--border-strong);
      border-radius: var(--radius);
    }
    .chart-fallback.visible { display: block; }
    .chart-fallback-icon {
      font-size: 1.6rem;
      margin-bottom: 0.5rem;
      opacity: 0.5;
    }

    /* ─────────────────────────────────────────────
       DISCLAIMER
       ───────────────────────────────────────────── */
    .disclaimer {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: var(--warn-soft);
      border: 1px solid var(--warn);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.35rem;
      margin-bottom: 1.5rem;
    }
    .disclaimer.is-dismissed { display: none; }
    .disclaimer-icon {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--warn);
      color: #000;
      font-size: 0.95rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .disclaimer-body { flex: 1; color: var(--text-soft); font-size: 0.92rem; line-height: 1.5; }
    .disclaimer-body strong { color: var(--warn); font-weight: 600; }
    .disclaimer-close {
      background: transparent;
      border: none;
      color: var(--muted);
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      padding: 0 0.35rem;
      font-family: inherit;
    }
    .disclaimer-close:hover { color: var(--text); }

    /* ─────────────────────────────────────────────
       LEADERBOARD
       ───────────────────────────────────────────── */
    .ranking-section { margin-bottom: 5rem; }

    .leaderboard {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      overflow: hidden;
    }
    .lb-header {
      padding: 1.5rem 1.75rem 0.9rem;
      border-bottom: 1px solid var(--border-soft);
    }
    .lb-header h2 {
      font-size: 1.15rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    .lb-note {
      font-size: 0.82rem;
      color: var(--muted);
      margin-top: 0.3rem;
    }
    .leaderboard.baseline-board .lb-header h2 { color: var(--muted); font-weight: 500; }

    .lb-wrap { overflow-x: auto; }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      text-align: left;
      padding: 0.85rem 1.25rem;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      border-bottom: 1px solid var(--border-soft);
      background: transparent;
      white-space: nowrap;
    }
    thead th:first-child { padding-left: 1.75rem; }
    thead th:last-child  { padding-right: 1.75rem; }

    tbody td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border-soft);
      font-size: 0.9rem;
      color: var(--text-soft);
      font-variant-numeric: tabular-nums;
    }
    tbody td:first-child { padding-left: 1.75rem; }
    tbody td:last-child  { padding-right: 1.75rem; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr { transition: background 0.15s ease; }
    tbody tr:hover { background: var(--surface-2); }

    tbody tr.top-row {
      background: linear-gradient(90deg, var(--accent-soft) 0%, transparent 100%);
    }
    tbody tr.top-row td:first-child {
      border-left: 3px solid var(--accent);
    }
    tbody tr.top-row:hover { filter: brightness(1.04); }

    .baseline-board tbody td { color: var(--muted); }
    .baseline-board tbody td.model-name-cell { color: var(--text-soft); }

    .rank-cell {
      font-weight: 600;
      width: 3.5rem;
      font-size: 1rem;
      color: var(--muted);
    }
    .medal { font-size: 1.3rem; }

    .model-name-cell { font-weight: 500; letter-spacing: -0.01em; color: var(--text); }
    .model-id-mono {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted-2);
      font-weight: 400;
      display: block;
      margin-top: 0.2rem;
    }

    .score-cell { font-weight: 600; }
    .score-bar-wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
    }
    .score-bar {
      display: inline-block;
      height: 5px;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      max-width: 70px;
    }

    .cost-cell {
      font-family: var(--font-mono);
      font-size: 0.83rem;
      color: var(--muted);
    }

    .type-badge {
      display: inline-block;
      padding: 0.18rem 0.6rem;
      font-size: 0.65rem;
      font-weight: 600;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .type-llm {
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid var(--accent-line);
    }
    .type-baseline {
      background: var(--warn-soft);
      color: var(--warn);
      border: 1px solid var(--warn);
    }

    .trunc-badge {
      display: inline-block;
      padding: 0.18rem 0.55rem;
      background: var(--warn-soft);
      color: var(--warn);
      font-size: 0.68rem;
      font-weight: 600;
      border-radius: 999px;
      margin-left: 0.55rem;
      border: 1px solid var(--warn);
      white-space: nowrap;
    }
    .trunc-note {
      font-size: 0.72rem;
      color: var(--warn);
      margin-top: 0.45rem;
      line-height: 1.45;
      max-width: 32ch;
    }

    th.has-tooltip {
      cursor: help;
      text-decoration: underline dotted;
      text-decoration-color: var(--muted-2);
      text-underline-offset: 4px;
    }

    .card-dims tbody tr.has-tooltip th,
    .card-dims tbody tr.has-tooltip td:first-child {
      cursor: help;
      border-bottom: 1px dotted currentColor;
    }

    /* ─────────────────────────────────────────────
       BASELINE DIVIDER
       ───────────────────────────────────────────── */
    .baseline-section { margin-bottom: 5rem; }
    .divider {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin: 2rem 0 1.75rem;
    }
    .divider::before, .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    .divider span {
      font-size: 0.74rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .baseline-chart-frame { margin-bottom: 1.5rem; }

    /* ─────────────────────────────────────────────
       MODEL CARDS
       ───────────────────────────────────────────── */
    .cards-section { margin-bottom: 5rem; }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.25rem;
    }

    .model-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 1.5rem;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .model-card:hover {
      border-color: var(--accent-line);
      transform: translateY(-2px);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }

    .rank-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.2rem; height: 2.2rem;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.8rem;
      font-weight: 600;
      flex-shrink: 0;
      border: 1px solid var(--accent-line);
    }
    .model-name {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--text);
    }

    .card-score { text-align: center; margin-bottom: 1.25rem; }
    .score-value {
      font-size: 2.75rem;
      font-weight: 500;
      letter-spacing: -0.04em;
      line-height: 1;
      color: var(--text);
    }
    .score-label {
      display: block;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted);
      margin-top: 0.4rem;
      font-weight: 600;
    }

    .card-dims {
      width: 100%;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
    .card-dims caption {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
      margin-bottom: 0.55rem;
      text-align: left;
      font-weight: 600;
    }
    .card-dims th, .card-dims td {
      padding: 0.4rem 0;
      border: none;
    }
    .card-dims th {
      color: var(--muted);
      font-weight: 400;
      width: 50%;
      text-align: left;
    }

    .bar-wrapper {
      position: relative;
      height: 1.05rem;
      background: var(--surface-2);
      border-radius: 999px;
      overflow: hidden;
    }
    .bar-fill {
      position: absolute;
      top: 0; left: 0;
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      border-radius: 999px;
      transition: width 0.3s ease;
    }
    .bar-label {
      position: relative;
      display: block;
      padding: 0 0.5rem;
      font-size: 0.72rem;
      font-weight: 500;
      line-height: 1.05rem;
      white-space: nowrap;
      color: var(--text);
      font-family: var(--font-mono);
    }

    .card-cost {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-soft);
    }
    .cost-label { color: var(--muted); }
    .cost-value { font-family: var(--font-mono); color: var(--text-soft); }

    /* ─────────────────────────────────────────────
       FOOTER
       ───────────────────────────────────────────── */
    footer {
      margin-top: 5rem;
      padding: 3rem 0 2.5rem;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--muted);
      font-size: 0.83rem;
    }
    .footer-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      justify-content: center;
      align-items: center;
    }
    .footer-cell { white-space: nowrap; }
    .footer-value { color: var(--text-soft); font-family: var(--font-mono); font-size: 0.78rem; }
    .footer-mark {
      margin-top: 1.25rem;
      font-size: 0.72rem;
      color: var(--muted-2);
      letter-spacing: 0.08em;
    }
    .footer-mark .accent-dot { color: var(--accent); }
  </style>
</head>
<body>

<!-- Lucide icon sprite — referenced via <use href="#i-name"/> throughout the page -->
