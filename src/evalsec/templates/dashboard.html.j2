<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Measuring how well LLMs triage real container vulnerability scans using deployment context, not just CVSS.">
  <meta name="theme-color" content="#ffffff">

  <meta property="og:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta property="og:description" content="Measuring how well LLMs triage real container vulnerability scans using deployment context, not just CVSS.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://evalsec.farhan.ngenz.org">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="evalsec — DevSecOps LLM Benchmark">
  <meta name="twitter:description" content="Measuring how well LLMs triage real container vulnerability scans using deployment context, not just CVSS.">

  <title>evalsec — DevSecOps LLM Benchmark</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="./chart.umd.min.js"></script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ─────────────────────────────────────────────
       THEME — Light mode (default)
       ───────────────────────────────────────────── */
    :root {
      color-scheme: light;

      /* Surface — pure white */
      --background: #FFFFFF;
      --foreground: #171717;
      --muted-foreground: rgba(23, 23, 23, 0.65);
      --subtle-foreground: rgba(23, 23, 23, 0.45);
      --disabled-foreground: rgba(23, 23, 23, 0.30);
      --border: rgba(0, 0, 0, 0.10);

      /* Primary — pure black */
      --primary: #000000;
      --primary-hover: #1F1F1F;
      --primary-border-hover: #000000;
      --primary-foreground: #FFFFFF;

      /* Secondary — neutral surface */
      --secondary: rgba(0, 0, 0, 0.04);
      --secondary-hover: #F5F5F5;
      --secondary-border-hover: #000000;
      --secondary-foreground: #000000;

      /* Cards */
      --card: rgba(255, 255, 255, 0.70);
      --card-strong: rgba(255, 255, 255, 0.92);

      /* Grid */
      --grid: rgba(0, 0, 0, 0.85);

      /* Shadows — neutral */
      --shadow-primary: rgba(0, 0, 0, 0.25);
      --shadow-secondary: rgba(0, 0, 0, 0.15);

      /* Semantic status colors — preserved (used by charts/badges) */
      --success: #22C55E;
      --warning: #f59e0b;
      --danger:  #EF4444;
      --info:    #6B7280;

      /* Brand colors — constant across light/dark, never change on theme toggle */
      --brand-deepseek:      #4D6BFE;
      --brand-claude:        #D97757;
      --brand-kimi:          #10B981;
      --brand-qwen:          #EC4899;
      --brand-deepseek-soft: rgba(77, 107, 254, 0.10);
      --brand-claude-soft:   rgba(217, 119, 87, 0.10);
      --brand-kimi-soft:     rgba(16, 185, 129, 0.10);
      --brand-qwen-soft:     rgba(236, 72, 153, 0.10);

      --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --font-mono: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;

      --radius-sm: 8px;
      --radius: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
    }

    /* ─────────────────────────────────────────────
       THEME — Dark mode
       ───────────────────────────────────────────── */
    html.dark {
      color-scheme: dark;

      /* Surface — pure black */
      --background: #000000;
      --foreground: #EDEDED;
      --muted-foreground: rgba(237, 237, 237, 0.65);
      --subtle-foreground: rgba(237, 237, 237, 0.45);
      --disabled-foreground: rgba(237, 237, 237, 0.30);
      --border: rgba(255, 255, 255, 0.12);

      /* Primary — pure white */
      --primary: #FFFFFF;
      --primary-hover: #E5E5E5;
      --primary-border-hover: #FFFFFF;
      --primary-foreground: #000000;

      /* Secondary */
      --secondary: rgba(255, 255, 255, 0.06);
      --secondary-hover: #1A1A1A;
      --secondary-border-hover: #FFFFFF;
      --secondary-foreground: #FFFFFF;

      /* Cards */
      --card: rgba(20, 20, 20, 0.70);
      --card-strong: rgba(20, 20, 20, 0.92);

      /* Grid */
      --grid: rgba(255, 255, 255, 0.85);

      /* Shadows */
      --shadow-primary: rgba(255, 255, 255, 0.15);
      --shadow-secondary: rgba(255, 255, 255, 0.08);
    }

    /* ─────────────────────────────────────────────
       BASE
       ───────────────────────────────────────────── */
    html {
      background: var(--background);
      scroll-behavior: smooth;
    }

    html, body {
      color: var(--foreground);
      font-family: var(--font-sans);
      font-feature-settings: "ss01", "cv11";
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      min-height: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      /* Background is delegated to html and .site-bg so the grid pattern
         (positioned behind body via z-index: -1) remains visible through
         the transparent body. */
      background: transparent;
      /* overflow-clip is cheaper than hidden — no scroll container created */
      overflow-x: clip;
    }

    a {
      color: var(--primary);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    a:hover { color: var(--primary-hover); }

    ::selection {
      background: rgba(128, 128, 128, 0.30);
      color: var(--foreground);
    }
    ::-moz-selection {
      background: rgba(128, 128, 128, 0.30);
      color: var(--foreground);
    }

    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: rgba(128, 128, 128, 0.35);
      border-radius: 999px;
      border: 2px solid transparent;
      background-clip: padding-box;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(128, 128, 128, 0.55); background-clip: padding-box; }
    html { scrollbar-color: rgba(128, 128, 128, 0.35) transparent; scrollbar-width: thin; }

    :focus { outline: none; }
    :focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
      border-radius: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* ─────────────────────────────────────────────
       SITE BACKGROUND — Infinite SVG Grid + Orbs
       ───────────────────────────────────────────── */
    .site-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      overflow: hidden;
      background: var(--background);
      pointer-events: none;
      /* Force a GPU layer so background never repaints during scroll */
      transform: translateZ(0);
      will-change: transform;
    }

    .grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      color: var(--grid);
      pointer-events: none;
      display: block;
    }

    .grid-base {
      opacity: 0.08;
    }

    .grid-spotlight {
      opacity: 0.35;
      mask-image: radial-gradient(
        320px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        black 0%,
        transparent 80%
      );
      -webkit-mask-image: radial-gradient(
        320px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        black 0%,
        transparent 80%
      );
      will-change: mask-image;
    }

    html.dark .grid-base {
      opacity: 0.10;
    }

    html.dark .grid-spotlight {
      opacity: 0.40;
    }


    /* ─────────────────────────────────────────────
       NAVBAR — Glow Menu (adapted from nav.md concept)
       ───────────────────────────────────────────── */
    .navbar {
      position: sticky;
      top: 1rem;
      z-index: 40;
      width: min(1120px, calc(100% - 2rem));
      margin: 1rem auto 0;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0.6rem 0.5rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: color-mix(in srgb, var(--background) 64%, transparent);
      backdrop-filter: blur(16px);
      box-shadow: 0 20px 50px rgba(0,0,0,0.12);
      position: relative;
      overflow: hidden;
      transition: border-color 0.3s ease;
    }

    /* Nav-wide glow — radial gradient overlay on hover */
    .navbar::before {
      content: '';
      position: absolute;
      inset: -12px;
      background: radial-gradient(
        circle at 50% 50%,
        rgba(59, 130, 246, 0.06) 0%,
        rgba(168, 85, 247, 0.04) 30%,
        rgba(239, 68, 68, 0.03) 60%,
        transparent 80%
      );
      opacity: 0;
      transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      border-radius: 28px;
      z-index: 0;
    }

    html.dark .navbar::before {
      background: radial-gradient(
        circle at 50% 50%,
        rgba(96, 165, 250, 0.10) 0%,
        rgba(192, 132, 252, 0.07) 30%,
        rgba(252, 129, 129, 0.05) 60%,
        transparent 80%
      );
    }

    .navbar:hover::before {
      opacity: 1;
    }

    .brand {
      position: relative;
      z-index: 1;
      padding-left: 0.5rem;
      color: var(--foreground);
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.04em;
      text-decoration: none;
    }

    .nav-tabs {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: center;
      gap: 0.2rem;
    }

    .nav-tab {
      position: relative;
      border: 1px solid transparent;
      border-radius: 12px;
      padding: 0;
      background: transparent;
      cursor: pointer;
      overflow: visible;
      perspective: 600px;
      -webkit-perspective: 600px;
    }

    /* ── Glow layer — scales 2× on hover (nav.md glowVariants) ── */
    .nav-tab-glow {
      position: absolute;
      inset: -4px;
      border-radius: 16px;
      opacity: 0;
      transform: scale(0.8);
      transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
      z-index: 0;
    }

    .nav-tab:hover .nav-tab-glow {
      opacity: 1;
      transform: scale(2);
    }

    /* Per-tab glow colours — blue, green, orange, red (nav.md menuItems.gradient) */
    .nav-tab:nth-child(1) .nav-tab-glow { background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%); }
    .nav-tab:nth-child(2) .nav-tab-glow { background: radial-gradient(circle, rgba(34,197,94,0.15) 0%, transparent 70%); }
    .nav-tab:nth-child(3) .nav-tab-glow { background: radial-gradient(circle, rgba(249,115,22,0.15) 0%, transparent 70%); }
    .nav-tab:nth-child(4) .nav-tab-glow { background: radial-gradient(circle, rgba(239,68,68,0.15) 0%, transparent 70%); }

    html.dark .nav-tab:nth-child(1) .nav-tab-glow { background: radial-gradient(circle, rgba(96,165,250,0.22) 0%, transparent 70%); }
    html.dark .nav-tab:nth-child(2) .nav-tab-glow { background: radial-gradient(circle, rgba(74,222,128,0.22) 0%, transparent 70%); }
    html.dark .nav-tab:nth-child(3) .nav-tab-glow { background: radial-gradient(circle, rgba(251,146,60,0.22) 0%, transparent 70%); }
    html.dark .nav-tab:nth-child(4) .nav-tab-glow { background: radial-gradient(circle, rgba(252,129,129,0.22) 0%, transparent 70%); }

    /* ── 3D flip faces (nav.md itemVariants / backVariants) ── */
    .nav-tab-face {
      display: block;
      padding: 0.5rem 0.85rem;
      border-radius: 12px;
      font: 600 0.875rem/1 var(--font-sans);
      color: var(--muted-foreground);
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      transform-style: preserve-3d;
      -webkit-transform-style: preserve-3d;
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                  color 0.2s ease;
    }

    .nav-tab-front {
      transform: rotateX(0deg);
      transform-origin: center bottom;
    }

    .nav-tab-back {
      position: absolute;
      inset: 0;
      padding: 0.5rem 0.85rem;
      transform: rotateX(90deg);
      transform-origin: center top;
      color: var(--foreground);
    }

    .nav-tab:hover .nav-tab-front {
      transform: rotateX(-90deg);
    }

    .nav-tab:hover .nav-tab-back {
      transform: rotateX(0deg);
    }

    .nav-tab:hover {
      color: var(--foreground);
    }

    /* ── Active (selected) tab — solid bg, no glow, no flip ── */
    .nav-tab.is-active {
      color: var(--primary-foreground);
      background: var(--primary);
      border-color: var(--primary-border-hover);
      box-shadow: 0 16px 36px -18px var(--shadow-primary);
    }

    .nav-tab.is-active .nav-tab-glow {
      display: none;
    }

    .nav-tab.is-active .nav-tab-face {
      color: var(--primary-foreground);
    }

    .nav-tab.is-active .nav-tab-back {
      display: none;
    }

    /* ── Theme toggle inside navbar ── */
    .nav-theme-toggle {
      position: relative;
      z-index: 1;
      width: 40px;
      height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--muted-foreground);
      cursor: pointer;
      transition: color 200ms ease, background 200ms ease, border-color 200ms ease, transform 200ms ease;
      font-size: 1.1rem;
      line-height: 1;
    }

    .nav-theme-toggle:hover {
      color: var(--foreground);
      background: var(--secondary);
      border-color: var(--primary-border-hover);
      transform: translateY(-1px);
    }

    .nav-theme-toggle:active {
      transform: scale(0.92);
    }

    .nav-theme-toggle .theme-icon {
      position: absolute;
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .nav-theme-toggle .moon-icon {
      opacity: 1;
    }

    .nav-theme-toggle .sun-icon {
      color: #eab308;
      opacity: 0;
      transform: rotate(-45deg);
    }

    html.dark .nav-theme-toggle .moon-icon {
      opacity: 0;
      transform: rotate(12deg);
    }

    html.dark .nav-theme-toggle .sun-icon {
      opacity: 1;
      transform: rotate(0deg);
    }

    @media (max-width: 720px) {
      .navbar {
        top: 0.75rem;
        grid-template-columns: 1fr auto;
        border-radius: 16px;
        padding: 0.5rem 0.6rem;
      }

      .nav-tabs {
        grid-column: 1 / -1;
        justify-content: flex-start;
        overflow-x: auto;
        padding: 0.15rem 0;
        gap: 0.15rem;
        -webkit-overflow-scrolling: touch;
      }

      .nav-tab {
        white-space: nowrap;
        padding: 0.4rem 0.7rem;
        font-size: 0.8rem;
      }

      .brand {
        font-size: 0.9rem;
        padding-left: 0.25rem;
      }

      .nav-theme-toggle {
        width: 36px;
        height: 36px;
        font-size: 1rem;
      }
    }

    /* ─────────────────────────────────────────────
       TAB PANELS
       ───────────────────────────────────────────── */
    .tab-panel {
      display: none;
      opacity: 0;
    }

    /* Animation lives on .is-active so it actually replays on each
       tab switch instead of running once against a display:none node. */
    .tab-panel.is-active {
      display: block;
      animation: panelIn 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes panelIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ─────────────────────────────────────────────
       BUTTONS
       ───────────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 44px;
      padding: 0.75rem 1.35rem;
      border-radius: 0.5rem;
      border: 2px solid transparent;
      font-weight: 650;
      text-decoration: none;
      cursor: pointer;
      transition:
        transform 180ms cubic-bezier(.2,.8,.2,1),
        background 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .btn:hover {
      transform: translateY(-4px) scale(1.05);
    }

    .btn:active {
      transform: translateY(0) scale(0.98);
    }

    .btn-primary {
      background: var(--primary);
      color: var(--primary-foreground);
      border: 1px solid var(--primary);
      border-radius: 10px;
      padding: 12px 24px;
      font-weight: 600;
      transition: all 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-primary:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 10px 30px -10px var(--shadow-primary);
    }

    .btn-secondary {
      background: transparent;
      color: var(--foreground);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 24px;
      font-weight: 600;
      transition: all 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-secondary:hover {
      border-color: var(--foreground);
      background: var(--secondary);
      transform: translateY(-1px);
    }

    /* ─────────────────────────────────────────────
       LAYOUT
       ───────────────────────────────────────────── */
    .app-shell {
      width: min(1120px, calc(100% - 2rem));
      margin: 0 auto;
      padding: clamp(3rem, 8vw, 6rem) 0 4rem;
    }

    .hero {
      min-height: calc(100vh - 120px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 6rem 0 4rem;
    }

    .stack-lg {
      display: grid;
      gap: 1.5rem;
    }

    .section-title {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 650;
      letter-spacing: -0.055em;
      text-align: center;
      margin-bottom: 0.6rem;
    }

    .section-sub {
      text-align: center;
      color: var(--muted-foreground);
      font-size: 1rem;
      max-width: 36rem;
      margin: 0 auto 2rem;
    }

    .muted {
      color: var(--muted-foreground);
    }

    /* Text hierarchy tiers */
    .text-primary    { color: var(--foreground); }
    .text-muted      { color: var(--muted-foreground); }
    .text-subtle     { color: var(--subtle-foreground); }
    .text-disabled   { color: var(--disabled-foreground); }

    .mono {
      font-family: var(--font-mono);
    }

    /* Monospace IDs (deepseek_v4_pro, baseline_cvss, dll) — subtle tier */
    .model-id-mono,
    code,
    .model-id,
    [class*="font-mono"] {
      color: var(--subtle-foreground);
      font-family: var(--font-mono);
    }

    /* Section descriptions / captions — muted tier */
    .section-subtitle,
    .card-subtitle,
    .caption {
      color: var(--muted-foreground);
    }

    /* Table headers (uppercase RANK, MODEL, SCORE) — muted tier */
    th,
    .table-header {
      color: var(--muted-foreground);
    }

    /* ─────────────────────────────────────────────
       HERO
       ───────────────────────────────────────────── */
    .hero-title {
      font-size: clamp(3.5rem, 10vw, 7rem);
      font-weight: 700;
      letter-spacing: -0.075em;
      line-height: 0.92;
      margin-bottom: 1.1rem;
    }

    .hero-subtitle {
      font-size: clamp(1.05rem, 2vw, 1.3rem);
      color: var(--muted-foreground);
      font-weight: 500;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }

    .hero-desc {
      font-size: 1.02rem;
      color: var(--muted-foreground);
      max-width: 44rem;
      margin: 0 auto;
    }

    .beta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.42rem 0.95rem;
      background: var(--secondary);
      color: var(--primary);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 1.75rem;
      backdrop-filter: blur(8px);
    }

    .pulse-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--primary);
      box-shadow: 0 0 0 0 var(--primary);
      animation: pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(128, 128, 128, 0.50); }
      70%  { box-shadow: 0 0 0 9px rgba(128, 128, 128, 0); }
      100% { box-shadow: 0 0 0 0 rgba(128, 128, 128, 0); }
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-top: 2.25rem;
    }

    .meta-pills {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 2.25rem;
    }

    .meta-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.42rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted-foreground);
      background: var(--card);
      backdrop-filter: blur(10px);
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .meta-pill:hover {
      border-color: var(--primary-border-hover);
      color: var(--foreground);
    }

    .meta-pill svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    /* ─────────────────────────────────────────────
       CARD
       ───────────────────────────────────────────── */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      backdrop-filter: blur(12px);
      transition: border-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
                  transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .card:hover {
      border-color: var(--foreground);
      transform: translateY(-1px);
    }

    .card-strong {
      background: var(--card-strong);
    }

    .metric-card {
      padding: 1.25rem;
    }

    .metric-value {
      font-size: clamp(2rem, 5vw, 3.75rem);
      font-weight: 650;
      letter-spacing: -0.06em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      color: var(--foreground);
    }

    .metric-label {
      margin-top: 0.75rem;
      color: var(--muted-foreground);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    /* ─────────────────────────────────────────────
       DIMENSION CARD GRID — judge rubric explainer
       Used above the LLM Rankings table (inline legend)
       and inside Methodology > How We Score (replaces bullets).
       ───────────────────────────────────────────── */
    .dim-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.75rem;
    }

    @media (max-width: 900px) {
      .dim-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 520px) {
      .dim-grid { grid-template-columns: 1fr; }
    }

    .dim-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1rem 1.1rem;
      backdrop-filter: blur(10px);
      transition: border-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
                  transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .dim-card:hover {
      border-color: var(--foreground);
      transform: translateY(-1px);
    }

    .dim-card-header {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 0.55rem;
    }

    .dim-card-icon {
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--secondary);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--foreground);
      flex-shrink: 0;
    }

    .dim-card-icon svg {
      width: 14px;
      height: 14px;
    }

    .dim-card-title {
      flex: 1;
      font-size: 0.92rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--foreground);
    }

    .dim-card-weight {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--muted-foreground);
      white-space: nowrap;
    }

    .dim-card-desc {
      font-size: 0.82rem;
      line-height: 1.45;
      color: var(--muted-foreground);
    }

    /* 5-column variant used by the Pass 1 dimension grid. */
    .dim-grid--5 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    @media (max-width: 1100px) {
      .dim-grid--5 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @media (max-width: 760px) {
      .dim-grid--5 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 520px) {
      .dim-grid--5 { grid-template-columns: 1fr; }
    }

    /* "How We Score" — Pass 1 / Pass 2 sub-section structure. */
    .method-panel .pass-section {
      margin-top: 1.6rem;
    }

    .method-panel .pass-section:first-of-type {
      margin-top: 0.5rem;
    }

    .method-panel .pass-title {
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--foreground);
      margin-bottom: 0.3rem;
    }

    .method-panel .pass-title .pass-weight {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted-foreground);
      font-weight: 500;
      margin-left: 0.6rem;
      vertical-align: middle;
    }

    .method-panel .pass-desc {
      font-size: 0.88rem;
      color: var(--muted-foreground);
      margin-bottom: 0.85rem;
      max-width: 60ch;
    }

    .method-panel .pass-footnote {
      margin-top: 0.5rem;
      font-size: 0.82rem;
      color: var(--muted-foreground);
      padding-left: 0.85rem;
      border-left: 2px solid var(--border);
      max-width: 60ch;
    }

    /* ─────────────────────────────────────────────
       OVERVIEW — Question callout + Differentiators + Flow
       Three sections rendered between the hero and the stats grid.
       ───────────────────────────────────────────── */

    /* "The question we measure" — stat pill + pull-quote body */
    .question-callout {
      max-width: 56rem;
      margin: 0 auto 6rem;
      padding: 0 1rem;
      text-align: center;
    }

    .question-callout-stat-wrap {
      display: inline-flex;
      align-items: baseline;
      gap: 0.7rem;
      margin-bottom: 1.5rem;
      padding: 0.55rem 1.25rem;
      background: var(--secondary);
      border: 1px solid var(--border);
      border-radius: 999px;
      backdrop-filter: blur(8px);
    }

    .question-callout-stat {
      font-family: var(--font-mono);
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.04em;
      color: var(--foreground);
      line-height: 1;
    }

    .question-callout-stat-label {
      font-size: 0.78rem;
      color: var(--muted-foreground);
      letter-spacing: -0.005em;
    }

    .question-callout-body {
      font-size: clamp(1.15rem, 2.3vw, 1.45rem);
      line-height: 1.55;
      letter-spacing: -0.018em;
      color: var(--foreground);
      font-weight: 450;
      margin: 0 auto 1.1rem;
      max-width: 50rem;
    }

    .question-callout-body strong {
      color: var(--foreground);
      font-weight: 650;
    }

    .question-callout-source {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--subtle-foreground);
      margin: 0;
    }

    /* Shared "eyebrow + title" heading for the differentiator and flow sections */
    .section-eyebrow-heading {
      text-align: center;
      margin-bottom: 1.85rem;
    }

    .section-eyebrow {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted-foreground);
      margin-bottom: 0.55rem;
    }

    .section-eyebrow-title {
      font-size: clamp(1.65rem, 3.5vw, 2.25rem);
      font-weight: 650;
      letter-spacing: -0.04em;
      color: var(--foreground);
      max-width: 38rem;
      margin: 0 auto;
      line-height: 1.15;
    }

    /* "What makes this benchmark different" — 3 differentiator cards */
    .diff-section { margin-bottom: 6rem; }

    .diff-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    @media (max-width: 900px) {
      .diff-grid { grid-template-columns: 1fr; }
    }

    .diff-card {
      position: relative;
      background: var(--card-strong);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 1.75rem 1.65rem 1.5rem;
      backdrop-filter: blur(16px);
      transition: border-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
                  transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .diff-card:hover {
      border-color: var(--foreground);
      transform: translateY(-3px);
      box-shadow: 0 24px 50px -28px var(--shadow-secondary);
    }

    .diff-card-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      background: var(--secondary);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--foreground);
      margin-bottom: 1.1rem;
    }

    .diff-card-icon svg { width: 18px; height: 18px; }

    .diff-card-title {
      font-size: 1.1rem;
      font-weight: 650;
      letter-spacing: -0.025em;
      color: var(--foreground);
      margin-bottom: 0.6rem;
      line-height: 1.25;
    }

    .diff-card-body {
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--muted-foreground);
      margin: 0;
    }

    .diff-card-body code {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      padding: 0.08rem 0.35rem;
      background: var(--secondary);
      border-radius: 4px;
      color: var(--foreground);
    }

    .diff-card-body strong { color: var(--foreground); font-weight: 600; }

    /* Architecture flow — Trivy scan → LLM → Grader → Score */
    .flow-section { margin-bottom: 6rem; }

    .flow-frame {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 1.65rem 1.25rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      backdrop-filter: blur(12px);
    }

    .flow-node {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.7rem 1rem;
      background: var(--card-strong);
      border: 1px solid var(--border);
      border-radius: 12px;
      transition: border-color 220ms ease, transform 220ms ease;
    }

    .flow-node:hover {
      border-color: var(--foreground);
      transform: translateY(-1px);
    }

    .flow-node-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      background: var(--secondary);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--foreground);
      flex-shrink: 0;
    }

    .flow-node-icon svg { width: 14px; height: 14px; }

    .flow-node-text {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    .flow-node-label {
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--foreground);
    }

    .flow-node-sub {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      color: var(--muted-foreground);
      margin-top: 0.15rem;
    }

    .flow-arrow {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      line-height: 1;
      color: var(--subtle-foreground);
      padding: 0 0.15rem;
      user-select: none;
    }

    @media (max-width: 720px) {
      .flow-frame { flex-direction: column; }
      .flow-arrow { transform: rotate(90deg); }
    }

    /* ─────────────────────────────────────────────
       STATS GRID
       ───────────────────────────────────────────── */
    .stats-section { margin-bottom: 6rem; }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    @media (max-width: 900px) {
      .metrics-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 520px) {
      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }

    .stat {
      cursor: default;
    }

    /* ─────────────────────────────────────────────
       LEADERBOARD TABLE
       ───────────────────────────────────────────── */
    .leaderboard-section { margin-bottom: 5rem; }

    .leaderboard {
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: var(--card);
      backdrop-filter: blur(16px);
    }

    .lb-header {
      padding: 1.6rem 1.75rem 1rem;
      border-bottom: 1px solid var(--border);
    }

    .lb-header h2 {
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--foreground);
    }

    .lb-note {
      font-size: 0.8rem;
      color: var(--muted-foreground);
      margin-top: 0.35rem;
    }

    .lb-wrap { overflow-x: auto; }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      text-align: left;
      padding: 0.95rem 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    thead th:first-child { padding-left: 1.75rem; }
    thead th:last-child  { padding-right: 1.75rem; }

    tbody td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
      color: var(--foreground);
      font-variant-numeric: tabular-nums;
    }
    tbody td:first-child { padding-left: 1.75rem; }
    tbody td:last-child  { padding-right: 1.75rem; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr {
      cursor: pointer;
      transition: background 0.2s ease;
    }
    tbody tr:hover { background: rgba(128, 128, 128, 0.04); }

    .rank-cell { width: 4rem; }

    .rank-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 500;
      color: var(--muted-foreground);
      background: var(--secondary);
      border: 1px solid var(--border);
      font-variant-numeric: tabular-nums;
    }

    .rank-pill.rank-1 {
      color: #ffffff;
      background: var(--primary);
      border-color: var(--primary-border-hover);
      box-shadow: 0 0 16px -2px rgba(128, 128, 128, 0.35);
    }

    .rank-pill.rank-2 {
      color: var(--foreground);
      border-color: rgba(160, 160, 160, 0.30);
      background: linear-gradient(135deg, rgba(160, 160, 160, 0.12) 0%, rgba(160, 160, 160, 0.03) 100%);
    }

    .rank-pill.rank-3 {
      color: var(--primary);
      border-color: rgba(160, 160, 160, 0.30);
      background: linear-gradient(135deg, rgba(160, 160, 160, 0.10) 0%, rgba(160, 160, 160, 0.03) 100%);
    }

    .model-name-cell {
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--foreground);
    }

    .model-id-mono {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--muted-foreground);
      font-weight: 400;
      display: block;
      margin-top: 0.28rem;
    }

    .score-cell {
      font-family: var(--font-mono);
      font-weight: 500;
      color: var(--foreground);
    }

    .score-bar-wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
    }

    .score-bar {
      display: inline-block;
      height: 5px;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--primary-hover), var(--primary));
      max-width: 70px;
    }

    .cost-cell {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--muted-foreground);
    }

    /* ─────────────────────────────────────────────
       BRAND COLOR ACCENTS — Patch v5
       Colors are constant across light/dark themes.
       Applied ONLY to LLM rows (not baselines).
       ───────────────────────────────────────────── */

    /* Row left border identity stripe */
    .leaderboard tbody tr {
      border-left: 3px solid transparent;
      transition: border-left-color 200ms ease, background 200ms ease;
    }

    .leaderboard tbody tr[data-model="deepseek"] { border-left-color: var(--brand-deepseek); }
    .leaderboard tbody tr[data-model="claude"]   { border-left-color: var(--brand-claude); }
    .leaderboard tbody tr[data-model="kimi"]     { border-left-color: var(--brand-kimi); }
    .leaderboard tbody tr[data-model="qwen"]     { border-left-color: var(--brand-qwen); }

    /* Hover: brand-tinted background */
    .leaderboard tbody tr[data-model="deepseek"]:hover { background: var(--brand-deepseek-soft); }
    .leaderboard tbody tr[data-model="claude"]:hover   { background: var(--brand-claude-soft); }
    .leaderboard tbody tr[data-model="kimi"]:hover     { background: var(--brand-kimi-soft); }
    .leaderboard tbody tr[data-model="qwen"]:hover     { background: var(--brand-qwen-soft); }

    /* Rank pill — brand colored (overrides rank-1/2/3 monochrome) */
    tr[data-model="deepseek"] .rank-pill {
      background: var(--brand-deepseek);
      border-color: var(--brand-deepseek);
      color: #ffffff;
      box-shadow: 0 0 14px -2px rgba(77, 107, 254, 0.45);
    }
    tr[data-model="claude"] .rank-pill {
      background: var(--brand-claude);
      border-color: var(--brand-claude);
      color: #ffffff;
      box-shadow: 0 0 14px -2px rgba(217, 119, 87, 0.45);
    }
    tr[data-model="kimi"] .rank-pill {
      background: var(--brand-kimi);
      border-color: var(--brand-kimi);
      color: #ffffff;
      box-shadow: 0 0 14px -2px rgba(16, 185, 129, 0.45);
    }
    tr[data-model="qwen"] .rank-pill {
      background: var(--brand-qwen);
      border-color: var(--brand-qwen);
      color: #ffffff;
      box-shadow: 0 0 14px -2px rgba(236, 72, 153, 0.45);
    }

    /* Score bar — brand gradient */
    tr[data-model="deepseek"] .score-bar { background: linear-gradient(90deg, rgba(77,107,254,0.6), var(--brand-deepseek)); }
    tr[data-model="claude"]   .score-bar { background: linear-gradient(90deg, rgba(217,119,87,0.6), var(--brand-claude)); }
    tr[data-model="kimi"]     .score-bar { background: linear-gradient(90deg, rgba(16,185,129,0.6), var(--brand-kimi)); }
    tr[data-model="qwen"]     .score-bar { background: linear-gradient(90deg, rgba(236,72,153,0.6), var(--brand-qwen)); }

    /* Brand dot — mini-lb and other inline accents */
    .brand-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
      flex-shrink: 0;
    }

    [data-model="deepseek"] .brand-dot { background: var(--brand-deepseek); box-shadow: 0 0 6px rgba(77,107,254,0.5); }
    [data-model="claude"]   .brand-dot { background: var(--brand-claude);   box-shadow: 0 0 6px rgba(217,119,87,0.5); }
    [data-model="kimi"]     .brand-dot { background: var(--brand-kimi);     box-shadow: 0 0 6px rgba(16,185,129,0.5); }
    [data-model="qwen"]     .brand-dot { background: var(--brand-qwen);     box-shadow: 0 0 6px rgba(236,72,153,0.5); }

    .trunc-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-family: var(--font-mono);
      margin-left: 0.55rem;
      white-space: nowrap;
      vertical-align: middle;

      /* Amber soft — warm warning, not harsh */
      background: rgba(251, 191, 36, 0.10);
      border: 1px solid rgba(251, 191, 36, 0.30);
      color: #D97706;
    }

    html.dark .trunc-badge {
      background: rgba(251, 191, 36, 0.08);
      border: 1px solid rgba(251, 191, 36, 0.25);
      color: #FBBF24;
    }

    .trunc-badge::before {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
      display: inline-block;
    }

    .trunc-note {
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.4;
      color: rgba(217, 119, 6, 0.85);
      margin-top: 0.5rem;
      max-width: 32ch;
    }

    html.dark .trunc-note {
      color: rgba(251, 191, 36, 0.75);
    }

    /* ── Error badge (API errors — red) ── */
    .err-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-family: var(--font-mono);
      margin-left: 0.55rem;
      white-space: nowrap;
      vertical-align: middle;
      background: rgba(239, 68, 68, 0.10);
      border: 1px solid rgba(239, 68, 68, 0.30);
      color: #DC2626;
    }

    html.dark .err-badge {
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.25);
      color: #FCA5A5;
    }

    .err-badge::before {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
      display: inline-block;
    }

    .err-note {
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.4;
      color: rgba(220, 38, 38, 0.85);
      margin-top: 0.5rem;
      max-width: 40ch;
    }

    html.dark .err-note {
      color: rgba(252, 165, 165, 0.75);
    }

    /* ── Skip badge (context overflow — gray) ── */
    .skip-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-family: var(--font-mono);
      margin-left: 0.55rem;
      white-space: nowrap;
      vertical-align: middle;
      background: rgba(156, 163, 175, 0.10);
      border: 1px solid rgba(156, 163, 175, 0.30);
      color: #6B7280;
    }

    html.dark .skip-badge {
      background: rgba(156, 163, 175, 0.08);
      border: 1px solid rgba(156, 163, 175, 0.25);
      color: #D1D5DB;
    }

    .skip-badge::before {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
      display: inline-block;
    }

    .skip-note {
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.4;
      color: rgba(107, 114, 128, 0.85);
      margin-top: 0.5rem;
      max-width: 40ch;
    }

    html.dark .skip-note {
      color: rgba(209, 213, 219, 0.75);
    }

    th.has-tooltip {
      cursor: help;
      text-decoration: underline dotted;
      text-decoration-color: var(--muted-foreground);
      text-underline-offset: 4px;
    }

    /* ─────────────────────────────────────────────
       BASELINE
       ───────────────────────────────────────────── */
    .divider {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin: 2.5rem 0 1.85rem;
    }

    .divider::before, .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }

    .divider span {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.42rem 0.95rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted-foreground);
      background: var(--secondary);
      border: 1px solid var(--border);
      border-radius: 999px;
    }

    /* ─────────────────────────────────────────────
       CHARTS
       ───────────────────────────────────────────── */
    .charts-section { margin-bottom: 4.5rem; }

    .charts-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 0.65rem;
      background: var(--card);
      backdrop-filter: blur(16px);
      overflow: hidden;
    }

    .charts-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem;
    }

    @media (max-width: 900px) {
      .charts-inner { grid-template-columns: 1fr; }
    }

    .chart-card {
      background: var(--card-strong);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.45rem 1.5rem 1.2rem;
    }

    .chart-card h3 {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 500;
      color: var(--muted-foreground);
      margin-bottom: 0.35rem;
    }

    .chart-sub {
      font-size: 0.78rem;
      color: var(--muted-foreground);
      margin-bottom: 1.15rem;
    }

    .chart-card canvas { max-height: 340px; }

    .chart-fallback {
      display: none;
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--muted-foreground);
      font-size: 0.85rem;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
    }
    .chart-fallback.visible { display: block; }

    .baseline-chart-frame .charts-inner {
      grid-template-columns: 1fr;
    }
    .baseline-chart-frame canvas { max-height: 240px; }

    /* ─────────────────────────────────────────────
       DISCLAIMER
       ───────────────────────────────────────────── */
    .disclaimer {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: rgba(128, 128, 128, 0.08);
      border: 1px solid rgba(128, 128, 128, 0.25);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.35rem;
      margin-bottom: 1.5rem;
    }

    .disclaimer.is-dismissed { display: none; }

    .disclaimer-icon {
      width: 30px; height: 30px;
      border-radius: 50%;
      background: rgba(128, 128, 128, 0.16);
      color: var(--primary);
      border: 1px solid rgba(128, 128, 128, 0.35);
      font-family: var(--font-mono);
      font-size: 0.92rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .disclaimer-body {
      flex: 1;
      color: var(--foreground);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .disclaimer-body strong { color: var(--primary); }

    .disclaimer-close {
      background: transparent;
      border: none;
      color: var(--muted-foreground);
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      padding: 0 0.35rem;
      font-family: inherit;
      transition: color 0.2s ease;
    }
    .disclaimer-close:hover { color: var(--foreground); }

    /* ─────────────────────────────────────────────
       MODEL CHIPS
       ───────────────────────────────────────────── */
    .model-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: 2rem;
    }

    .chip {
      padding: 0.6rem 1.15rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--card);
      color: var(--muted-foreground);
      font-family: var(--font-sans);
      font-size: 0.84rem;
      font-weight: 500;
      cursor: pointer;
      backdrop-filter: blur(10px);
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .chip:hover {
      border-color: var(--primary-border-hover);
      color: var(--foreground);
    }

    .chip.is-active {
      color: var(--primary-foreground);
      background: var(--primary);
      border-color: var(--primary-border-hover);
      box-shadow: 0 16px 36px -18px var(--shadow-primary);
    }

    .model-panel {
      display: none;
    }

    .model-panel.is-active {
      display: block;
      animation: panelIn 220ms ease both;
    }

    /* ─────────────────────────────────────────────
       MODEL CARD (drill-down)
       ───────────────────────────────────────────── */
    .model-card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 1.65rem;
      backdrop-filter: blur(16px);
      transition: border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
      overflow: hidden;
      max-width: 600px;
      margin: 0 auto;
    }

    .model-card:hover {
      border-color: var(--primary-border-hover);
      transform: translateY(-2px);
    }

    .model-card--baseline {
      border-color: rgba(128, 128, 128, 0.25);
    }

    .model-card--baseline:hover {
      border-color: rgba(128, 128, 128, 0.50);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 1.4rem;
      flex-wrap: wrap;
    }

    .card-header .rank-pill { flex-shrink: 0; }

    .model-name {
      flex: 1;
      min-width: 0;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--foreground);
    }

    .type-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.22rem 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 500;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      flex-shrink: 0;
    }

    .type-llm {
      background: rgba(128, 128, 128, 0.10);
      color: var(--primary);
      border: 1px solid rgba(128, 128, 128, 0.30);
    }

    .type-baseline {
      background: rgba(128, 128, 128, 0.12);
      color: var(--muted-foreground);
      border: 1px solid rgba(128, 128, 128, 0.34);
    }

    .card-score { text-align: center; margin-bottom: 1.4rem; }

    .score-value {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: clamp(2.4rem, 3.5vw, 2.85rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      color: var(--foreground);
    }

    .score-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
      margin-top: 0.55rem;
      font-weight: 500;
    }

    .card-dims {
      width: 100%;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }

    .card-dims caption {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
      margin-bottom: 0.65rem;
      text-align: left;
      font-weight: 500;
    }

    .card-dims thead { display: none; }

    .card-dims th, .card-dims td {
      padding: 0.42rem 0;
      border: none;
    }

    .card-dims th {
      color: var(--muted-foreground);
      font-weight: 400;
      width: 50%;
      text-align: left;
      font-size: 0.82rem;
      text-transform: capitalize;
    }

    .bar-wrapper {
      position: relative;
      height: 1.1rem;
      background: var(--secondary);
      border-radius: 999px;
      overflow: hidden;
    }

    .bar-fill {
      position: absolute;
      top: 0; left: 0;
      height: 100%;
      background: linear-gradient(90deg, var(--primary-hover), var(--primary));
      border-radius: 999px;
      transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .bar-label {
      position: relative;
      display: block;
      padding: 0 0.55rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 400;
      line-height: 1.1rem;
      white-space: nowrap;
      color: var(--foreground);
    }

    .card-cost {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }

    .cost-label {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
    }

    .cost-value {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--foreground);
      font-variant-numeric: tabular-nums;
    }

    /* ─────────────────────────────────────────────
       METHODOLOGY ACCORDION
       ───────────────────────────────────────────── */
    .method-frame {
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 0.55rem;
      background: var(--card);
      backdrop-filter: blur(16px);
    }

    .method-inner {
      background: var(--card-strong);
      border-radius: calc(var(--radius-xl) - 5px);
      padding: 2rem clamp(1.25rem, 4vw, 3rem);
    }

    .method-panel h3 {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
      color: var(--foreground);
    }

    .method-panel p {
      color: var(--foreground);
      font-size: 0.95rem;
      max-width: 60ch;
      margin-bottom: 0.65rem;
    }

    .method-panel p:last-child { margin-bottom: 0; }

    .method-panel ul {
      list-style: none;
      padding: 0;
      color: var(--foreground);
      font-size: 0.93rem;
    }

    .method-panel ul > li {
      padding-left: 1.15rem;
      position: relative;
      margin-bottom: 0.5rem;
    }

    .method-panel ul > li::before {
      content: "—";
      position: absolute; left: 0;
      color: var(--primary);
    }

    .method-panel ul ul {
      margin-top: 0.4rem;
      margin-left: 0.4rem;
      font-size: 0.88rem;
    }

    .method-panel ul ul > li::before { content: "·"; color: var(--muted-foreground); }

    .method-panel strong { color: var(--foreground); font-weight: 600; }

    .method-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .method-tab {
      padding: 0.55rem 1.2rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--card);
      color: var(--muted-foreground);
      font-family: var(--font-sans);
      font-size: 0.84rem;
      font-weight: 500;
      cursor: pointer;
      backdrop-filter: blur(10px);
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .method-tab:hover {
      border-color: var(--primary-border-hover);
      color: var(--foreground);
    }

    .method-tab.selected,
    .method-tab[aria-selected="true"] {
      color: var(--primary-foreground);
      background: var(--primary);
      border-color: var(--primary-border-hover);
      box-shadow: 0 16px 36px -18px var(--shadow-primary);
    }

    .method-panel { display: none; }
    .method-panel.active { display: block; animation: fadeIn 0.3s ease; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ─────────────────────────────────────────────
       MINI LEADERBOARD (Overview tab)
       ───────────────────────────────────────────── */
    .mini-lb { margin-bottom: 2rem; }

    .mini-lb-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border);
    }

    .mini-lb-item:last-child { border-bottom: none; }

    .mini-lb-rank {
      width: 2rem;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--muted-foreground);
    }

    .mini-lb-name {
      flex: 1;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--foreground);
    }

    .mini-lb-score {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--foreground);
    }

    /* ─────────────────────────────────────────────
       FOOTER
       ───────────────────────────────────────────── */
    footer {
      margin-top: 5rem;
      padding: 3rem 0 2.5rem;
      text-align: center;
      color: var(--muted-foreground);
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }

    footer::before {
      content: "";
      display: block;
      width: 80%;
      margin: 0 auto 2rem;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }

    .footer-mark {
      font-size: 0.68rem;
      color: var(--muted-foreground);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .footer-mark a:hover { color: var(--primary); }

    /* ─────────────────────────────────────────────
       SCROLL REVEAL
       ───────────────────────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--reveal-delay, 0ms);
      will-change: opacity, transform;
    }

    .reveal.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
</head>
<body>

  {# ── Reusable dimension-card grid ──
     Rendered above the LLM Rankings table (Leaderboard tab) and inside
     the Methodology > How We Score panel. Edit copy here once and both
     surfaces stay in sync. #}
  {% macro dim_cards() %}
  <div class="dim-grid">
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>
        </span>
        <span class="dim-card-title">Reachability</span>
        <span class="dim-card-weight">/ 25</span>
      </div>
      <div class="dim-card-desc">Did the model use the deployment context to judge real exploitability, or just echo CVSS?</div>
    </div>
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/><path d="M11 12h4"/><path d="M11 16h7"/><path d="M11 20h10"/></svg>
        </span>
        <span class="dim-card-title">Prioritization</span>
        <span class="dim-card-weight">/ 25</span>
      </div>
      <div class="dim-card-desc">Are findings ranked by the right urgency, not just severity?</div>
    </div>
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </span>
        <span class="dim-card-title">Actionability</span>
        <span class="dim-card-weight">/ 25</span>
      </div>
      <div class="dim-card-desc">Are recommendations specific enough to actually execute?</div>
    </div>
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/></svg>
        </span>
        <span class="dim-card-title">Conciseness</span>
        <span class="dim-card-weight">/ 25</span>
      </div>
      <div class="dim-card-desc">Is the response tight, or padded with caveats?</div>
    </div>
  </div>
  {% endmacro %}

  {# ── Pass 1 deterministic dimensions (5 cards) ──
     Used only inside Methodology > How We Score; the Leaderboard table
     columns are judge-only, so its inline legend stays as dim_cards(). #}
  {% macro dim_cards_pass1() %}
  <div class="dim-grid dim-grid--5">
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/></svg>
        </span>
        <span class="dim-card-title">Format</span>
        <span class="dim-card-weight">/ 10</span>
      </div>
      <div class="dim-card-desc">Is the output valid JSON matching the VEX schema?</div>
    </div>
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
        </span>
        <span class="dim-card-title">Coverage</span>
        <span class="dim-card-weight">/ 30</span>
      </div>
      <div class="dim-card-desc">Did the model address every CVE from the scan?</div>
    </div>
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 12.5-8 8a2.119 2.119 0 1 1-3-3l8-8"/><path d="m16 16 6-6"/><path d="m8 8 6-6"/><path d="m9 7 8 8"/><path d="m21 11-8-8"/></svg>
        </span>
        <span class="dim-card-title">Verdict</span>
        <span class="dim-card-weight">/ 30</span>
      </div>
      <div class="dim-card-desc">How accurate are the affected / not-affected calls vs ground truth?</div>
    </div>
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="m21 8-4-4-4 4"/><path d="M17 4v16"/></svg>
        </span>
        <span class="dim-card-title">Priority</span>
        <span class="dim-card-weight">/ 20</span>
      </div>
      <div class="dim-card-desc">How accurate is the P0–P3 ordering vs ground truth?</div>
    </div>
    <div class="dim-card">
      <div class="dim-card-header">
        <span class="dim-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 6H3"/><path d="M10 12H3"/><path d="M10 18H3"/><circle cx="17" cy="15" r="3"/><path d="m21 19-1.9-1.9"/></svg>
        </span>
        <span class="dim-card-title">Regex</span>
        <span class="dim-card-weight">/ 10</span>
      </div>
      <div class="dim-card-desc">Does the response mention keywords a good answer should include?</div>
    </div>
  </div>
  {% endmacro %}

  <!-- ── Site Background: Infinite SVG Grid + Spotlight + Orbs ── -->
  <div class="site-bg" aria-hidden="true">
    <svg class="grid grid-base" aria-hidden="true"
         width="100%" height="100%">
      <defs>
        <pattern id="gridPatternBase" width="40" height="40" patternUnits="userSpaceOnUse" x="0" y="0">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#gridPatternBase)"></rect>
    </svg>

    <svg class="grid grid-spotlight" aria-hidden="true"
         width="100%" height="100%">
      <defs>
        <pattern id="gridPatternSpotlight" width="40" height="40" patternUnits="userSpaceOnUse" x="0" y="0">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#gridPatternSpotlight)"></rect>
    </svg>

  </div>

  <!-- ── Navbar (Glow Menu — adapted from nav.md) ── -->
  <header class="navbar">
    <a class="brand" href="#">evalsec.</a>

    <nav class="nav-tabs" aria-label="Primary navigation">
      <button class="nav-tab is-active" data-tab="overview">
        <span class="nav-tab-glow"></span>
        <span class="nav-tab-face nav-tab-front">Overview</span>
        <span class="nav-tab-face nav-tab-back">Overview</span>
      </button>
      <button class="nav-tab" data-tab="leaderboard">
        <span class="nav-tab-glow"></span>
        <span class="nav-tab-face nav-tab-front">Leaderboard</span>
        <span class="nav-tab-face nav-tab-back">Leaderboard</span>
      </button>
      <button class="nav-tab" data-tab="models">
        <span class="nav-tab-glow"></span>
        <span class="nav-tab-face nav-tab-front">Models</span>
        <span class="nav-tab-face nav-tab-back">Models</span>
      </button>
      <button class="nav-tab" data-tab="methodology">
        <span class="nav-tab-glow"></span>
        <span class="nav-tab-face nav-tab-front">Methodology</span>
        <span class="nav-tab-face nav-tab-back">Methodology</span>
      </button>
    </nav>

    <button class="nav-theme-toggle" id="themeToggle" aria-label="Toggle theme">
      <span class="theme-icon moon-icon">☾</span>
      <span class="theme-icon sun-icon">☀</span>
    </button>
  </header>

  <!-- ── Main Content ── -->
  <main class="app-shell">

    <!-- ════════════════════════════════════════
         TAB 1: OVERVIEW
         ════════════════════════════════════════ -->
    <section id="overview" class="tab-panel is-active">

      <div class="hero">
        <span class="beta-pill">
          <span class="pulse-dot"></span>
          BETA · v0.1.0
        </span>

        <h1 class="hero-title">evalsec.</h1>
        <p class="hero-subtitle">DevSecOps LLM Benchmark</p>
        <p class="hero-desc">
          Measuring how well LLMs triage real container vulnerability scans using deployment context, not just CVSS.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#" data-tab-link="leaderboard">View Leaderboard</a>
          <a class="btn btn-secondary" href="#" data-tab-link="methodology">Read Methodology</a>
        </div>

        <div class="meta-pills">
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            <time id="graded-at-display" datetime="{{ graded_at }}">{{ graded_at }}</time>
          </span>
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            task: {{ task }}
          </span>
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
            judge: Claude Opus 4.7
          </span>
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            {{ response_count }} responses
          </span>
        </div>
      </div>

      <!-- ── The question we measure (pull-quote callout) ── -->
      <section class="question-callout reveal">
        <span class="question-callout-stat-wrap">
          <span class="question-callout-stat">~2%</span>
          <span class="question-callout-stat-label">of published CVEs are ever exploited in the wild</span>
        </span>
        <p class="question-callout-body">
          Yet most container scanners rank findings by CVSS and ask you to patch them all.
          <strong>evalsec</strong> measures whether an LLM can do what a senior DevSecOps engineer does:
          read the scan, read the deployment context, and decide which findings actually need a
          3am page — and which can wait for the next dependency cycle.
        </p>
        <p class="question-callout-source">Source: Cyentia Institute / EPSS exploitability research · CISA KEV catalog</p>
      </section>

      <!-- ── What makes this benchmark different (3 differentiator cards) ── -->
      <section class="diff-section reveal">
        <div class="section-eyebrow-heading">
          <span class="section-eyebrow">What makes this different</span>
          <h2 class="section-eyebrow-title">Three things most LLM benchmarks don't do.</h2>
        </div>

        <div class="diff-grid">
          <article class="diff-card">
            <div class="diff-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 7.7c0-.6-.4-1.2-.8-1.5l-6.3-3.9a1.72 1.72 0 0 0-1.7 0l-10.3 6c-.5.2-.9.8-.9 1.4v6.6c0 .5.4 1.2.8 1.5l6.3 3.9a1.72 1.72 0 0 0 1.7 0l10.3-6c.5-.3.9-1 .9-1.5Z"/><path d="M10 21.9V14L2.1 9.1"/><path d="m10 14 11.9-6.9"/><path d="M14 19.8v-8.1"/><path d="M18 17.5V9.4"/></svg>
            </div>
            <h3 class="diff-card-title">Verbatim Trivy output</h3>
            <p class="diff-card-body">
              Every case starts with raw scan output from a real container — <code>nginx</code>,
              <code>redis</code>, <code>postgres</code>, <code>vault</code>, <code>ghost</code>.
              Not curated CVE lists, not synthetic findings, not "Imagine a Log4j vulnerability."
              The same noise a model would see if you piped Trivy into a prompt today.
            </p>
          </article>

          <article class="diff-card">
            <div class="diff-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
            </div>
            <h3 class="diff-card-title">Context, not severity</h3>
            <p class="diff-card-body">
              Every case ships with a <code>stack_context</code> block: network exposure, runtime
              hardening (seccomp, read-only rootfs, non-root), call-graph reachability, regulatory
              framework. The model has to use it. A CRITICAL CVE in dead code should come back
              <strong>not_affected</strong> — not P0.
            </p>
          </article>

          <article class="diff-card">
            <div class="diff-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            </div>
            <h3 class="diff-card-title">Real floors, not just LLMs</h3>
            <p class="diff-card-body">
              Four non-LLM baselines (CVSS sort, EPSS sort, Trivy severity, reachability heuristic)
              share the leaderboard. The honest question: is the LLM actually beating
              <code>sort -k severity</code>, or is it expensive theatre?
            </p>
          </article>
        </div>
      </section>

      <!-- ── Architecture flow — from container scan to score ── -->
      <section class="flow-section reveal">
        <div class="section-eyebrow-heading">
          <span class="section-eyebrow">How a run works</span>
          <h2 class="section-eyebrow-title">From container scan to composite score.</h2>
        </div>

        <div class="flow-frame">
          <div class="flow-node">
            <span class="flow-node-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
            </span>
            <span class="flow-node-text">
              <span class="flow-node-label">Trivy scan</span>
              <span class="flow-node-sub">+ stack context</span>
            </span>
          </div>
          <span class="flow-arrow" aria-hidden="true">&rarr;</span>
          <div class="flow-node">
            <span class="flow-node-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
            </span>
            <span class="flow-node-text">
              <span class="flow-node-label">LLM triage</span>
              <span class="flow-node-sub">VEX JSON</span>
            </span>
          </div>
          <span class="flow-arrow" aria-hidden="true">&rarr;</span>
          <div class="flow-node">
            <span class="flow-node-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 12.5-8 8a2.119 2.119 0 1 1-3-3l8-8"/><path d="m16 16 6-6"/><path d="m8 8 6-6"/><path d="m9 7 8 8"/><path d="m21 11-8-8"/></svg>
            </span>
            <span class="flow-node-text">
              <span class="flow-node-label">Two-pass grade</span>
              <span class="flow-node-sub">det. + judge</span>
            </span>
          </div>
          <span class="flow-arrow" aria-hidden="true">&rarr;</span>
          <div class="flow-node">
            <span class="flow-node-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
            </span>
            <span class="flow-node-text">
              <span class="flow-node-label">Composite score</span>
              <span class="flow-node-sub">0–100</span>
            </span>
          </div>
        </div>
      </section>

      <!-- ── Stats ── -->
      <section class="stats-section">
        <div class="metrics-grid">
          <div class="stat card metric-card">
            <div class="metric-value" id="stat-models">—</div>
            <span class="metric-label">Models tested</span>
          </div>
          <div class="stat card metric-card">
            <div class="metric-value" id="stat-cases">—</div>
            <span class="metric-label">Cases evaluated</span>
          </div>
          <div class="stat card metric-card">
            <div class="metric-value" id="stat-top-score">—</div>
            <span class="metric-label">Top score</span>
          </div>
          <div class="stat card metric-card">
            <div class="metric-value" id="stat-best-value" style="font-size:clamp(0.85rem,2vw,1.1rem);letter-spacing:-0.01em;">—</div>
            <span class="metric-label" id="stat-best-value-label">Best value</span>
          </div>
        </div>
      </section>

      <!-- ── Mini Leaderboard (Top 3) ── -->
      {% set llm_entries = leaderboard | selectattr("model_type", "equalto", "llm") | list %}
      {% set top3 = llm_entries[:3] %}
      {% if top3 %}
      <section class="reveal">
        <h2 class="section-title">Top performers</h2>
        <p class="section-sub">The highest-scoring models so far — full rankings and baseline comparison live on the Leaderboard tab.</p>
        <div class="card card-strong mini-lb">
          {% for entry in top3 %}
          <div class="mini-lb-item" data-model="{{ entry.model_id.split('_')[0] }}">
            <span class="mini-lb-rank">#{{ loop.index }}</span>
            <span class="brand-dot"></span>
            <span class="mini-lb-name">{{ model_display.get(entry.model_id, entry.model_id) }}</span>
            <span class="mini-lb-score">{{ "%.1f"|format(entry.avg_score) }}</span>
          </div>
          {% endfor %}
        </div>
        <div style="text-align: center; margin-top: 1.25rem;">
          <a href="#" data-tab-link="leaderboard" style="font-size: 0.85rem; font-weight: 500;">View full leaderboard &rarr;</a>
        </div>
      </section>
      {% endif %}

    </section>

    <!-- ════════════════════════════════════════
         TAB 2: LEADERBOARD
         ════════════════════════════════════════ -->
    <section id="leaderboard" class="tab-panel">

      <!-- ── Charts ── -->
      <section class="charts-section reveal">
        <h2 class="section-title">How the models compare</h2>
        <p class="section-sub">Composite scores and per-dimension strengths across all evaluated LLMs.</p>

        <div class="charts-frame">
          <div class="charts-inner">
            <div class="chart-card">
              <h3>Composite Score</h3>
              <div class="chart-sub">Higher is better · 0–100 scale</div>
              <canvas id="barChart"></canvas>
              <div class="chart-fallback" id="barChartFallback">
                Chart requires Chart.js — check browser console for details.
              </div>
            </div>
            <div class="chart-card">
              <h3>Per-Dimension Radar</h3>
              <div class="chart-sub">Strengths across rubric dimensions</div>
              <canvas id="radarChart"></canvas>
              <div class="chart-fallback" id="radarChartFallback">
                Chart requires Chart.js — check browser console for details.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── LLM Leaderboard ── -->
      <section class="leaderboard-section reveal">
        {{ dim_cards() }}
        <aside class="disclaimer" id="prelimDisclaimer">
          <div class="disclaimer-icon" aria-hidden="true">i</div>
          <div class="disclaimer-body">
            <strong>Live benchmark — in progress.</strong> This snapshot reflects
            <strong><span id="disclaimer-cases">1</span> of 20</strong> cases.
            The full suite runs on a weekly schedule; scores and rankings refresh
            automatically as each run completes.
          </div>
          <button class="disclaimer-close" type="button" aria-label="Dismiss notice" id="dismissDisclaimer">×</button>
        </aside>

        <div class="leaderboard">
          <div class="lb-header">
            <h2>LLM Rankings</h2>
            <div class="lb-note">Scored by Claude Opus 4.7 across rubric dimensions, normalized to 0–100.</div>
          </div>
          <div class="lb-wrap">
            <table>
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Model</th>
                  <th>Score</th>
                  <th class="has-tooltip" title="Does the model use stack context to determine real exploitability vs just relying on CVSS scores?">Reachability</th>
                  <th class="has-tooltip" title="Does the model rank findings by correct urgency (critical first, deferrable last)?">Prioritization</th>
                  <th class="has-tooltip" title="Are recommendations specific and executable, with concrete commands or patch versions?">Actionability</th>
                  <th class="has-tooltip" title="Is the response focused without preamble or padding, under target length?">Conciseness</th>
                  <th>Cost</th>
                </tr>
              </thead>
              <tbody>
                {% for entry in llm_entries %}
                {# Detect response issues per-model using finish_reason (or parse_error fallback) #}
                {% set ns = namespace(truncated=false, api_error=false, skipped=false) %}
                {% for d in (entry.details or []) %}
                  {% if d.score is mapping %}
                    {% set val = d.score.get('validation', {}) %}
                    {% set fr = val.get('finish_reason', '') %}
                    {% if fr == 'length' or (not fr and val.get('parse_error')) %}
                      {% set ns.truncated = true %}
                    {% elif fr == 'error' %}
                      {% set ns.api_error = true %}
                    {% elif fr == 'context_overflow' %}
                      {% set ns.skipped = true %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
                {% set is_truncated = ns.truncated %}
                {% set has_api_errors = ns.api_error %}
                {% set has_skipped = ns.skipped %}
                {% set reach = entry.dimension_scores.get("reachability_reasoning", 0) %}
                {% set prio  = entry.dimension_scores.get("prioritization", 0) %}
                {% set act   = entry.dimension_scores.get("actionability", 0) %}
                {% set conc  = entry.dimension_scores.get("conciseness", 0) %}
                <tr data-model-id="{{ entry.model_id }}" data-model="{{ entry.model_id.split('_')[0] }}">
                  <td class="rank-cell">
                    <span class="rank-pill rank-{{ loop.index if loop.index <= 3 else 'n' }}">{{ loop.index }}</span>
                  </td>
                  <td class="model-name-cell">
                    <span class="model-display-name" data-id="{{ entry.model_id }}">{{ model_display.get(entry.model_id, entry.model_id) }}</span>
                    {% if is_truncated %}<span class="trunc-badge" title="Response exceeded max_tokens — JSON truncated. Score reflects partial output only.">Truncated</span>{% endif %}
                    {% if has_api_errors %}<span class="err-badge" title="API error — response could not be retrieved.">Error</span>{% endif %}
                    {% if has_skipped %}<span class="skip-badge" title="Context window overflow — case skipped.">Skipped</span>{% endif %}
                    <span class="model-id-mono">{{ entry.model_id }}</span>
                    {% if is_truncated %}
                    <div class="trunc-note">Response exceeded max_tokens — JSON truncated. Score reflects partial output only.</div>
                    {% endif %}
                    {% if has_api_errors %}
                    <div class="err-note">API error — response could not be retrieved. Score is 0.</div>
                    {% endif %}
                    {% if has_skipped %}
                    <div class="skip-note">Context window overflow — case was skipped. Score is 0.</div>
                    {% endif %}
                  </td>
                  <td class="score-cell">
                    <div class="score-bar-wrap">
                      <span class="score-bar" style="width: {{ entry.avg_score * 0.7 }}px;"></span>
                      {{ "%.1f"|format(entry.avg_score) }}
                    </div>
                  </td>
                  <td>{{ "%.1f"|format(reach) }}</td>
                  <td>{{ "%.1f"|format(prio) }}</td>
                  <td>{{ "%.1f"|format(act) }}</td>
                  <td>{{ "%.1f"|format(conc) }}</td>
                  <td class="cost-cell">${{ "%.2f"|format(entry.total_cost) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ── Baseline Section ── -->
      {% set baselines = leaderboard | selectattr("model_type", "equalto", "baseline") | list %}
      {% if baselines %}
      <section class="reveal">
        <div class="divider"><span>Baseline methods · no AI reasoning</span></div>

        <div class="charts-frame baseline-chart-frame">
          <div class="charts-inner">
            <div class="chart-card">
              <h3>Baseline Scores</h3>
              <div class="chart-sub">Deterministic methods · for reference only, not directly comparable to LLMs</div>
              <canvas id="baselineBarChart"></canvas>
              <div class="chart-fallback" id="baselineBarChartFallback">
                Chart requires Chart.js — check browser console for details.
              </div>
            </div>
          </div>
        </div>

        <div class="leaderboard" style="margin-top: 1.5rem;">
          <div class="lb-header">
            <h2>Baseline Comparison</h2>
            <div class="lb-note">Baselines use deterministic scoring only (no LLM judge pass). Scores are not directly comparable to LLMs.</div>
          </div>
          <div class="lb-wrap">
            <table>
              <thead>
                <tr>
                  <th>Model</th>
                  <th>Score</th>
                  <th class="has-tooltip" title="How accurate were verdicts (exploitable/not exploitable/partial) vs ground truth?">Verdict Accuracy</th>
                  <th class="has-tooltip" title="How accurate was the priority ordering vs ground truth?">Priority Accuracy</th>
                </tr>
              </thead>
              <tbody>
                {% for entry in baselines %}
                <tr data-model-id="{{ entry.model_id }}">
                  <td class="model-name-cell">
                    <span class="model-display-name" data-id="{{ entry.model_id }}">{{ model_display.get(entry.model_id, entry.model_id) }}</span>
                    <span class="model-id-mono">{{ entry.model_id }}</span>
                  </td>
                  <td class="score-cell">
                    <div class="score-bar-wrap">
                      <span class="score-bar" style="width: {{ entry.avg_score * 0.7 }}px;"></span>
                      {{ "%.1f"|format(entry.avg_score) }}
                    </div>
                  </td>
                  <td>{{ "%.1f"|format(entry.avg_verdict) }}</td>
                  <td>{{ "%.1f"|format(entry.avg_priority) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </section>
      {% endif %}

    </section>

    <!-- ════════════════════════════════════════
         TAB 3: MODELS
         ════════════════════════════════════════ -->
    <section id="models" class="tab-panel">
      <h2 class="section-title">Drill-down per model</h2>
      <p class="section-sub">Full per-dimension breakdown for every evaluated model. Select a model below.</p>

      <div class="model-chips">
        {% for entry in leaderboard %}
        <button class="chip {% if loop.first %}is-active{% endif %}" data-model="{{ entry.model_id }}">
          {{ model_display.get(entry.model_id, entry.model_id) }}
        </button>
        {% endfor %}
        {% if judge_entry %}
        <button class="chip" data-model="{{ judge_entry.model_id }}">
          {{ model_display.get(judge_entry.model_id, judge_entry.model_id) }}
        </button>
        {% endif %}
      </div>

      <div class="model-panels">
        {% for entry in leaderboard %}
        <div class="model-panel {% if loop.first %}is-active{% endif %}" data-model-panel="{{ entry.model_id }}">
          {% include "card.html.j2" %}
        </div>
        {% endfor %}
        {% if judge_entry %}
        <div class="model-panel" data-model-panel="{{ judge_entry.model_id }}">
          {% with entry = judge_entry %}{% include "card.html.j2" %}{% endwith %}
        </div>
        {% endif %}
      </div>
    </section>

    <!-- ════════════════════════════════════════
         TAB 4: METHODOLOGY
         ════════════════════════════════════════ -->
    <section id="methodology" class="tab-panel">
      <h2 class="section-title">How this benchmark works</h2>
      <p class="section-sub">Three reasons why evalsec scores differently from CVSS-only triage.</p>

      <div class="method-frame">
        <div class="method-inner">
          <div class="method-tabs" role="tablist" aria-label="Methodology sections">
            <button class="method-tab selected" type="button" data-tab="what" role="tab" aria-selected="true" aria-controls="panel-what">What We Test</button>
            <button class="method-tab" type="button" data-tab="how" role="tab" aria-selected="false" aria-controls="panel-how">How We Score</button>
            <button class="method-tab" type="button" data-tab="why" role="tab" aria-selected="false" aria-controls="panel-why">Why It Matters</button>
          </div>
          <div class="method-panel active" data-panel="what">
            <h3>What We Test</h3>
            <p>
              20 test cases, each built around a real Trivy scan from a container image you'd
              actually run in prod — nginx, redis, postgres, vault, and others. Every case
              comes with a Kubernetes/EKS deployment context: network exposure, whether the
              service is internet-facing, runtime reachability, any compensating controls in place.
            </p>
            <p>
              Models must produce a <strong>VEX-format triage report</strong> — call each CVE
              exploitable or not, back it up, assign a P0–P3 priority, and give concrete
              remediation steps. The bar isn't knowing the CVSS score. It's making the call a
              real engineer would make.
            </p>
          </div>

          <div class="method-panel" data-panel="how">
            <h3>How We Score</h3>
            <p>Every response runs through two passes. Pass 1 catches mechanical failures; Pass 2 evaluates reasoning.</p>

            <div class="pass-section">
              <h4 class="pass-title">Pass 1 — Deterministic <span class="pass-weight">20% of total</span></h4>
              <p class="pass-desc">No LLM involved. Format checks and direct comparisons against the ground truth.</p>
              {{ dim_cards_pass1() }}
            </div>

            <div class="pass-section">
              <h4 class="pass-title">Pass 2 — LLM Judge <span class="pass-weight">80% of total</span></h4>
              <p class="pass-desc">Claude Opus 4.7 evaluates the reasoning across four rubric dimensions.</p>
              {{ dim_cards() }}
            </div>

            <p class="pass-footnote">Hallucinated CVEs not in the scan incur up to a −20 penalty applied to the Pass 1 score.</p>
          </div>

          <div class="method-panel" data-panel="why">
            <h3>Why It Matters</h3>
            <p>
              CVSS scores are public. Any script can sort by severity. The hard part is knowing
              whether a CRITICAL CVE actually matters for <em>your</em> specific service — given
              your network topology, what's exposed, and what an attacker could realistically reach.
            </p>
            <p>
              That's the gap <strong>evalsec</strong> measures. Not vulnerability knowledge,
              but the contextual reasoning DevSecOps engineers do every day.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ── Footer ── -->
  <footer>
    <div class="app-shell" style="padding-top: 0; padding-bottom: 0;">
      <div class="footer-mark">evalsec · <a href="https://github.com/frhnardi" style="color:inherit;text-decoration:none;">@frhnardi</a></div>
    </div>
  </footer>

  <script>
  try {
  (function() {
    // ── Theme ──
    const themeToggle = document.getElementById('themeToggle');
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      document.documentElement.classList.add('dark');
    }

    function updateThemeMeta() {
      const meta = document.querySelector('meta[name="theme-color"]');
      const isDark = document.documentElement.classList.contains('dark');
      meta?.setAttribute('content', isDark ? '#000000' : '#ffffff');
    }

    updateThemeMeta();

    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeMeta();
    });

    // ── Tab Switching ──
    const navTabs = document.querySelectorAll('[data-tab]');
    const panels = document.querySelectorAll('.tab-panel');

    function activateTab(tabName) {
      // Batch the DOM read first…
      const targetPanel = document.getElementById(tabName);
      if (!targetPanel) return;

      // …then batch all writes inside one rAF to avoid layout thrashing.
      requestAnimationFrame(() => {
        navTabs.forEach((tab) => {
          tab.classList.toggle('is-active', tab.dataset.tab === tabName);
        });
        panels.forEach((panel) => {
          panel.classList.toggle('is-active', panel.id === tabName);
        });

        history.replaceState(null, '', '#' + tabName);

        // Only scroll if the user isn't already near the top.
        if (window.scrollY > 50) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    navTabs.forEach((tab) => {
      tab.addEventListener('click', () => activateTab(tab.dataset.tab));
    });

    // Handle tab-link buttons in overview (CTA buttons that switch tab)
    document.querySelectorAll('[data-tab-link]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        activateTab(link.dataset.tabLink);
      });
    });

    // Hash-based routing
    const initialTab = location.hash.replace('#', '') || 'overview';
    if (document.getElementById(initialTab)) {
      activateTab(initialTab);
    }

    // ── Model Chip Switching ──
    const modelChips = document.querySelectorAll('[data-model]');
    const modelPanels = document.querySelectorAll('[data-model-panel]');

    modelChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const model = chip.dataset.model;

        modelChips.forEach((item) => {
          item.classList.toggle('is-active', item === chip);
        });

        modelPanels.forEach((panel) => {
          panel.classList.toggle('is-active', panel.dataset.modelPanel === model);
        });
      });
    });

    // ── Infinite Grid Animation ──
    const root = document.documentElement;
    const baseSvg = document.querySelector('.grid-base');
    const spotlightSvg = document.querySelector('.grid-spotlight');
    const basePattern = document.getElementById('gridPatternBase');
    const spotlightPattern = document.getElementById('gridPatternSpotlight');

    // Set explicit viewBox on both SVGs so the 40×40 pattern tiles correctly
    // across the full viewport instead of being stretched from the implicit
    // 100×100 coordinate system (which caused the grid to only appear in the
    // top-right corner).
    function syncViewBox() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const vb = '0 0 ' + w + ' ' + h;
      if (baseSvg) baseSvg.setAttribute('viewBox', vb);
      if (spotlightSvg) spotlightSvg.setAttribute('viewBox', vb);
    }
    syncViewBox();
    window.addEventListener('resize', syncViewBox);

    let gridSize = 40;
    let offsetX = 0;
    let offsetY = 0;
    const speedX = 0.4;  // slightly slower — reads as elegant, not busy
    const speedY = 0.4;
    let rafId = null;
    let isVisible = true;

    function animateGrid() {
      // Keep the loop alive but skip work while the tab is backgrounded.
      if (!isVisible) {
        rafId = requestAnimationFrame(animateGrid);
        return;
      }

      offsetX = (offsetX + speedX) % gridSize;
      offsetY = (offsetY + speedY) % gridSize;

      if (basePattern) {
        basePattern.setAttribute('x', offsetX.toFixed(2));
        basePattern.setAttribute('y', offsetY.toFixed(2));
      }
      if (spotlightPattern) {
        spotlightPattern.setAttribute('x', offsetX.toFixed(2));
        spotlightPattern.setAttribute('y', offsetY.toFixed(2));
      }

      rafId = requestAnimationFrame(animateGrid);
    }

    // Pause grid work when the tab is hidden — cuts idle CPU to ~0.
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
    });

    // Respect prefers-reduced-motion — no grid drift at all.
    const gridReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!gridReducedMotion.matches) {
      animateGrid();
    }

    // ── Mouse Spotlight — rAF-throttled ──
    // pointermove fires 100+×/s; without throttling each fire triggers a
    // CSS recalc on the spotlight mask → main-thread jank during scroll.
    let mouseMoveScheduled = false;
    let pendingMouseX = 0;
    let pendingMouseY = 0;

    window.addEventListener('pointermove', (event) => {
      pendingMouseX = event.clientX;
      pendingMouseY = event.clientY;

      if (!mouseMoveScheduled) {
        mouseMoveScheduled = true;
        requestAnimationFrame(() => {
          root.style.setProperty('--mouse-x', pendingMouseX + 'px');
          root.style.setProperty('--mouse-y', pendingMouseY + 'px');
          mouseMoveScheduled = false;
        });
      }
    }, { passive: true });

    // ── Display Name Maps ──
    // Injected from dashboard.py MODEL_DISPLAY — single source of truth.
    const MODEL_DISPLAY = {{ model_display | tojson }};
    const displayName = id => MODEL_DISPLAY[id] || id;

    const DIM_LABELS = {
      reachability_reasoning: "Reachability",
      prioritization:         "Prioritization",
      actionability:          "Actionability",
      conciseness:            "Conciseness",
      format:                 "Format",
      coverage:               "Coverage",
      verdict:                "Verdict Accuracy",
      priority:               "Priority Order",
    };
    const dimLabel = d => DIM_LABELS[d] || d.replace(/_/g, " ");

    const DIM_TOOLTIPS = {
      reachability_reasoning: "Does the model use stack context to determine real exploitability vs just relying on CVSS scores?",
      prioritization:         "Does the model rank findings by correct urgency (critical first, deferrable last)?",
      actionability:          "Are recommendations specific and executable, with concrete commands or patch versions?",
      conciseness:            "Is the response focused without preamble or padding, under target length?",
      format:                 "Is output valid JSON matching the expected schema?",
      coverage:               "Did the model address all CVEs in the input scan?",
      verdict:                "How accurate were verdicts (exploitable/not exploitable/partial) vs ground truth?",
      priority:               "How accurate was the priority ordering vs ground truth?",
      hall_penalty:           "Penalty for fabricated CVEs not in original scan (lower is better)",
    };
    const DIM_TOOLTIPS_BY_TEXT = {};
    Object.entries(DIM_TOOLTIPS).forEach(([k, v]) => {
      DIM_TOOLTIPS_BY_TEXT[k.replace(/_/g, " ")] = v;
    });
    DIM_TOOLTIPS_BY_TEXT["hall. penalty"] = DIM_TOOLTIPS.hall_penalty;
    DIM_TOOLTIPS_BY_TEXT["regex"]         = "Regex / pattern match score on deterministic Pass 1.";
    DIM_TOOLTIPS_BY_TEXT["cost"]          = "Total API cost for this model across all evaluated cases.";

    // ── Chart.js Theme ──
    const FONT_SANS = 'Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
    const FONT_MONO = '"JetBrains Mono", "SFMono-Regular", Consolas, monospace';

    // ============================================
    // CHART.JS THEMING — sync dengan CSS variables
    // ============================================
    function getThemeColors() {
      const isDark = document.documentElement.classList.contains('dark');
      return {
        text:       isDark ? '#EDEDED' : '#171717',
        textMuted:  isDark ? 'rgba(237, 237, 237, 0.65)' : 'rgba(23, 23, 23, 0.65)',
        textSubtle: isDark ? 'rgba(237, 237, 237, 0.45)' : 'rgba(23, 23, 23, 0.45)',
        grid:       isDark ? 'rgba(237, 237, 237, 0.08)' : 'rgba(23, 23, 23, 0.08)',
        axis:       isDark ? 'rgba(237, 237, 237, 0.20)' : 'rgba(23, 23, 23, 0.15)',
        barPrimary: isDark ? '#EDEDED' : '#171717',
        barMuted:   isDark ? 'rgba(237, 237, 237, 0.65)' : 'rgba(23, 23, 23, 0.65)',
      };
    }

    function isDarkMode() {
      return document.documentElement.classList.contains('dark');
    }

    function applyChartDefaults() {
      const c = getThemeColors();
      Chart.defaults.color = c.textMuted;
      Chart.defaults.borderColor = c.grid;
      Chart.defaults.font.family = FONT_SANS;
      Chart.defaults.font.size = 11;
      Chart.defaults.plugins.legend.labels.color = c.text;
      Chart.defaults.plugins.tooltip.backgroundColor = c.barPrimary;
      Chart.defaults.plugins.tooltip.titleColor = isDarkMode() ? '#0A0A0A' : '#FAFAFA';
      Chart.defaults.plugins.tooltip.bodyColor = isDarkMode() ? '#0A0A0A' : '#FAFAFA';
    }

    let chartLoaded = false;
    try {
      applyChartDefaults();
      chartLoaded = true;
    } catch (_) {
      console.warn('Chart.js failed to load — chart canvas elements will show fallback message.');
      ['barChart', 'radarChart', 'baselineBarChart'].forEach(id => {
        const fb = document.getElementById(id + 'Fallback');
        if (fb) fb.classList.add('visible');
      });
    }

    // ── Chart Instances registry — for re-render on theme toggle ──
    const chartInstances = [];

    // ── Dynamic palette — computed from current theme ──
    function getInk()      { return isDarkMode() ? '#EDEDED' : '#171717'; }
    function getInkHi()    { return isDarkMode() ? '#E2E2E2' : '#2A2A2A'; }
    function getInkDim()   { return isDarkMode() ? '#B4B4B4' : '#4C4C4C'; }
    function getAsh()      { return isDarkMode() ? '#8C8C8C' : '#7C7C7C'; }
    function getAshLo()    { return isDarkMode() ? '#666666' : '#9E9E9E'; }
    function getFog()      { return isDarkMode() ? '#A6A6A6' : '#5E5E5E'; }

    function getSeriesPalette() {
      return [getInk(), getAsh(), getInkDim(), getAshLo(), getFog(), getInkHi()];
    }

    function paletteFor(n) {
      const pal = getSeriesPalette();
      return Array.from({ length: n }, (_, i) => pal[i % pal.length]);
    }

    function getInkGlowColor()  { return isDarkMode() ? 'rgba(255, 255, 255, 0.30)' : 'rgba(10, 10, 10, 0.26)'; }
    function getAshGlowColor()  { return isDarkMode() ? 'rgba(200, 200, 200, 0.26)' : 'rgba(90, 90, 90, 0.22)'; }
    function getEdgeColor()     { return isDarkMode() ? 'rgba(255, 255, 255, 0.42)' : 'rgba(10, 10, 10, 0.40)'; }

    // Build linear gradient helper
    function makeBarGradient(ctx, area, from, mid, fadeEnd) {
      if (!area) return from;
      const g = ctx.createLinearGradient(area.left, 0, area.right, 0);
      if (fadeEnd) {
        g.addColorStop(0, from);
        g.addColorStop(0.6, mid || from);
        g.addColorStop(1, fadeEnd);
      } else {
        g.addColorStop(0, from);
        g.addColorStop(1, mid || from);
      }
      return g;
    }

    // Plugin factory
    function glowPlugin(id, color, blur) {
      return {
        id: id,
        beforeDatasetDraw(chart) {
          chart.ctx.save();
          chart.ctx.shadowColor = color;
          chart.ctx.shadowBlur  = blur;
        },
        afterDatasetDraw(chart) {
          chart.ctx.restore();
        },
      };
    }

    // Taupe edge highlight plugin
    function edgePlugin() {
      return {
        id: 'taupeEdge',
        afterDatasetDraw(chart) {
          const ctx = chart.ctx;
          const meta = chart.getDatasetMeta(0);
          if (!meta || !meta.data) return;
          ctx.save();
          ctx.strokeStyle = getEdgeColor();
          ctx.lineWidth = 1;
          ctx.beginPath();
          meta.data.forEach(bar => {
            const x = bar.x + bar.width;
            ctx.moveTo(x, bar.y);
            ctx.lineTo(x, bar.y + bar.height);
          });
          ctx.stroke();
          ctx.restore();
        }
      };
    }

    function hexToRgba(hex, alpha) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')';
    }

    // ── Data from server ──
    const leaderboard     = {{ leaderboard | tojson }};
    const dimNames        = {{ dim_names | tojson }};
    const llmEntries      = leaderboard.filter(e => e.model_type === "llm");
    const baselineEntries = leaderboard.filter(e => e.model_type === "baseline");

    // ── Format graded_at date — ISO → "Month DD, YYYY" ──
    (function() {
      const el = document.getElementById('graded-at-display');
      if (!el) return;
      try {
        const d = new Date(el.getAttribute('datetime'));
        if (!isNaN(d)) {
          el.textContent = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        }
      } catch (_) {}
    })();

    // ── Model card enhancement ──
    document.querySelectorAll('.model-card').forEach(card => {
      const rank = parseInt(card.dataset.rank, 10);
      const entry = leaderboard.find(e => e.rank === rank);
      if (!entry) return;

      const nameEl = card.querySelector('.model-name');

      // Categorise per-detail status using finish_reason (or parse_error fallback)
      const statusByDetail = (entry.details || []).map(d => {
        if (!d || !d.score || !d.score.validation) return null;
        const v = d.score.validation;
        const fr = v.finish_reason || '';
        if (fr === 'length' || (!fr && v.parse_error)) return 'truncated';
        if (fr === 'error') return 'error';
        if (fr === 'context_overflow') return 'skipped';
        return null;
      });
      const hasTruncated = statusByDetail.includes('truncated');
      const hasError = statusByDetail.includes('error');
      const hasSkipped = statusByDetail.includes('skipped');

      if (nameEl) {
        if (hasTruncated) {
          const badge = document.createElement('span');
          badge.className = 'trunc-badge';
          badge.textContent = 'Truncated';
          badge.title = 'Response exceeded max_tokens — JSON truncated.';
          nameEl.appendChild(badge);
        }
        if (hasError) {
          const badge = document.createElement('span');
          badge.className = 'err-badge';
          badge.textContent = 'Error';
          badge.title = 'API error — response could not be retrieved.';
          nameEl.appendChild(badge);
        }
        if (hasSkipped) {
          const badge = document.createElement('span');
          badge.className = 'skip-badge';
          badge.textContent = 'Skipped';
          badge.title = 'Context window overflow — case skipped.';
          nameEl.appendChild(badge);
        }
      }

      const scoreEl = card.querySelector('.card-score');
      if (scoreEl) {
        if (hasTruncated) {
          const note = document.createElement('div');
          note.className = 'trunc-note';
          note.textContent = 'Response exceeded max_tokens — JSON truncated. Score reflects partial output only.';
          scoreEl.appendChild(note);
        }
        if (hasError) {
          const note = document.createElement('div');
          note.className = 'err-note';
          note.textContent = 'API error — response could not be retrieved. Score is 0.';
          scoreEl.appendChild(note);
        }
        if (hasSkipped) {
          const note = document.createElement('div');
          note.className = 'skip-note';
          note.textContent = 'Context window overflow — case was skipped. Score is 0.';
          scoreEl.appendChild(note);
        }
      }

      card.querySelectorAll('.card-dims tbody tr').forEach(tr => {
        const firstCell = tr.querySelector('td, th');
        if (!firstCell) return;
        const text = firstCell.textContent.trim().toLowerCase();
        const tip = DIM_TOOLTIPS_BY_TEXT[text];
        if (tip) {
          tr.title = tip;
          tr.classList.add('has-tooltip');
        }
      });
    });

    // ── Hero stats ──
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function formatNum(v, decimals) {
      if (decimals === 0) return Math.round(v).toLocaleString();
      return v.toFixed(decimals);
    }

    function countUp(el, target, duration, decimals) {
      if (!el || target == null) return;
      if (reduceMotion) { el.textContent = formatNum(target, decimals); return; }
      const start = performance.now();
      function ease(t) { return 1 - Math.pow(1 - t, 4); }
      function frame(now) {
        const t = Math.min(1, (now - start) / duration);
        el.textContent = formatNum(target * ease(t), decimals);
        if (t < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    const allCases = new Set();
    leaderboard.forEach(e => (e.details || []).forEach(d => {
      if (d && d.case_id) allCases.add(d.case_id);
    }));
    const caseCount = allCases.size || (leaderboard[0]?.details?.length || 0);

    countUp(document.getElementById('stat-models'), llmEntries.length, 900, 0);
    countUp(document.getElementById('stat-cases'),  caseCount,          900, 0);

    const disclaimerCases = document.getElementById('disclaimer-cases');
    if (disclaimerCases) disclaimerCases.textContent = caseCount || 1;

    const topEl = document.getElementById('stat-top-score');
    if (llmEntries.length > 0) {
      const topEntry = llmEntries.reduce((acc, e) => e.avg_score > acc.avg_score ? e : acc);
      countUp(topEl, topEntry.avg_score, 1100, 1);
    } else {
      topEl.textContent = '—';
    }

    const llmWithCost = llmEntries.filter(e => (e.total_cost || 0) > 0);
    const bestValueEl = document.getElementById('stat-best-value');
    const bestValueLabelEl = document.getElementById('stat-best-value-label');
    if (llmWithCost.length === 0) {
      // No cost data — show top model name instead
      if (llmEntries.length > 0) {
        const top = llmEntries.reduce((acc, e) => e.avg_score > acc.avg_score ? e : acc);
        bestValueEl.textContent = displayName(top.model_id);
        if (bestValueLabelEl) bestValueLabelEl.textContent = 'Top model';
      } else {
        bestValueEl.textContent = '—';
      }
    } else {
      const best = llmWithCost.reduce((acc, e) =>
        (e.avg_score / e.total_cost) > (acc.avg_score / acc.total_cost) ? e : acc
      );
      const ratio = best.avg_score / best.total_cost;
      countUp(bestValueEl, ratio, 1100, ratio >= 100 ? 0 : 1);
    }

    // ── Disclaimer dismissal ──
    const disclaimer = document.getElementById('prelimDisclaimer');
    const dismissBtn = document.getElementById('dismissDisclaimer');
    if (disclaimer && sessionStorage.getItem('evalsecDismissDisclaimer') === '1') {
      disclaimer.classList.add('is-dismissed');
    }
    if (dismissBtn) {
      dismissBtn.addEventListener('click', () => {
        if (disclaimer) disclaimer.classList.add('is-dismissed');
        try { sessionStorage.setItem('evalsecDismissDisclaimer', '1'); } catch (_) {}
      });
    }

    // ── Methodology tab switching ──
    const methTabs   = document.querySelectorAll('.method-tab');
    const methPanels = document.querySelectorAll('.method-panel');
    methTabs.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;
        methTabs.forEach(t => {
          const sel = t === btn;
          t.classList.toggle('selected', sel);
          t.setAttribute('aria-selected', sel ? 'true' : 'false');
        });
        methPanels.forEach(p => p.classList.toggle('active', p.dataset.panel === target));
      });
    });

    // ── Bar Chart (LLM composite scores) ──
    if (chartLoaded && llmEntries.length > 0) {
      const c = getThemeColors();
      const compositeChart = new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
          labels: llmEntries.map(e => displayName(e.model_id)),
          datasets: [{
            label: 'Composite Score',
            data: llmEntries.map(e => e.avg_score),
            backgroundColor: (ctx) => {
              const { chart } = ctx;
              return makeBarGradient(chart.ctx, chart.chartArea, getAsh(), getInk());
            },
            hoverBackgroundColor: (ctx) => {
              const { chart } = ctx;
              return makeBarGradient(chart.ctx, chart.chartArea, getInkDim(), getInk());
            },
            borderRadius: 6,
            borderSkipped: false,
            maxBarThickness: 44,
            categoryPercentage: 0.85,
            barPercentage: 0.92,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          indexAxis: 'y',
          animation: { duration: 1200, easing: 'easeOutQuart' },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(255, 255, 255, 0.95)',
              borderColor: 'rgba(128, 128, 128, 0.25)',
              borderWidth: 1,
              titleColor: '#0A0A0A',
              bodyColor: '#525252',
              padding: 10,
              cornerRadius: 8,
              titleFont: { family: FONT_SANS, weight: '500' },
              bodyFont:  { family: FONT_MONO, size: 12 },
            },
          },
          scales: {
            x: {
              min: 0, max: 100,
              grid: {
                color: c.grid,
                borderDash: [4, 4],
                drawTicks: false,
              },
              ticks: { color: c.textMuted, font: { family: FONT_MONO, size: 10 } },
              border: { display: false },
            },
            y: {
              grid: { display: false },
              ticks: {
                color: c.text,
                font: { family: FONT_SANS, weight: '500', size: 12 },
                padding: 12,
              },
              border: { display: false },
            }
          }
        },
        plugins: [glowPlugin('inkGlow', getInkGlowColor(), 16), edgePlugin()],
      });
      chartInstances.push(compositeChart);
    }

    // ── Brand color map — constant, never change on theme toggle ──
    const BRAND_COLORS = {
      deepseek_v4_pro:  { stroke: '#4D6BFE', fill: 'rgba(77, 107, 254, 0.15)' },
      claude_sonnet_46: { stroke: '#D97757', fill: 'rgba(217, 119, 87, 0.15)' },
      kimi_k2_thinking: { stroke: '#10B981', fill: 'rgba(16, 185, 129, 0.15)' },
      qwen_3_5:         { stroke: '#EC4899', fill: 'rgba(236, 72, 153, 0.15)' },
    };

    function modelBrand(modelId, index) {
      const fallbacks = [
        { stroke: '#4D6BFE', fill: 'rgba(77, 107, 254, 0.15)' },
        { stroke: '#D97757', fill: 'rgba(217, 119, 87, 0.15)' },
        { stroke: '#10B981', fill: 'rgba(16, 185, 129, 0.15)' },
        { stroke: '#EC4899', fill: 'rgba(236, 72, 153, 0.15)' },
      ];
      return BRAND_COLORS[modelId] || fallbacks[index % fallbacks.length];
    }

    // ── Radar Chart ──
    if (chartLoaded && llmEntries.length > 0) {
      const c = getThemeColors();
      const radarDatasets = llmEntries.map((entry, i) => {
        const brand = modelBrand(entry.model_id, i);
        return {
          label: displayName(entry.model_id),
          data: dimNames.map(d => (entry.dimension_scores[d] || 0)),
          borderColor: brand.stroke,
          backgroundColor: brand.fill,
          borderWidth: 2.25,
          pointRadius: 3,
          pointBackgroundColor: brand.stroke,
          pointBorderColor: brand.stroke,
          pointHoverRadius: 5,
          pointHoverBackgroundColor: brand.stroke,
          pointHoverBorderColor: '#ffffff',
          pointHoverBorderWidth: 2,
        };
      });

      const radarChart = new Chart(document.getElementById('radarChart'), {
        type: 'radar',
        data: {
          labels: dimNames.map(d => dimLabel(d).toUpperCase()),
          datasets: radarDatasets,
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          animation: { duration: 900, easing: 'easeOutQuart' },
          scales: {
            r: {
              min: 0, max: 100,
              ticks: {
                stepSize: 25,
                backdropColor: 'transparent',
                color: c.textSubtle,
                font: { family: FONT_MONO, size: 9 },
              },
              grid: {
                color: c.grid,
                circular: true,
                lineWidth: 1,
                borderDash: [2, 4],
              },
              angleLines: {
                color: c.grid,
                lineWidth: 1,
                borderDash: [2, 4],
              },
              pointLabels: {
                color: c.textMuted,
                font: { family: FONT_MONO, size: 10, weight: '500' },
              },
            }
          },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                boxWidth: 10,
                boxHeight: 10,
                padding: 14,
                color: c.text,
                font: { family: FONT_SANS, size: 11, weight: '500' },
                usePointStyle: true,
                pointStyle: 'circle',
              },
            },
            tooltip: {
              backgroundColor: 'rgba(255, 255, 255, 0.95)',
              borderColor: 'rgba(128, 128, 128, 0.25)',
              borderWidth: 1,
              titleColor: '#0A0A0A',
              bodyColor: '#525252',
              padding: 10,
              cornerRadius: 8,
              titleFont: { family: FONT_SANS, weight: '500' },
              bodyFont:  { family: FONT_MONO, size: 12 },
            },
          }
        }
      });
      chartInstances.push(radarChart);
    }

    // ── Baseline Bar Chart ──
    const baselineCanvas = document.getElementById('baselineBarChart');
    if (chartLoaded && baselineCanvas && baselineEntries.length > 0) {
      const c = getThemeColors();
      const baselineChart = new Chart(baselineCanvas, {
        type: 'bar',
        data: {
          labels: baselineEntries.map(e => displayName(e.model_id)),
          datasets: [{
            label: 'Deterministic Score',
            data: baselineEntries.map(e => e.avg_score),
            backgroundColor: (ctx) => {
              const { chart } = ctx;
              return makeBarGradient(chart.ctx, chart.chartArea, getFog(), getAsh(), hexToRgba(getAsh(), 0.5));
            },
            hoverBackgroundColor: (ctx) => {
              const { chart } = ctx;
              return makeBarGradient(chart.ctx, chart.chartArea, getAsh(), getInkDim(), hexToRgba(getInkDim(), 0.5));
            },
            borderRadius: 6,
            borderSkipped: false,
            maxBarThickness: 36,
            categoryPercentage: 0.85,
            barPercentage: 0.92,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          indexAxis: 'y',
          animation: { duration: 1100, easing: 'easeOutQuart' },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(255, 255, 255, 0.95)',
              borderColor: 'rgba(128, 128, 128, 0.25)',
              borderWidth: 1,
              titleColor: '#0A0A0A',
              bodyColor: '#525252',
              padding: 10,
              cornerRadius: 8,
              titleFont: { family: FONT_SANS, weight: '500' },
              bodyFont:  { family: FONT_MONO, size: 12 },
            },
          },
          scales: {
            x: {
              min: 0, max: 100,
              grid: {
                color: c.grid,
                borderDash: [4, 4],
                drawTicks: false,
              },
              ticks: { color: c.textMuted, font: { family: FONT_MONO, size: 10 } },
              border: { display: false },
            },
            y: {
              grid: { display: false },
              ticks: {
                color: c.text,
                font: { family: FONT_SANS, weight: '500', size: 12 },
                padding: 12,
              },
              border: { display: false },
            }
          }
        },
        plugins: [glowPlugin('ashGlow', getAshGlowColor(), 14)],
      });
      chartInstances.push(baselineChart);
    }

    // ── Chart theme update on toggle — re-render all chart instances ──
    function updateAllCharts() {
      if (!chartLoaded) return;
      applyChartDefaults();
      const c = getThemeColors();
      chartInstances.forEach(chart => {
        // Update datasets — radar keeps brand colors constant, only bar gets theme update
        chart.data.datasets.forEach((ds, idx) => {
          if (chart.config.type === 'bar') {
            ds.backgroundColor = idx === 0 ? c.barPrimary : c.barMuted;
          }
          // radar: brand colors are constant — do NOT overwrite on theme toggle
        });

        // Update scales
        if (chart.options.scales) {
          Object.values(chart.options.scales).forEach(scale => {
            if (scale.grid)       scale.grid.color = c.grid;
            if (scale.ticks)      scale.ticks.color = scale === chart.options.scales.y ? c.text : c.textMuted;
            if (scale.border)     scale.border.color = c.axis;
            if (scale.angleLines) scale.angleLines.color = c.grid;
            if (scale.pointLabels) scale.pointLabels.color = c.textMuted;
          });
        }

        // Update legend
        if (chart.options.plugins?.legend?.labels) {
          chart.options.plugins.legend.labels.color = c.text;
        }

        chart.update('none');
      });
    }

    themeToggle?.addEventListener('click', () => {
      setTimeout(updateAllCharts, 200);
    });

    // ── Scroll reveal ──
    document.querySelectorAll('.reveal-stagger').forEach((parent) => {
      Array.from(parent.children).forEach((child, i) => {
        child.classList.add('reveal');
        child.style.setProperty('--reveal-delay', (i * 80) + 'ms');
      });
    });

    document.querySelectorAll('.bar-fill').forEach((bar) => {
      const w = bar.style.width;
      if (w && !reduceMotion) {
        bar.dataset.targetWidth = w;
        bar.style.width = '0%';
      }
    });

    if ('IntersectionObserver' in window && !reduceMotion) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target;
          el.classList.add('is-revealed');
          if (el.classList.contains('bar-fill') && el.dataset.targetWidth) {
            const t = el.dataset.targetWidth;
            requestAnimationFrame(() => { el.style.width = t; });
          }
          io.unobserve(el);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal, .bar-fill').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-revealed'));
      document.querySelectorAll('.bar-fill').forEach((bar) => {
        if (bar.dataset.targetWidth) bar.style.width = bar.dataset.targetWidth;
      });
    }
  })();
  } catch(e) {
    console.error('evalsec dashboard init error:', e);
  }
  </script>

</body>
</html>
